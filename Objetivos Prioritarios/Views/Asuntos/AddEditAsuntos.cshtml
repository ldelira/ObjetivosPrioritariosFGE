@model Objetivos_Prioritarios.Models.tb_AsuntoRelacionado

@{
    ViewBag.Title = Model.int_id_asunto_relacionado == 0 ? "Agregar Asunto" : "Editar Asunto";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool esNuevo = Model == null || Model.int_id_asunto_relacionado == 0;
    string tituloPantalla = esNuevo ? "Crear asunto" : "Editar asunto";
    string subtituloPantalla = esNuevo
        ? "Primero guarda los datos generales. Después podrás relacionar objetivos prioritarios y víctimas."
        : "Consulta y actualiza los datos, objetivos relacionados y víctimas del asunto.";
}

<section class="section asunto-page">

    <div class="asunto-hero">
        <div>
            <div class="asunto-breadcrumb">Asuntos relacionados / @tituloPantalla</div>
            <h2>@tituloPantalla</h2>
            <p>@subtituloPantalla</p>
        </div>

        <div class="asunto-hero-actions">
            <a href="@Url.Action("Index", "Asuntos")" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left"></i> Volver al listado
            </a>
        </div>
    </div>

    <div class="asunto-stepper-card">

        <div class="asunto-stepper" role="tablist">
            <button class="asunto-step active"
                    id="datos-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#datos"
                    type="button"
                    role="tab">
                <span>1</span>
                <strong>Datos del asunto</strong>
            </button>

            <button class="asunto-step @(esNuevo ? "disabled" : "")"
                    id="objetivo-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#objetivo"
                    type="button"
                    role="tab"
                    @(esNuevo ? "disabled=\"disabled\"" : "")>
                <span>2</span>
                <strong>Objetivos relacionados</strong>
            </button>

            <button class="asunto-step @(esNuevo ? "disabled" : "")"
                    id="victimas-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#victimas"
                    type="button"
                    role="tab"
                    @(esNuevo ? "disabled=\"disabled\"" : "")>
                <span>3</span>
                <strong>Víctimas relacionadas</strong>
            </button>
        </div>

        @if (esNuevo)
        {
            <div class="asunto-alert" id="avisoGuardarAsunto">
                <i class="fa fa-info-circle"></i>
                <div>
                    <strong>Guarda primero el asunto.</strong>
                    <span>Cuando se genere el ID del asunto se habilitarán los pasos de objetivos y víctimas.</span>
                </div>
            </div>
        }
        else
        {
            <div class="asunto-alert asunto-alert-ok" id="avisoGuardarAsunto">
                <i class="fa fa-check-circle"></i>
                <div>
                    <strong>Asunto guardado.</strong>
                    <span>Ya puedes relacionar objetivos prioritarios y víctimas.</span>
                </div>
            </div>
        }

        <div class="tab-content" id="asuntoTabsContent">

            <!-- PASO 1 -->
            <div class="tab-pane fade show active" id="datos" role="tabpanel" aria-labelledby="datos-tab">

                @Html.HiddenFor(m => m.int_id_asunto_relacionado)

                <div class="asunto-form-grid">

                    <div class="asunto-card">
                        <div class="asunto-card-header">
                            <div>
                                <h4>Datos generales</h4>
                                <p>Información principal del caso, carpeta o investigación.</p>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="nvarchar_alias" class="form-label">Alias / título <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="nvarchar_alias" name="nvarchar_alias"
                                   value="@(Model != null ? Model.nvarchar_alias : String.Empty)" maxlength="300"
                                   placeholder="Ej. Caso doña Juana" />
                        </div>

                        <div class="mb-3">
                            <label for="numavp" class="form-label">CI</label>
                            <input type="text" class="form-control" id="numavp" name="numavp"
                                   value="@(Model != null ? Model.numavp : String.Empty)" maxlength="50"
                                   placeholder="Ej. CI/AGS/00000/00-00" />
                        </div>

                        <div class="mb-3">
                            <label for="date_fecha_asunto" class="form-label">Fecha del asunto</label>
                            <input type="datetime-local" class="form-control" id="date_fecha_asunto" name="date_fecha_asunto"
                                   value="@(Model?.date_fecha_asunto.HasValue == true ? Model.date_fecha_asunto.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                        </div>

                        <div class="mb-3">
                            <label for="int_id_estatus_asunto" class="form-label">Estatus del asunto</label>
                            <select id="int_id_estatus_asunto" name="int_id_estatus_asunto" class="form-control">
                                <option value="">-- Seleccionar --</option>
                                @if (ViewBag.EstatusAsuntoList != null)
                                {
                                    foreach (var e in (List<Objetivos_Prioritarios.Models.cat_EstatusAsunto>)ViewBag.EstatusAsuntoList)
                                    {
                                        <option value="@e.int_id_estatus_asunto" @(e.int_id_estatus_asunto == Model.int_id_estatus_asunto ? "selected" : "")>@e.nvarchar_estatus</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="asunto-card">
                        <div class="asunto-card-header">
                            <div>
                                <h4>Descripción</h4>
                                <p>Narrativa, antecedentes u observaciones generales del asunto.</p>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="nvarchar_descripcion" class="form-label">Descripción del asunto</label>
                            <textarea class="form-control asunto-textarea" id="nvarchar_descripcion" name="nvarchar_descripcion"
                                      rows="13" maxlength="max" placeholder="Describe el asunto...">@Html.Raw(Model != null ? Model.nvarchar_descripcion : String.Empty)</textarea>
                        </div>
                    </div>

                </div>

                <div class="asunto-footer-actions">
                    <button type="button" id="btnSaveAsunto" class="btn btn-primary">
                        <i class="fa fa-save"></i>
                        @(esNuevo ? "Guardar y continuar" : "Guardar cambios")
                    </button>

                    <button type="button" id="btnIrObjetivos" class="btn btn-outline-primary" @(esNuevo ? "disabled=\"disabled\"" : "")>
                        Siguiente: objetivos <i class="fa fa-arrow-right"></i>
                    </button>

                    <a href="@Url.Action("Index", "Asuntos")" class="btn btn-secondary">
                        Cancelar
                    </a>

                    <span id="saveSpinner" style="display:none; align-self:center;">
                        <i class="fa fa-spinner fa-spin"></i> Guardando...
                    </span>
                </div>

            </div>

            <!-- PASO 2 -->
            <div class="tab-pane fade" id="objetivo" role="tabpanel" aria-labelledby="objetivo-tab">

                <div class="asunto-section-title">
                    <div>
                        <h3>Objetivos prioritarios relacionados</h3>
                        <p>Busca un objetivo existente y define su rol o participación dentro del asunto.</p>
                    </div>
                </div>

                <div class="asunto-two-columns">

                    <div class="asunto-card">
                        <div class="asunto-card-header">
                            <div>
                                <h4>Buscar objetivo prioritario</h4>
                                <p>Consulta por nombre o apellidos.</p>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-2">
                                <label class="form-label">Nombre</label>
                                <input type="text" class="form-control" id="txtNombreObjAsunto" placeholder="Nombre">
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label">Apellido paterno</label>
                                <input type="text" class="form-control" id="txtPaternoObjAsunto" placeholder="Paterno">
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label">Apellido materno</label>
                                <input type="text" class="form-control" id="txtMaternoObjAsunto" placeholder="Materno">
                            </div>
                        </div>

                        <button type="button" id="btnBuscarObjetivoAsunto" class="btn btn-primary w-100 mt-2">
                            <i class="fa fa-search"></i> Buscar objetivo
                        </button>

                        <div id="busquedaObjetivoAsunto" class="mt-3"></div>
                    </div>

                    <div class="asunto-card">
                        <div class="asunto-card-header">
                            <div>
                                <h4>Objetivos vinculados al asunto</h4>
                                <p>Listado de objetivos ya relacionados.</p>
                            </div>
                        </div>

                        <div id="ObjetivoRelacionadoAsunto"></div>
                    </div>

                </div>

                <div class="asunto-footer-actions">
                    <button type="button" class="btn btn-outline-secondary" onclick="mostrarTab('#datos-tab')">
                        <i class="fa fa-arrow-left"></i> Regresar a datos
                    </button>
                    <button type="button" class="btn btn-primary" id="btnIrVictimas">
                        Siguiente: víctimas <i class="fa fa-arrow-right"></i>
                    </button>
                </div>

            </div>

            <!-- PASO 3 -->
            <div class="tab-pane fade" id="victimas" role="tabpanel" aria-labelledby="victimas-tab">

                <div class="asunto-section-title">
                    <div>
                        <h3>Víctimas relacionadas</h3>
                        <p>Relaciona víctimas existentes, detenidos importados o registra una víctima nueva.</p>
                    </div>
                </div>

                <div class="asunto-two-columns">

                    <div class="asunto-card">
                        <div class="asunto-card-header">
                            <div>
                                <h4>Buscar víctima</h4>
                                <p>La búsqueda consulta víctimas registradas, detenidos y objetivos.</p>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-md-4 mb-2">
                                <label class="form-label">Nombre</label>
                                <input type="text" id="txtNombreVictima" class="form-control" placeholder="Nombre">
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label">Apellido paterno</label>
                                <input type="text" id="txtPaterno" class="form-control" placeholder="Paterno">
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label">Apellido materno</label>
                                <input type="text" id="txtMaterno" class="form-control" placeholder="Materno">
                            </div>
                        </div>

                        <button type="button" class="btn btn-primary w-100" id="btnBuscarVictima">
                            <i class="fa fa-search"></i> Buscar víctima
                        </button>

                        <div id="busquedaVictimas" class="mt-3"></div>
                        <div id="busquedaDetenidos" class="mt-3"></div>
                        <div id="busquedaObjetivos" class="mt-3"></div>
                    </div>

                    <div class="asunto-card">
                        <div class="asunto-card-header">
                            <div>
                                <h4>Víctimas vinculadas al asunto</h4>
                                <p>Listado de víctimas relacionadas con este asunto.</p>
                            </div>
                        </div>

                        <div id="victimasRelacionadas" class="mt-2"></div>
                    </div>

                </div>

                <div class="asunto-footer-actions">
                    <button type="button" class="btn btn-outline-secondary" onclick="mostrarTab('#objetivo-tab')">
                        <i class="fa fa-arrow-left"></i> Regresar a objetivos
                    </button>
                    <a href="@Url.Action("Index", "Asuntos")" class="btn btn-primary">
                        Finalizar y volver al listado
                    </a>
                </div>

            </div>

        </div>

    </div>

</section>

<div class="modal fade" id="ModalGenerico" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" id="ModalGenericoContent"></div>
    </div>
</div>

<style>
    .asunto-page {
        padding-bottom: 28px;
    }

    .asunto-hero {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 16px;
        margin-bottom: 16px;
    }

    .asunto-breadcrumb {
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .asunto-hero h2 {
        color: #0b2364;
        font-size: 26px;
        font-weight: 900;
        margin: 0;
    }

    .asunto-hero p {
        color: #64748b;
        font-size: 13px;
        margin: 6px 0 0 0;
    }

    .asunto-stepper-card {
        background: #fff;
        border: 1px solid #e8eef8;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(15, 35, 75, .06);
        padding: 18px;
    }

    .asunto-stepper {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 14px;
    }

    .asunto-step {
        border: 1px solid #dbe3ef;
        background: #f8fbff;
        color: #0b2364;
        border-radius: 12px;
        padding: 12px;
        display: flex;
        align-items: center;
        gap: 10px;
        text-align: left;
        transition: all .15s ease;
    }

        .asunto-step span {
            width: 32px;
            height: 32px;
            min-width: 32px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #eef4ff;
            color: #2f5bff;
            font-weight: 900;
        }

        .asunto-step strong {
            font-size: 13px;
            font-weight: 900;
        }

        .asunto-step.active {
            border-color: #2f5bff;
            background: #eef4ff;
            box-shadow: 0 4px 14px rgba(47, 91, 255, .12);
        }

        .asunto-step.disabled,
        .asunto-step:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    .asunto-alert {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        background: #fff8e6;
        border: 1px solid #f5d889;
        color: #7a4d00;
        border-radius: 12px;
        padding: 12px 14px;
        margin-bottom: 16px;
    }

    .asunto-alert-ok {
        background: #e8f7ee;
        border-color: #c5edd4;
        color: #18864b;
    }

    .asunto-alert strong {
        display: block;
        font-size: 13px;
    }

    .asunto-alert span {
        display: block;
        font-size: 12px;
        margin-top: 2px;
    }

    .asunto-form-grid,
    .asunto-two-columns {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 16px;
    }

    .asunto-card {
        background: #fff;
        border: 1px solid #e8eef8;
        border-radius: 14px;
        padding: 16px;
        box-shadow: 0 4px 14px rgba(15, 35, 75, .04);
        min-width: 0;
    }

    .asunto-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 1px solid #e8eef8;
        padding-bottom: 12px;
        margin-bottom: 14px;
    }

        .asunto-card-header h4,
        .asunto-section-title h3 {
            color: #0b2364;
            font-size: 17px;
            font-weight: 900;
            margin: 0;
        }

        .asunto-card-header p,
        .asunto-section-title p {
            color: #64748b;
            font-size: 12px;
            margin: 5px 0 0 0;
        }

    .asunto-section-title {
        margin: 8px 0 14px 0;
    }

    .asunto-textarea {
        min-height: 310px;
        resize: vertical;
    }

    .asunto-footer-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 16px;
    }

        .asunto-footer-actions .btn {
            font-weight: 800;
            border-radius: 8px;
        }

    @@media (max-width: 992px) {
        .asunto-form-grid,
        .asunto-two-columns {
            grid-template-columns: 1fr;
        }

        .asunto-stepper {
            grid-template-columns: 1fr;
        }

        .asunto-hero {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

@section Scripts {
    <script>
        var asuntoInicialGuardado = @Html.Raw(Json.Encode(!esNuevo));

        $(document).ready(function () {

            if (asuntoEstaGuardado()) {
                cargarRelacionesAsunto();
            }

            $("#btnBuscarVictima").off("click").on("click", function () {
                if (!validarAsuntoGuardado()) return;

                let nombre = $("#txtNombreVictima").val().trim();

                if (nombre.length < 2) {
                    swal("Atención", "Escribe al menos 2 caracteres para buscar.", "info");
                    return;
                }

                refreshDetenido();
                refreshObjetivo();
                refreshVictimas();
            });

            $("#btnBuscarObjetivoAsunto").off("click").on("click", function () {
                if (!validarAsuntoGuardado()) return;

                let nombre = $("#txtNombreObjAsunto").val().trim();

                if (nombre.length < 2) {
                    swal("Atención", "Escribe al menos 2 caracteres para buscar.", "info");
                    return;
                }

                refreshObjetivoRelacionadoAsunto();
            });

            $('#btnSaveAsunto').off('click').on('click', function () {
                saveAsunto();
            });

            $("#btnIrObjetivos").off("click").on("click", function () {
                if (!validarAsuntoGuardado()) return;
                mostrarTab("#objetivo-tab");
            });

            $("#btnIrVictimas").off("click").on("click", function () {
                if (!validarAsuntoGuardado()) return;
                mostrarTab("#victimas-tab");
            });
        });

        function asuntoEstaGuardado() {
            var id = parseInt($("#int_id_asunto_relacionado").val() || "0", 10);
            return id > 0;
        }

        function validarAsuntoGuardado() {
            if (!asuntoEstaGuardado()) {
                swal("Guarda primero", "Primero guarda los datos del asunto para poder relacionar objetivos y víctimas.", "warning");
                return false;
            }

            return true;
        }

        function habilitarRelaciones() {
            $("#objetivo-tab, #victimas-tab")
                .prop("disabled", false)
                .removeAttr("disabled")
                .removeClass("disabled");

            $("#btnIrObjetivos").prop("disabled", false);

            $("#avisoGuardarAsunto")
                .removeClass("asunto-alert")
                .addClass("asunto-alert asunto-alert-ok")
                .html(`
                    <i class="fa fa-check-circle"></i>
                    <div>
                        <strong>Asunto guardado.</strong>
                        <span>Ya puedes relacionar objetivos prioritarios y víctimas.</span>
                    </div>
                `);
        }

        function mostrarTab(selector) {
            var trigger = document.querySelector(selector);

            if (!trigger) {
                return;
            }

            if (trigger.disabled || trigger.classList.contains("disabled")) {
                return;
            }

            var targetSelector = trigger.getAttribute("data-bs-target");

            if (!targetSelector) {
                return;
            }

            var target = document.querySelector(targetSelector);

            if (!target) {
                return;
            }

            $(".asunto-step").removeClass("active").attr("aria-selected", "false");
            $("#asuntoTabsContent .tab-pane").removeClass("show active");

            $(trigger).addClass("active").attr("aria-selected", "true");
            $(target).addClass("show active");
        }

        function cargarRelacionesAsunto() {
            refreshVictimasRelacionadasList(true);
            refreshObjetivoRelacionadoAsuntoList(true);
        }

        function refreshDetenido() {
            var datos = {
                nombre: $("#txtNombreVictima").val().trim(),
                paterno: $("#txtPaterno").val().trim(),
                materno: $("#txtMaterno").val().trim()
            };

            $("#busquedaDetenidos").empty();
            $("#busquedaDetenidos").load("@Url.Action("DetenidoListPartial", "Asuntos")", datos);
        }

        function refreshObjetivoRelacionadoAsunto() {
            var datos = {
                nombre: $("#txtNombreObjAsunto").val().trim(),
                paterno: $("#txtPaternoObjAsunto").val().trim(),
                materno: $("#txtMaternoObjAsunto").val().trim(),
                opcion: 1
            };

            $("#busquedaObjetivoAsunto").empty();
            $("#busquedaObjetivoAsunto").load("@Url.Action("ObjetivoPrioritarioListPartial", "Asuntos")", datos);
        }

        function refreshObjetivo() {
            var datos = {
                nombre: $("#txtNombreVictima").val().trim(),
                paterno: $("#txtPaterno").val().trim(),
                materno: $("#txtMaterno").val().trim(),
                opcion: 2
            };

            $("#busquedaObjetivos").empty();
            $("#busquedaObjetivos").load("@Url.Action("ObjetivoPrioritarioListPartial", "Asuntos")", datos);
        }

        function refreshVictimas() {
            var datos = {
                opcion: 1,
                nombre: $("#txtNombreVictima").val().trim(),
                paterno: $("#txtPaterno").val().trim(),
                materno: $("#txtMaterno").val().trim(),
                active: true
            };

            $("#busquedaVictimas").empty();
            $("#busquedaVictimas").load("@Url.Action("VictimasListPartial", "Asuntos")", datos);
        }

        function refreshObjetivoRelacionadoAsuntoList(actives) {
            if (!asuntoEstaGuardado()) return;

            var datos = {
                actives: actives
            };

            $("#ObjetivoRelacionadoAsunto").html('<div class="text-center p-3"><div class="spinner-border text-primary"></div></div>');
            $("#ObjetivoRelacionadoAsunto").load("@Url.Action("ObjetivoRelacionadoAsuntoListPartial", "Asuntos")", datos);
        }

        function refreshVictimasRelacionadasList(actives) {
            if (!asuntoEstaGuardado()) return;

            var datos = {
                actives: actives
            };

            $("#victimasRelacionadas").html('<div class="text-center p-3"><div class="spinner-border text-primary"></div></div>');
            $("#victimasRelacionadas").load("@Url.Action("VictimasRelacionadasListPartial", "Asuntos")", datos);
        }

        function refreshListaVictimas(active) {
            // Se deja por compatibilidad con partials antiguos.
            // En este nuevo flujo las víctimas se consultan desde el buscador y la lista relacionada.
        }

        function validateAsunto() {
            var alias = $('#nvarchar_alias').val().trim();

            if (!alias) {
                swal("Campo requerido", "El campo Alias / título es obligatorio.", "warning");
                return false;
            }

            return true;
        }

        function buildModelFromForm() {
            var id = parseInt($('#int_id_asunto_relacionado').val() || "0", 10);
            var fechaAsuntoVal = $('#date_fecha_asunto').val();
            var fechaAsunto = fechaAsuntoVal ? new Date(fechaAsuntoVal).toISOString() : null;

            return {
                int_id_asunto_relacionado: id,
                nvarchar_alias: $('#nvarchar_alias').val(),
                nvarchar_descripcion: $('#nvarchar_descripcion').val(),
                date_fecha_asunto: fechaAsunto,
                numavp: $('#numavp').val(),
                int_id_estatus_asunto: $('#int_id_estatus_asunto').val() ? parseInt($('#int_id_estatus_asunto').val()) : null
            };
        }

        function saveAsunto() {
            if (!validateAsunto()) return;

            var model = buildModelFromForm();
            var eraNuevo = model.int_id_asunto_relacionado === 0;

            $('#btnSaveAsunto').prop('disabled', true);
            $('#saveSpinner').show();

            $.ajax({
                url: '@Url.Action("SaveAsunto", "Asuntos")',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(model),
                success: function (resp) {
                    if (resp && resp.IsSuccess) {

                        if (resp.Id && resp.Id > 0) {
                            $("#int_id_asunto_relacionado").val(resp.Id);

                            var nuevaUrl = '@Url.Action("AddEditAsuntos", "Asuntos")' + '?int_id_asunto_relacionado=' + resp.Id;
                            window.history.replaceState(null, "", nuevaUrl);
                        }

                        habilitarRelaciones();
                        cargarRelacionesAsunto();

                        swal({
                            title: "",
                            text: resp.Message || "Asunto guardado correctamente.",
                            type: "success",
                            confirmButtonText: eraNuevo ? "Continuar" : "Aceptar"
                        }, function () {
                            if (eraNuevo) {
                                mostrarTab("#objetivo-tab");
                            }
                        });

                    } else {
                        swal("Error", resp && resp.Message ? resp.Message : "Ocurrió un error al guardar.", "error");
                    }
                },
                error: function (xhr, status, err) {
                    console.log(xhr.responseText);
                    swal("Error", "Ocurrió un error en la petición: " + err, "error");
                },
                complete: function () {
                    $('#btnSaveAsunto').prop('disabled', false);
                    $('#saveSpinner').hide();
                }
            });
        }

        function abrirModalVictima(id) {
            if (!validarAsuntoGuardado()) return;

            var int_id_asunto_relacionado = $("#int_id_asunto_relacionado").val();
            var idllamada = 0;
            var idasunto = int_id_asunto_relacionado;

            $.get('@Url.Action("AddEditVictimaPartial", "Asuntos")', {
                id: id,
                idllamada: idllamada,
                idasunto: idasunto
            }, function (html) {
                $("#ModalGenericoContent").html(html);
                $("#ModalGenerico").modal("show");
            });
        }
    </script>
}
