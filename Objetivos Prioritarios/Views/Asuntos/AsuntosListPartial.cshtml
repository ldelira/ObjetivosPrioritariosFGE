@model List<Objetivos_Prioritarios.Models.tb_AsuntoRelacionado>

<style>
    /* Tarjeta principal institucional */
    .card-institutional {
        border: none !important;
        border-radius: 12px !important;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04) !important;
        background-color: #ffffff;
    }

    /* Limpiando la tabla de DataTables */
    .table-institutional th {
        background-color: #ffffff !important;
        color: #6c757d !important;
        font-weight: 600 !important;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e9ecef !important;
        border-top: none !important;
    }

    .table-institutional td {
        vertical-align: middle;
        color: #333333;
        border-bottom: 1px solid #f1f3f5;
        font-size: 0.9rem;
    }

    table.dataTable.no-footer {
        border-bottom: 1px solid #e9ecef !important;
    }

    /* Ajuste específico para párrafos largos en la descripción */
    .desc-text {
        max-width: 450px;
        white-space: normal !important;
        text-align: justify;
        color: #555;
    }

    /* Estilos para el botón de Ver más / Ver menos */
    .toggle-desc {
        color: #1d63d3;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        margin-left: 5px;
        font-size: 0.85rem;
    }

        .toggle-desc:hover {
            text-decoration: underline;
            color: #154bad;
        }

    /* Botones de acción en la tabla más discretos */
    .btn-action {
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 0.875rem;
        transition: all 0.2s;
    }

    .btn-action-view {
        background-color: #e8f0fe;
        color: #1a73e8;
        border: none;
    }

        .btn-action-view:hover {
            background-color: #d2e3fc;
        }

    .btn-action-delete {
        background-color: #fce8e6;
        color: #d93025;
        border: none;
    }

        .btn-action-delete:hover {
            background-color: #fad2cf;
        }

    /* Estilizar inputs de DataTables */
    .dataTables_wrapper .dataTables_filter input {
        border: 1px solid #ced4da;
        border-radius: 20px;
        padding: 5px 15px;
        outline: none;
    }

        .dataTables_wrapper .dataTables_filter input:focus {
            border-color: #1d63d3;
            box-shadow: 0 0 0 0.2rem rgba(29, 99, 211, 0.15);
        }

    /* Contenedor del Loading */
    .loading-overlay {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 250px;
    }
</style>

<div class="main-panel">
    <div class="content-wrapper">
        <div class="row">
            <div class="col-md-12 stretch-card grid-margin">
                <div class="card card-institutional">
                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-sm-center flex-column flex-sm-row mb-4 gap-3">
                            <div>
                                <h3 class="card-title fw-bold text-dark mb-1" style="font-size: 1.5rem;">Asuntos Relacionados</h3>
                                <p class="text-muted mb-0 small">Listado de carpetas, casos e investigaciones</p>
                            </div>

                            <div class="d-flex align-items-center flex-wrap gap-3">
                                <div class="d-flex align-items-center bg-light rounded px-3 shadow-sm" style="height: 42px; border: 1px solid #e9ecef;">
                                    <span class="text-muted small fw-bold me-2" style="white-space: nowrap;">ESTADO:</span>
                                    <select class="form-select border-0 bg-transparent shadow-none fw-semibold text-dark p-0 pe-4" id="estadoAsuntos" style="cursor: pointer;">
                                        <option value="1" @((bool)ViewBag.Actives ? "selected" : "")>Activo</option>
                                        <option value="0" @(!(bool)ViewBag.Actives ? "selected" : "")>Inactivo</option>
                                    </select>
                                </div>

                                <button type="button" class="btn btn-primary shadow-sm fw-semibold text-nowrap" style="border-radius: 8px; height: 42px; padding: 0 20px;" onclick="AddEditAsunto()">
                                    <i class="fa fa-plus me-1"></i> AGREGAR ASUNTO
                                </button>
                            </div>
                        </div>

                        <div id="tableLoading" class="loading-overlay">
                            <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
                            <span class="text-muted fw-medium">Cargando asuntos relacionados...</span>
                        </div>

                        <div id="tableContainer" class="table-responsive" style="display: none;">
                            <table id="asuntosDataTable" class="table table-hover table-institutional w-100">
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Ejecutamos la carga inicial
        FillAsuntosGrid();

        // Cuando cambie el combo de estado, recargamos la tabla
        $("#estadoAsuntos").change(function () {
            FillAsuntosGrid();
        });

        // =========================================================================
        // EVENTO PARA EL BOTÓN "VER MÁS / VER MENOS" DE LA DESCRIPCIÓN
        // =========================================================================
        $('#asuntosDataTable').on('click', '.toggle-desc', function () {
            var btn = $(this);
            var container = btn.closest('.desc-text');

            if (btn.data('state') === 'collapsed') {
                container.find('.desc-short').hide();
                container.find('.desc-full').show();
                btn.text(' Ver menos');
                btn.data('state', 'expanded');
            } else {
                container.find('.desc-full').hide();
                container.find('.desc-short').show();
                btn.text(' Ver más...');
                btn.data('state', 'collapsed');
            }

            // Forzar a DataTables a recalcular la tabla para que no se descuadren las columnas al crecer
            $('#asuntosDataTable').DataTable().columns.adjust();
        });
    });

    var columnAsuntos = [
        {
            title: "Id",
            data: "int_id_asunto_relacionado",
            orderable: true,
            IsFiltered: false,
            width: "50px"
        },
        {
            title: "Alias / Título",
            data: "nvarchar_alias",
            orderable: true,
            IsFiltered: false,
            width: "15%"
        },
        {
            title: "Descripción",
            data: "nvarchar_descripcion",
            orderable: false,
            IsFiltered: false,
            render: function (data) {
                if (!data) return '<span class="text-muted fst-italic">Sin descripción</span>';

                var limit = 150; // Cantidad máxima de caracteres a mostrar colapsado

                if (data.length > limit) {
                    // Cortamos en el límite, pero buscamos el último espacio en blanco para no cortar palabras a la mitad
                    var shortText = data.substr(0, limit);
                    shortText = shortText.substr(0, Math.min(shortText.length, shortText.lastIndexOf(" ")));

                    return `
                        <div class="desc-text">
                            <span class="desc-short">${shortText}...</span>
                            <span class="desc-full" style="display:none;">${data}</span>
                            <br>
                            <a href="javascript:void(0);" class="toggle-desc" data-state="collapsed">Ver más...</a>
                        </div>`;
                }

                // Si el texto es más corto que 150 caracteres, se muestra normal
                return `<div class="desc-text">${data}</div>`;
            }
        },
        {
            title: "Fecha Asunto",
            data: "date_fecha_asunto",
            render: $.fn.dataTable.render.moment(undefined, 'DD-MM-YYYY', 'en'),
            orderable: true,
            IsFiltered: false,
            width: "10%"
        },
        {
            title: "CI",
            data: "numavp",
            orderable: true,
            IsFiltered: false,
            width: "15%"
        },
        {
            title: "Acciones",
            data: "int_id_asunto_relacionado",
            orderable: false,
            width: "10%",
            render: function (data, type, full, meta) {
                var estadoActual = $("#estadoAsuntos").val();

                if (estadoActual == "1") {
                    return `
                        <div class="d-flex gap-2 justify-content-center">
                            <button class="btn-action btn-action-view" onclick="AddEditAsunto(${data})" title="Ver / Editar">
                                <i class="fa fa-eye"></i>
                            </button>
                            <button class="btn-action btn-action-delete" onclick="DisableAsunto(${data})" title="Desactivar Asunto">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>`;
                } else {
                    return `
                        <div class="d-flex gap-2 justify-content-center">
                            <button class="btn btn-sm btn-outline-success fw-bold" style="border-radius:6px;" onclick="ActivateAsunto(${data})" title="Activar Asunto">
                                <i class="fa fa-power-off me-1"></i> Activar
                            </button>
                        </div>`;
                }
            }
        }
    ];

    function FillAsuntosGrid() {
        var isActive = $("#estadoAsuntos").val() == "1" ? true : false;

        $.ajax({
            type: 'POST',
            url: '@Url.Action("FillAsuntosList", "Asuntos")',
            data: { active: isActive },
            beforeSend: function () {
                $("#tableContainer").hide();
                $("#tableLoading").css("display", "flex");
            },
            success: function (data) {
                if ($.fn.dataTable.isDataTable('#asuntosDataTable')) {
                    $('#asuntosDataTable').DataTable().clear().destroy();
                }

                var table = $('#asuntosDataTable').DataTable({
                    searching: true,
                    responsive: false,
                    scrollX: true,
                    autoWidth: false,
                    data: data,
                    columns: columnAsuntos,
                    dom: "<'row mb-3'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6 d-flex justify-content-end'f>>" +
                         "<'row'<'col-sm-12'tr>>" +
                         "<'row mt-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
                    language: {
                        "sProcessing": "Procesando...",
                        "sLengthMenu": "Mostrar _MENU_ registros",
                        "sZeroRecords": "No se encontraron resultados",
                        "sEmptyTable": "Ningún dato disponible en esta tabla",
                        "sInfo": "Mostrando del _START_ al _END_ de _TOTAL_ registros",
                        "sInfoEmpty": "Mostrando 0 registros",
                        "sInfoFiltered": "(filtrado de _MAX_ totales)",
                        "sSearch": "<i class='fa fa-search text-muted me-2'></i>",
                        "sSearchPlaceholder": "Buscar en asuntos...",
                        "oPaginate": {
                            "sFirst": "Primero",
                            "sLast": "Último",
                            "sNext": "Siguiente",
                            "sPrevious": "Anterior"
                        }
                    }
                });

                table.on('draw.dt', function () {
                    setTimeout(function () {
                        table.columns.adjust();
                    }, 50);
                });
            },
            complete: function () {
                $("#tableLoading").hide();
                $("#tableContainer").fadeIn(300, function() {
                    $('#asuntosDataTable').DataTable().columns.adjust();
                });
            }
        });
    }

    function AddEditAsunto(int_id_asunto_relacionado = null) {
        var url = '@Url.Action("AddEditAsuntos","Asuntos")';
        if (int_id_asunto_relacionado) {
            url += '?int_id_asunto_relacionado=' + int_id_asunto_relacionado;
        }
        location.href = url;
    }

    function DisableAsunto(id) {
        swal({
            title: "¿Desactivar Asunto?",
            text: "El asunto dejará de ser visible en el listado activo.",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d93025",
            confirmButtonText: "Sí, desactivar",
            cancelButtonText: "Cancelar",
            closeOnConfirm: false
        }, function () {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("DisableAsunto", "Asuntos")',
                data: { id: id },
                success: function (data) {
                    if (data.IsSuccess) {
                        swal({ title: "Desactivado", text: data.Message, type: 'success', confirmButtonColor: "#1d63d3" }, function () { FillAsuntosGrid(); });
                    } else {
                        swal({ title: "Error", text: data.Message || "No tienes permisos.", type: 'error', confirmButtonColor: "#1d63d3" });
                    }
                }
            });
        });
    }

    function ActivateAsunto(id) {
        swal({
            title: "¿Activar Asunto?",
            text: "El asunto volverá a aparecer en el listado activo.",
            type: "info",
            showCancelButton: true,
            confirmButtonColor: "#1d63d3",
            confirmButtonText: "Sí, activar",
            cancelButtonText: "Cancelar",
            closeOnConfirm: false
        }, function () {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("ActivateAsunto", "Asuntos")',
                data: { id: id },
                success: function (data) {
                    if (data.IsSuccess) {
                        swal({ title: "Activado", text: data.Message, type: 'success', confirmButtonColor: "#1d63d3" }, function () { FillAsuntosGrid(); });
                    } else {
                        swal({ title: "Error", text: data.Message || "No tienes permisos.", type: 'error', confirmButtonColor: "#1d63d3" });
                    }
                }
            });
        });
    }
</script>