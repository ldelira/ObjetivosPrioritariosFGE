        }
    });
}

function ActivateVictimaRelacionada(int_id_asunto_victima) {

    $.ajax({
        type: "POST",
        url: "@Url.Action("ActivateVictimaRelacionada", "Asuntos")",
        data: {
            int_id_asunto_victima: int_id_asunto_victima
