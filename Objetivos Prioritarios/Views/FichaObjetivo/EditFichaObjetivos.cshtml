    function opFichaDataUrlToBlob(dataUrl) {
        var arr = dataUrl.split(',');
        var mime = arr[0].match(/:(.*?);/)[1];
        var bstr = atob(arr[1]);
        var n = bstr.length;
        var u8arr = new Uint8Array(n);

        while (n--) {
            u8arr[n] = bstr.charCodeAt(n);
        }

        return new Blob([u8arr], { type: mime });
    }

    $(document).off("change", "#fotoInputFicha").on("change", "#fotoInputFicha", function () {
        var file = this.files[0];

        if (!file) {
            return;
        }

        var reader = new FileReader();
        reader.onload = function (e) {
            $("#previewImageFicha").attr("src", e.target.result);
            $("#previewContainerFicha").show();
            $("#previewEmptyFicha").hide();
        };
        reader.readAsDataURL(file);
    });

    $(document).off("click", "#removeImageFicha").on("click", "#removeImageFicha", function () {
        $("#fotoInputFicha").val("");
        $("#previewImageFicha").attr("src", "@fotoSrc");

        if ("@fotoSrc" !== "") {
            $("#previewContainerFicha").show();
            $("#previewEmptyFicha").hide();
        } else {
            $("#previewContainerFicha").hide();
            $("#previewEmptyFicha").show();
        }
    });

    $(document).off("click", "#btnGuardarFotoFechaFicha").on("click", "#btnGuardarFotoFechaFicha", function () {
        var fechaNacimiento = $("#fechaNacimientoFicha").val();
        var file = $("#fotoInputFicha")[0].files[0];

        if (!fechaNacimiento) {
            swal("Campo requerido", "Selecciona la fecha de nacimiento.", "warning");
            return;
        }

        var formData = new FormData();
        formData.append("fechaNacimiento", fechaNacimiento);
        formData.append("int_id_objetivo", $("#int_id_objetivo").val());

        if (file) {
            formData.append("foto", file);
        } else {
            var transparentPng = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+/p9sAAAAASUVORK5CYII=";
            formData.append("foto", opFichaDataUrlToBlob(transparentPng), "Nodisponible.png");
        }

        $("#btnGuardarFotoFechaFicha").prop("disabled", true).html('<i class="fa fa-spinner fa-spin"></i> Guardando...');

        $.ajax({
            url: '@Url.Action("AddOrEditFoto", "Objetivo")',
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (resp) {
                if (resp.IsSuccess) {
                    swal({
                        title: "",
                        text: resp.Message,
                        type: "success",
                        confirmButtonText: "Continuar",
                        closeOnConfirm: true
                    }, function () {
                        location.reload();
                    });
                } else {
                    swal("Error", resp.Message || "No se pudieron guardar los cambios.", "error");
                    $("#btnGuardarFotoFechaFicha").prop("disabled", false).html('<i class="fa fa-save"></i> Guardar cambios');
                }
            },
            error: function (xhr) {
                console.log(xhr.responseText);
                swal("Error", "Ocurrió un error al guardar la foto y fecha.", "error");
                $("#btnGuardarFotoFechaFicha").prop("disabled", false).html('<i class="fa fa-save"></i> Guardar cambios');
            }
        });
    });



</script>

