    function cargarPartial(contenedor, url, datos) {

        var $contenedor = $(contenedor);

        if ($contenedor.length === 0) {
            return;
        }

        $contenedor.html(`
            <div style="padding:15px; color:#7b8a9a;">
                Cargando información...
            </div>
        `);

        $contenedor.load(url, datos, function (response, status, xhr) {

            if (status === "error") {
                $contenedor.html(`
                    <div class="alert alert-danger">
                        Error al cargar la información.
                    </div>
                `);
                console.log("Error al cargar partial:", url, xhr.responseText);
                return;
            }

            ajustarDataTablesVisibles();
        });
    }

    function ajustarDataTablesVisibles() {
        setTimeout(function () {
            try {
                $.fn.dataTable
                    .tables({ visible: true, api: true })
                    .columns.adjust();
            } catch (e) {
                console.log("No se pudieron ajustar DataTables visibles:", e);
            }
        }, 200);
    }

