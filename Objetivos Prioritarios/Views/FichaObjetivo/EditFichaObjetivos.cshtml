function cargarBusquedaVictimasDesdeFicha() {

    var datos = {
        nombre: $("#txtBuscarVictimaNombreFicha").val(),
        paterno: $("#txtBuscarVictimaPaternoFicha").val(),
        materno: $("#txtBuscarVictimaMaternoFicha").val(),
        opcion: 1,
        active: true
    };

    $("#contenedorVictimasBusquedaDesdeFicha").empty();

    $("#contenedorVictimasBusquedaDesdeFicha").load(
        "@Url.Action("VictimasListPartial", "Asuntos")",
        datos,
        function () {
            ajustarDataTablesVisibles();
        }
    );
}

function cargarVictimasRelacionadasDesdeFicha(active) {

    if (active === undefined) active = true;

    var datos = {
        actives: active
    };

    $("#contenedorVictimasRelacionadasDesdeFicha").empty();

    $("#contenedorVictimasRelacionadasDesdeFicha").load(
        "@Url.Action("VictimasRelacionadasListPartial", "Asuntos")",
        datos,
        function () {
            ajustarDataTablesVisibles();
        }
    );
}

/*
    Estas funciones son "puente".
    Sirven por si tus partials de Asuntos llamaban funciones
    que antes vivían en AddEditAsuntos.cshtml.
*/

function refreshVictimasRelacionadasList(active) {
    cargarVictimasRelacionadasDesdeFicha(active);
}

function refreshVictimasList(nombre, paterno, materno, opcion, active) {

    var datos = {
        nombre: nombre || $("#txtBuscarVictimaNombreFicha").val(),
        paterno: paterno || $("#txtBuscarVictimaPaternoFicha").val(),
        materno: materno || $("#txtBuscarVictimaMaternoFicha").val(),
        opcion: opcion || 1,
        active: active === undefined ? true : active
    };

    $("#contenedorVictimasBusquedaDesdeFicha").empty();

    $("#contenedorVictimasBusquedaDesdeFicha").load(
        "@Url.Action("VictimasListPartial", "Asuntos")",
        datos,
        function () {
            ajustarDataTablesVisibles();
        }
    );
}

function addVictimaVictima(id_victima) {

    var id_asunto = $("#int_id_asunto_relacionado").val();

    if (!id_asunto || id_asunto === "0") {
        swal("Validación", "No se encontró el asunto seleccionado.", "warning");
        return;
    }

    $.ajax({
        type: "POST",
        url: "@Url.Action("addVictimaVictima", "Asuntos")",
        data: {
            id_victima: id_victima,
            id_asunto_relacionado: id_asunto
        },
        success: function (resp) {
            if (resp.IsSuccess) {
                swal("", resp.Message, "success");
                cargarVictimasRelacionadasDesdeFicha(true);
            } else {
                swal("Error", resp.Message, "error");
            }
        },
        error: function (xhr) {
            console.log(xhr.responseText);
            swal("Error", "Ocurrió un error al agregar la víctima al asunto.", "error");
        }
    });
}

function DisableVictimaRelacionada(int_id_asunto_victima) {

    $.ajax({
        type: "POST",
        url: "@Url.Action("DisableVictimaRelacionada", "Asuntos")",
        data: {
            int_id_asunto_victima: int_id_asunto_victima
