    guardarNuevoAsuntoYVincular();
});

function limpiarModalNuevoAsunto() {
    $("#txtNuevoAsuntoAlias").val("");
    $("#txtNuevoAsuntoNumAvp").val("");
    $("#txtNuevoAsuntoFecha").val("");
    $("#ddlNuevoAsuntoEstatus").val("");
    $("#txtNuevoAsuntoDescripcion").val("");
    $("#txtNuevoAsuntoObservacionRelacion").val("");
}

function guardarNuevoAsuntoYVincular() {

    var alias = $("#txtNuevoAsuntoAlias").val().trim();

    if (alias === "") {
        swal("Validación", "Captura el alias del asunto.", "warning");
        return;
    }

    $("#btnGuardarNuevoAsuntoVincular")
        .prop("disabled", true)
        .html('<i class="fa fa-spinner fa-spin"></i> Guardando...');

    $.ajax({
        type: "POST",
        url: "@Url.Action("CrearAsuntoYRelacionarObjetivo", "Asuntos")",
        data: {
            alias: alias,
            descripcion: $("#txtNuevoAsuntoDescripcion").val(),
            numavp: $("#txtNuevoAsuntoNumAvp").val(),
            fechaAsunto: $("#txtNuevoAsuntoFecha").val(),
            int_id_estatus_asunto: $("#ddlNuevoAsuntoEstatus").val(),
            int_id_objetivo: $("#int_id_objetivo").val(),
            observacionesRelacion: $("#txtNuevoAsuntoObservacionRelacion").val()
        },
        success: function (resp) {

            $("#btnGuardarNuevoAsuntoVincular")
                .prop("disabled", false)
                .html('<i class="fa fa-save"></i> Guardar y vincular');

            if (resp.IsSuccess) {

                $("#modalCrearAsuntoVincular").modal("hide");

                refreshAsuntosObjetivoList(true);

                var idAsuntoCreado = resp.Id || resp.id || 0;
                var aliasAsuntoCreado = $("#txtNuevoAsuntoAlias").val();

                swal({
                    title: "Asunto creado",
                    text: resp.Message + "\n\n¿Deseas agregar víctimas a este asunto?",
                    type: "success",
                    showCancelButton: true,
                    confirmButtonColor: "#2f5bff",
                    cancelButtonColor: "#6c757d",
                    confirmButtonText: "Agregar víctimas",
                    cancelButtonText: "Después"
                }, function (isConfirm) {
                    if (isConfirm && idAsuntoCreado > 0) {
                        abrirModalVictimasDesdeFicha(idAsuntoCreado, aliasAsuntoCreado);
                    }
                });

                $("#txtBuscarAsuntoExistente").val("");
                $("#txtObservacionRelacionAsuntoModal").val("");

                if ($.fn.DataTable.isDataTable("#asuntosBusquedaDataTable")) {
                    $("#asuntosBusquedaDataTable").DataTable().clear().destroy();
                    $("#asuntosBusquedaDataTable tbody").empty();
                }
            }
             else {
                swal("Error", resp.Message, "error");
            }
        },
        error: function (xhr) {

            $("#btnGuardarNuevoAsuntoVincular")
                .prop("disabled", false)
                .html('<i class="fa fa-save"></i> Guardar y vincular');

            console.log(xhr.responseText);
            swal("Error", "Ocurrió un error al crear y vincular el asunto.", "error");
        }
    });
}


