function buscarAsuntosExistentes() {

    $.ajax({
        type: "POST",
        url: "@Url.Action("FillBusquedaAsuntosParaRelacionar", "Asuntos")",
        data: {
            texto: $("#txtBuscarAsuntoExistente").val(),
            active: true
        },
        success: function (data) {

            if ($.fn.DataTable.isDataTable("#asuntosBusquedaDataTable")) {
                $("#asuntosBusquedaDataTable").DataTable().clear().destroy();
                $("#asuntosBusquedaDataTable tbody").empty();
            }

            $("#asuntosBusquedaDataTable").DataTable({
                destroy: true,
                searching: true,
                responsive: true,
                scrollX: true,
                autoWidth: false,
                data: data,
                columns: [
                    {
                        title: "Alias",
                        data: "alias",
                        defaultContent: ""
                    },
                    {
                        title: "CI",
                        data: "numavp",
                        defaultContent: ""
                    },
                    {
                        title: "Acción",
                        data: "int_id_asunto_relacionado",
                        orderable: false,
                        searchable: false,
                            render: function (data, type, row) {
                                return `
                                    <button type="button"
                                            class="btn btn-success btn-sm"
                                            onclick="setAsuntoParaRelacionar(${row.int_id_asunto_relacionado}, '${row.numavp || ""}')">
                                        <i class="fa fa-check"></i>
                                    </button>
                                `;
                        }
                    }
                ],
                language: {
                    sProcessing: "Procesando...",
                    sLengthMenu: "Mostrar _MENU_ registros",
                    sZeroRecords: "No se encontraron resultados",
                    sEmptyTable: "Ningún dato disponible en esta tabla",
                    sInfo: "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                    sInfoEmpty: "Mostrando registros del 0 al 0 de un total de 0 registros",
                    sInfoFiltered: "(filtrado de un total de _MAX_ registros)",
                    sSearch: "Buscar:",
                    sLoadingRecords: "Cargando...",
                    oPaginate: {
                        sFirst: "Primero",
                        sLast: "Último",
                        sNext: "Siguiente",
                        sPrevious: "Anterior"
                    }
                }
            });
        },
        error: function (xhr) {
            console.log(xhr.responseText);
            alert("Ocurrió un error al buscar asuntos.");
        }
    });
    }
    function setAsuntoParaRelacionar(idAsunto, ci) {

        asuntoSeleccionado = idAsunto;
        ciAsuntoSeleccionado = ci || "";

        $("#modoModalObjetivoAsunto").val("add");
        $("#int_id_ficha_asunto_modal").val("0");

        $("#tituloModalObjetivoAsunto").text("Información del objetivo en el asunto");
        $("#btnGuardarObjetivoAsuntoModal").html('<i class="fa fa-save"></i> Aceptar');

        $("#selectRolParticipacionAsunto").val("");
        $("#txtDescripcionParticipacionAsunto").val("");
        $("#txtObservacionRelacionAsunto").val("");

        $("#lblAsuntoSeleccionado").text(ciAsuntoSeleccionado || "Asunto seleccionado");

        $("#modalObjetivo").modal("show");
    }

    function guardarObjetivoModal() {

        var modo = $("#modoModalObjetivoAsunto").val();

        var idRolParticipacion = $("#selectRolParticipacionAsunto").val();
        var descripcionParticipacion = $("#txtDescripcionParticipacionAsunto").val();
        var observaciones = $("#txtObservacionRelacionAsuntoModal").val();

        if (modo === "edit") {

            var idFichaAsunto = parseInt($("#int_id_ficha_asunto_modal").val() || "0");

            if (idFichaAsunto <= 0) {
                swal("Validación", "No se encontró la relación a editar.", "warning");
                return;
            }
            debugger;
            editarParticipacionObjetivoAsunto(
                idFichaAsunto,
                idRolParticipacion,
                descripcionParticipacion,
                observaciones
            );

            return;
        }

        if (!asuntoSeleccionado) {
            swal("Validación", "Selecciona un asunto para relacionar.", "warning");
            return;
        }

        RelacionarAsuntoExistente(
            asuntoSeleccionado,
            idRolParticipacion,
            descripcionParticipacion,
            observaciones
        );
    }


function RelacionarAsuntoExistente(
    int_id_asunto_relacionado,
    int_id_rol_participacion,
    nvarchar_descripcion_participacion,
    observaciones
) {

    $.ajax({
        type: "POST",
        url: "@Url.Action("RelacionarAsuntoObjetivo", "Asuntos")",
        data: {
            int_id_objetivo: $("#int_id_objetivo").val(),
            int_id_asunto_relacionado: int_id_asunto_relacionado,
            int_id_rol_participacion: int_id_rol_participacion,
            nvarchar_descripcion_participacion: nvarchar_descripcion_participacion,
            observaciones: observaciones
        },
        success: function (resp) {

            if (resp.IsSuccess) {

                swal("", resp.Message, "success");

                $("#modalObjetivo").modal("hide");

                asuntoSeleccionado = null;
                ciAsuntoSeleccionado = "";

                $("#selectRolParticipacionAsunto").val("");
                $("#txtDescripcionParticipacionAsunto").val("");
                $("#txtObservacionRelacionAsuntoModal").val("");

                refreshAsuntosObjetivoList(true);

            } else {
                swal("Error", resp.Message, "error");
            }
        },
        error: function (xhr) {
            console.log(xhr.responseText);
            swal("Error", "Ocurrió un error al relacionar el asunto.", "error");
        }
    });
    }

    function abrirEditarParticipacionObjetivoAsunto(
    int_id_ficha_asunto,
    alias,
    int_id_rol_participacion,
    descripcionParticipacion,
    observaciones
    ) {
    $("#modoModalObjetivoAsunto").val("edit");
    $("#int_id_ficha_asunto_modal").val(int_id_ficha_asunto || 0);

    $("#tituloModalObjetivoAsunto").text("Editar participación del objetivo en el asunto");
    $("#btnGuardarObjetivoAsuntoModal").html('<i class="fa fa-save"></i> Guardar cambios');

    $("#lblAsuntoSeleccionado").text(alias || "Asunto relacionado");

    $("#selectRolParticipacionAsunto").val(int_id_rol_participacion || "");
    $("#txtDescripcionParticipacionAsunto").val(descripcionParticipacion || "");
    $("#txtObservacionRelacionAsuntoModal").val(observaciones || "");

    $("#modalObjetivo").modal("show");
}

function editarParticipacionObjetivoAsunto(
    int_id_ficha_asunto,
    int_id_rol_participacion,
    descripcionParticipacion,
    observaciones
) {
    $.ajax({
        type: "POST",
        url: "@Url.Action("EditarParticipacionObjetivoAsunto", "Asuntos")",
        data: {
            int_id_ficha_asunto: int_id_ficha_asunto,
            int_id_rol_participacion: int_id_rol_participacion,
            descripcionParticipacion: descripcionParticipacion,
            observaciones: observaciones
        },
        success: function (resp) {

            if (resp.IsSuccess) {

                swal("", resp.Message, "success");

                $("#modalObjetivo").modal("hide");

                $("#modoModalObjetivoAsunto").val("add");
                $("#int_id_ficha_asunto_modal").val("0");

                $("#selectRolParticipacionAsunto").val("");
                $("#txtDescripcionParticipacionAsunto").val("");
                $("#txtObservacionRelacionAsuntoModal").val("");

                refreshAsuntosObjetivoList(true);

            } else {
                swal("Error", resp.Message, "error");
            }
        },
        error: function (xhr) {
            console.log(xhr.responseText);
            swal("Error", "Ocurrió un error al actualizar la participación.", "error");
        }
    });
}


