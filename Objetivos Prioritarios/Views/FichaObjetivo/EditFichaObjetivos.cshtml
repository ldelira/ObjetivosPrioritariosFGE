@model Objetivos_Prioritarios.Models.tb_FichaObjetivo
@using System.Linq
@using System.Collections.Generic

@{
    ViewBag.Title = "Ficha del Objetivo";

    var nombre = ViewBag.Nombre as string;
    if (string.IsNullOrWhiteSpace(nombre))
    {
        nombre = "SIN NOMBRE PRINCIPAL";
    }

    var estatusActual = "";
    if (ViewBag.EstatusActual != null)
    {
        estatusActual = ViewBag.EstatusActual.ToString();
    }

    if (string.IsNullOrWhiteSpace(estatusActual))
    {
        estatusActual = "Sin estatus";
    }

    var observacion = "";
    if (ViewBag.Observacion != null)
    {
        observacion = ViewBag.Observacion.ToString();
    }

    var descripcionEstatus = "";
    if (ViewBag.DescripcionEstatus != null)
    {
        descripcionEstatus = ViewBag.DescripcionEstatus.ToString();
    }

    var fotoBase64 = "";
    if (ViewBag.fotobase64 != null)
    {
        fotoBase64 = ViewBag.fotobase64.ToString();
    }

    var fotoSrc = "";
    if (!string.IsNullOrWhiteSpace(fotoBase64))
    {
        if (fotoBase64.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
        {
            fotoSrc = fotoBase64;
        }
        else
        {
            fotoSrc = "data:image/jpeg;base64," + fotoBase64;
        }
    }

    var aliasList = ViewBag.Alias as IEnumerable<string>;
    var aliasTexto = aliasList != null && aliasList.Any()
        ? string.Join(", ", aliasList)
        : "Sin alias";

    var gruposList = ViewBag.GruposDelictivos as IEnumerable<string>;
    var gruposTexto = gruposList != null && gruposList.Any()
        ? string.Join(", ", gruposList)
        : "Sin grupo asignado";

    var nombresSecundariosList = ViewBag.Nombress as IEnumerable<string>;
    var nombresSecundariosTexto = nombresSecundariosList != null && nombresSecundariosList.Any()
        ? string.Join(", ", nombresSecundariosList)
        : "Sin nombres secundarios";

    var catalogoEstatus = ViewBag.CatalogoEstatus;


    DateTime? fechaNacimientoObj = null;

    if (ViewBag.FechaNacimiento != null)
    {
        DateTime fechaParsed;
        if (DateTime.TryParse(ViewBag.FechaNacimiento.ToString(), out fechaParsed))
        {
            fechaNacimientoObj = fechaParsed;
        }
    }

    if (!fechaNacimientoObj.HasValue && Model != null)
    {
        try
        {
            var propFechaDirecta = Model.GetType().GetProperty("date_fecha_nacimiento");
            if (propFechaDirecta != null)
            {
                var valorFechaDirecta = propFechaDirecta.GetValue(Model, null);
                if (valorFechaDirecta != null)
                {
                    fechaNacimientoObj = Convert.ToDateTime(valorFechaDirecta);
                }
            }

            if (!fechaNacimientoObj.HasValue)
            {
                var propObjetivo = Model.GetType().GetProperty("tb_Objetivo");
                if (propObjetivo != null)
                {
                    var objetivoNav = propObjetivo.GetValue(Model, null);
                    if (objetivoNav != null)
                    {
                        var propFechaObjetivo = objetivoNav.GetType().GetProperty("date_fecha_nacimiento");
                        if (propFechaObjetivo != null)
                        {
                            var valorFechaObjetivo = propFechaObjetivo.GetValue(objetivoNav, null);
                            if (valorFechaObjetivo != null)
                            {
                                fechaNacimientoObj = Convert.ToDateTime(valorFechaObjetivo);
                            }
                        }
                    }
                }
            }
        }
        catch
        {
            fechaNacimientoObj = null;
        }
    }

    var fechaNacimientoInput = fechaNacimientoObj.HasValue
        ? fechaNacimientoObj.Value.ToString("yyyy-MM-dd")
        : "";

    var fechaNacimientoTexto = fechaNacimientoObj.HasValue
        ? fechaNacimientoObj.Value.ToString("dd/MM/yyyy")
        : "Sin fecha registrada";

    var edadTexto = "";
    if (fechaNacimientoObj.HasValue)
    {
        var hoy = DateTime.Today;
        var edad = hoy.Year - fechaNacimientoObj.Value.Year;
        if (fechaNacimientoObj.Value.Date > hoy.AddYears(-edad))
        {
            edad--;
        }

        if (edad >= 0 && edad < 130)
        {
            edadTexto = " (" + edad + " años)";
        }
    }
    var rolesParticipacion = ViewBag.RolesParticipacionAsunto as List<Objetivos_Prioritarios.Models.cat_RolParticipacionAsunto>;
}

<input type="hidden" id="int_id_objetivo" value="@Model.int_id_objetivo" />
<input type="hidden" id="int_id_ficha_objetivo" value="@Model.int_id_ficha_objetivo" />

<script>
    var int_id_objetivo = parseInt($("#int_id_objetivo").val() || "0");
    var int_id_ficha_objetivo = parseInt($("#int_id_ficha_objetivo").val() || "0");

    window.int_id_objetivo = int_id_objetivo;
    window.int_id_ficha_objetivo = int_id_ficha_objetivo;
</script>

<div class="op-page">

    <div class="op-page-title">
        @*<h2>Ficha del Objetivo</h2>*@
        <div class="op-breadcrumb">
            Objetivos Prioritarios / Ficha del Objetivo
        </div>
    </div>

    <div class="op-header-card op-header-card-hero">

        <div class="op-photo-panel">
            <div class="op-photo-box op-photo-box-large">
                @if (!string.IsNullOrWhiteSpace(fotoSrc))
                {
                    <img src="@fotoSrc" class="op-photo" />
                }
                else
                {
                    <div class="op-photo-empty">
                        <i class="fa fa-user"></i>
                        <span>Sin foto</span>
                    </div>
                }
            </div>

            <button type="button"
                    class="op-photo-action"
                    data-bs-toggle="modal"
                    data-bs-target="#modalFotoFechaObjetivo">
                <i class="fa fa-camera"></i> Actualizar foto
            </button>
        </div>

        <div class="op-main-info op-main-info-hero">

            <div class="op-title-row op-title-row-hero">
                <div>
                    <h1>@nombre</h1>
                    <p>Ficha del objetivo prioritario</p>
                </div>

                <span class="op-status op-status-hero">
                    <i class="fa fa-circle"></i> @estatusActual
                </span>
            </div>

            <div class="op-info-grid op-info-grid-hero">
                <div class="op-info-item op-info-item-hero">
                    <div class="op-info-icon">
                        <i class="fa fa-tag"></i>
                    </div>
                    <div>
                        <label>Alias</label>
                        <strong>@aliasTexto</strong>
                    </div>
                </div>

                <div class="op-info-item op-info-item-hero">
                    <div class="op-info-icon">
                        <i class="fa fa-users"></i>
                    </div>
                    <div>
                        <label>Grupo delictivo</label>
                        <strong>@gruposTexto</strong>
                    </div>
                </div>

                <div class="op-info-item op-info-item-hero">
                    <div class="op-info-icon">
                        <img src="@Url.Content("~/images/icons8-id-card-48.png")" alt="ID Objetivo" />
                    </div>
                    <div>
                        <label>ID Objetivo</label>
                        <strong>@Model.int_id_objetivo</strong>
                    </div>
                </div>

                <div class="op-info-item op-info-item-hero">
                    <div class="op-info-icon">
                        <i class="fa fa-calendar"></i>
                    </div>
                    <div>
                        <label>Fecha de nacimiento</label>
                        <strong>@fechaNacimientoTexto@edadTexto</strong>
                    </div>
                </div>
            </div>

            <div class="op-actions op-actions-hero">
                <a class="btn btn-primary"
                   href="@Url.Action("AddEditObjetivos", "Objetivo", new { int_id_objetivo = Model.int_id_objetivo })">
                    <i class="fa fa-edit"></i> Editar identidad
                </a>

                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalBusquedaInfoGeneralDetenidos">
                    <i class="fa fa-database"></i> Importar desde detenidos
                </button>

                <button type="button" class="btn btn-outline-primary" id="btnIrRelaciones">
                    <i class="fa fa-folder-open"></i> Relacionar carpeta
                </button>
            </div>

        </div>

        <div class="op-side-update">
            <div class="op-side-update-icon">
                <i class="fa fa-camera"></i>
            </div>
            <h4>Foto y fecha de nacimiento</h4>
            <p>Actualiza la fotografía y la fecha de nacimiento del objetivo.</p>
            <button type="button"
                    class="btn btn-primary btn-block"
                    data-bs-toggle="modal"
                    data-bs-target="#modalFotoFechaObjetivo">
                <i class="fa fa-edit"></i> Editar foto y fecha
            </button>
        </div>

    </div>

    <div class="op-tabs-wrapper">

        <ul class="nav nav-tabs op-tabs" id="tabsFichaObjetivo">
            <li class="nav-item">
                <a class="nav-link active op-tab-link" href="#tabResumen">
                    <i class="fa fa-list"></i> Resumen
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link op-tab-link" href="#tabIdentidad">
                    <i class="fa fa-user"></i> Identidad
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link op-tab-link" href="#tabDomicilios">
                    <i class="fa fa-map-marker"></i> Domicilios
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link op-tab-link" href="#tabGrupos">
                    <i class="fa fa-users"></i> Grupos
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link op-tab-link" href="#tabRelaciones">
                    <i class="fa fa-gavel"></i> Carpetas de Investigación
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link op-tab-link" href="#tabMandamientos">
                    <i class="fa fa-gavel"></i> Mandamientos Judiciales
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link op-tab-link" href="#tabFiliacion">
                    <i class="fa fa-link"></i> Detenidos/Filiación
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link op-tab-link" href="#tabAsuntos">
                    <i class="fa fa-link"></i> Asuntos relacionados
                </a>
            </li>
        </ul>

        <div class="op-tab-content">


            <!-- TAB RESUMEN -->
            <div class="op-tab-pane active" id="tabResumen">
                <div class="op-summary-grid">

                    <div class="op-summary-card">
                        <div class="op-summary-icon">
                            <i class="fa fa-user"></i>
                        </div>
                        <div>
                            <label>Nombres</label>
                            <strong id="countNombres">@(ViewBag.CountNombres ?? 0)</strong>
                        </div>
                    </div>

                    <div class="op-summary-card">
                        <div class="op-summary-icon">
                            <i class="fa fa-tag"></i>
                        </div>
                        <div>
                            <label>Alias</label>
                            <strong id="countAlias">@(ViewBag.CountAlias ?? 0)</strong>
                        </div>
                    </div>

                    <div class="op-summary-card">
                        <div class="op-summary-icon">
                            <i class="fa fa-map-marker"></i>
                        </div>
                        <div>
                            <label>Domicilios</label>
                            <strong id="countDomicilios">@(ViewBag.CountDomicilios ?? 0)</strong>
                        </div>
                    </div>

                    <div class="op-summary-card">
                        <div class="op-summary-icon">
                            <i class="fa fa-users"></i>
                        </div>
                        <div>
                            <label>Grupos</label>
                            <strong id="countGrupos">@(ViewBag.CountGrupos ?? 0)</strong>
                        </div>
                    </div>

                    <div class="op-summary-card">
                        <div class="op-summary-icon">
                            <i class="fa fa-folder-open"></i>
                        </div>
                        <div>
                            <label>Carpetas</label>
                            <strong id="countCarpetas">@(ViewBag.CountCarpetas ?? 0)</strong>
                        </div>
                    </div>

                    <div class="op-summary-card">
                        <div class="op-summary-icon">
                            <i class="fa fa-gavel"></i>
                        </div>
                        <div>
                            <label>Órdenes</label>
                            <strong id="countOrdenes">@(ViewBag.CountOrdenes ?? 0)</strong>
                        </div>
                    </div>

                    <div class="op-summary-card">
                        <div class="op-summary-icon">
                            <img src="@Url.Content("~/images/icons8-fingerprint-50.png")" alt="Filiación" />
                        </div>
                        <div>
                            <label>Filiación</label>
                            <strong id="countFiliacion">@(ViewBag.CountFiliacion ?? 0)</strong>
                        </div>
                    </div>

                    <div class="op-summary-card">
                        <div class="op-summary-icon">
                            <i class="fa fa-link"></i>
                        </div>
                        <div>
                            <label>Asuntos</label>
                            <strong id="countAsuntos">@(ViewBag.CountAsuntos ?? 0)</strong>
                        </div>
                    </div>

                </div>
                <div class="row">

                    <div class="col-md-4">
                        <div class="op-card op-card-full">
                            <div class="op-card-title">
                                <h4>Datos generales</h4>
                            </div>

                            <div class="op-data-row">
                                <label>Nombre principal</label>
                                <span>@nombre</span>
                            </div>

                            <div class="op-data-row">
                                <label>Alias</label>
                                <span>@aliasTexto</span>
                            </div>

                            <div class="op-data-row">
                                <label>Grupo delictivo</label>
                                <span>@gruposTexto</span>
                            </div>

                            <div class="op-data-row">
                                <label>Estatus actual</label>
                                <span class="op-mini-status">@estatusActual</span>
                            </div>

                            <div class="op-data-row">
                                <label>Nombres secundarios</label>
                                <span>@nombresSecundariosTexto</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="op-card op-card-full">
                            <div class="op-card-title">
                                <h4>Observación importante</h4>
                            </div>

                            @if (string.IsNullOrWhiteSpace(observacion))
                            {
                                <div class="op-empty">
                                    Sin observaciones registradas.
                                </div>
                            }
                            else
                            {
                                <div class="op-warning-box">
                                    @observacion
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="op-card op-card-full">
                            <div class="op-card-title">
                                <h4>Descripción del estatus</h4>
                            </div>

                            @if (string.IsNullOrWhiteSpace(descripcionEstatus))
                            {
                                <div class="op-empty">
                                    Sin descripción registrada.
                                </div>
                            }
                            else
                            {
                                <p class="op-description">@descripcionEstatus</p>
                            }
                        </div>
                    </div>

                </div>

                <div class="op-card op-mt-3">
                    <div class="op-card-title">
                        <h4>Actualizar estatus y observaciones</h4>
                        <span>Modifica la información principal de la ficha</span>
                    </div>

                    <div class="row">

                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Estatus del proceso</label>
                                <select id="ddlEstatusProceso" class="form-control">
                                    <option value="">Seleccione...</option>

                                    @if (catalogoEstatus != null)
                                    {
                                        foreach (var item in catalogoEstatus)
                                        {
                                            var selected = "";
                                            try
                                            {
                                                if (Model.int_id_estatus_proceso == item.int_id_estatus_proceso)
                                                {
                                                    selected = "selected";
                                                }
                                            }
                                            catch { }

                                            <option value="@item.int_id_estatus_proceso" @selected>
                                                @item.nvarchar_estatus
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-md-8">
                            <div class="form-group">
                                <label>Descripción del estatus</label>
                                <textarea id="txtDescripcionEstatus"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Describe el estatus actual del objetivo...">@descripcionEstatus</textarea>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Observación importante del objetivo</label>
                                <textarea id="txtObservacionesObjetivo"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Agrega observaciones relevantes del objetivo...">@observacion</textarea>
                            </div>
                        </div>

                        <div class="col-md-12 text-right">
                            <button type="button" class="btn btn-primary" id="btnGuardarResumen">
                                <i class="fa fa-save"></i> Guardar resumen
                            </button>
                        </div>

                    </div>
                </div>

            </div>

            <!-- TAB IDENTIDAD -->
            <div class="op-tab-pane" id="tabIdentidad">

                <div class="op-section-header">
                    <div>
                        <h3>Identidad del objetivo</h3>
                        <p>Administra nombres, alias, fotografía y datos básicos del objetivo.</p>
                    </div>

                    <a class="btn btn-primary"
                       href="@Url.Action("AddEditObjetivos", "Objetivo", new { int_id_objetivo = Model.int_id_objetivo })">
                        <i class="fa fa-edit"></i> Abrir edición completa
                    </a>
                </div>

                <div class="row">

                    <div class="col-md-6">
                        <div class="op-card">
                            <div class="op-card-title">
                                <h4>Nombres registrados</h4>
                                <span>Nombres principales y alternativos</span>
                            </div>

                            <div id="listaNombrePersona"></div>

                            @*Html.Action("ObjetivoNombreListPartial", "Objetivo", new { actives = true })*@
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="op-card">
                            <div class="op-card-title">
                                <h4>Alias registrados</h4>
                                <span>Sobrenombres conocidos</span>
                            </div>

                            <div id="listaAliasObjetivo"></div>
                            @*Html.Action("ObjetivoAliasListPartial", "Objetivo", new { actives = true })*@
                        </div>
                    </div>

                </div>

            </div>

            <!-- TAB DOMICILIOS -->
            <div class="op-tab-pane" id="tabDomicilios">

                <div class="op-section-header">
                    <div>
                        <h3>Domicilios del objetivo</h3>
                        <p>Consulta, agrega o edita domicilios asociados al objetivo.</p>
                    </div>
                </div>

                <div class="op-card">
                    <div id="listaDomicilioObjetivo"></div>
                    @*Html.Action("ObjetivoDomicilioListPartial", "Objetivo", new { actives = true })*@
                </div>

            </div>

            <!-- TAB GRUPOS -->
            <div class="op-tab-pane" id="tabGrupos">

                <div class="op-section-header">
                    <div>
                        <h3>Grupos delictivos</h3>
                        <p>Administra los grupos relacionados al objetivo.</p>
                    </div>
                </div>

                <div class="op-card">
                    <div id="listaGrupoDelictivo"></div>
                    @*Html.Action("ObjetivoGrupoListPartial", "Objetivo", new { actives = true })*@
                </div>

            </div>

            <!-- TAB CARPETAS INVESTIGACIÓN -->
            <div class="op-tab-pane" id="tabRelaciones">

                <div class="op-section-header">
                    <div>
                        <h3>Carpetas de Investigación</h3>
                        <p>Relaciona carpetas de investigación relacionados al objetivo.</p>
                    </div>
                </div>

                <div class="row">

                    <div class="col-md-6">
                        <div class="op-card">
                            <div class="op-card-title">
                                <h4>Búsqueda de carpetas</h4>
                                <span>Busca por nombre o número de carpeta.</span>
                            </div>
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">Búsqueda de Carpeta</h5>
                                    <!-- Radios de tipo de búsqueda -->
                                    <div class="mb-3">
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="tipoBusqueda" id="radioNombre" value="1" checked>
                                            <label class="form-check-label" for="radioNombre">Por Nombre</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="tipoBusqueda" id="radioCarpeta" value="2">
                                            <label class="form-check-label" for="radioCarpeta">Por Carpeta de Investigación</label>
                                        </div>
                                    </div>
                                    <!-- Campos de búsqueda por nombre -->
                                    <div id="busquedaPorNombre">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="searchName" class="form-label">Nombre</label>
                                                <input type="text" class="form-control" id="searchName" placeholder="Nombre">
                                            </div>
                                            <div class="col-md-4">
                                                <label for="searchPaterno" class="form-label">Apellido Paterno</label>
                                                <input type="text" class="form-control" id="searchPaterno" placeholder="Paterno">
                                            </div>
                                            <div class="col-md-4">
                                                <label for="searchMaterno" class="form-label">Apellido Materno</label>
                                                <input type="text" class="form-control" id="searchMaterno" placeholder="Materno">
                                            </div>
                                        </div>
                                        <br>
                                    </div>
                                    <!-- Campo de búsqueda por carpeta -->
                                    <div class="mb-3 d-none" id="busquedaPorCarpeta">
                                        <label for="numavp" class="form-label">Carpeta de Investigación</label>
                                        <input type="text" class="form-control" id="numavp" placeholder="Número de carpeta">
                                    </div>
                                    <div class="mb-3">
                                        <button type="button" id="btnBuscar" class="btn btn-primary w-100">
                                            <i class="fa fa-search"></i> Buscar detenido
                                        </button>
                                    </div>
                                    <div id="busquedaCarpetas"></div>
                                </div>
                            </div>
                            @*Html.Action("BusquedaCarpetasListPartial", "FichaObjetivo")*@
                            @*<div id="busquedaCarpetas"></div>*@
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="op-card">
                            <div class="op-card-title">
                                <h4>Carpetas relacionadas</h4>
                                <span>Carpetas ya vinculadas al objetivo.</span>
                            </div>

                            @*Html.Action("CarpetasRelacionadasListPartial", "FichaObjetivo", new { actives = true })*@
                            <div id="carpetasRelacionadas"></div>

                        </div>
                    </div>

                </div>



            </div>
            <!-- TAB MANDAMIENTOS JUDICIALES -->
            <div class="op-tab-pane" id="tabMandamientos">

                <div class="op-section-header">
                    <div>
                        <h3>Mandamientos Judiciales</h3>
                        <p>Relaciona mandamientos judiciales relacionados al objetivo.</p>
                    </div>
                </div>

                <div class="row">

                    <div class="col-md-6">
                        <div class="op-card">
                            <div class="op-card-title">
                                <h4>Búsqueda de órdenes</h4>
                                <span>Busca órdenes de aprehensión para relacionar.</span>
                            </div>
