    function pintarMapa(nodes, edges, modo) {
        dataNodosMapa = nodes || [];

        if (networkMapa) {
            networkMapa.destroy();
            networkMapa = null;
        }

        nodesMapa = new vis.DataSet(nodes || []);
        edgesMapa = new vis.DataSet(edges || []);

        var container = document.getElementById("mapaRelaciones");

        var data = {
            nodes: nodesMapa,
            edges: edgesMapa
        };
        var esModoObjetivo = modo === "objetivo";
        var options = {
            autoResize: true,
            layout: {
                hierarchical: {
                    enabled: esModoObjetivo,
                    direction: "LR",
                    sortMethod: "directed",
                    levelSeparation: 240,
                    nodeSpacing: 190,
                    treeSpacing: 240
                }
            },
            interaction: {
                hover: true,
                tooltipDelay: 120,
                navigationButtons: true,
                keyboard: true
            },
            physics: {
                enabled: !esModoObjetivo,
                stabilization: {
                    iterations: 150
                },
                barnesHut: {
                    gravitationalConstant: -5500,
                    springLength: 190,
                    springConstant: 0.04,
                    damping: 0.18
                }
            },
            nodes: {
                borderWidth: 2,
                shadow: {
                    enabled: true,
                    color: "rgba(15, 35, 75, .18)",
                    size: 10,
                    x: 0,
                    y: 4
                }
            },
            edges: {
                smooth: {
                    enabled: true,
                    type: esModoObjetivo ? "cubicBezier" : "dynamic",
                    forceDirection: esModoObjetivo ? "horizontal" : "none",
                    roundness: 0.4
                },
                width: 2,
                shadow: false
            }
        };

        networkMapa = new vis.Network(container, data, options);

        networkMapa.once("stabilizationIterationsDone", function () {
            networkMapa.fit({
                animation: {
                    duration: 600,
                    easingFunction: "easeInOutQuad"
                }
            });
        });

        networkMapa.on("click", function (params) {
            if (params.nodes.length === 0) {
                limpiarPanelDetalle();
                return;
            }

            var nodeId = params.nodes[0];

            var nodo = dataNodosMapa.find(function (x) {
                return x.id === nodeId;
            });

            if (!nodo) {
                limpiarPanelDetalle();
                return;
            }

            mostrarDetalleNodo(nodo);
        });
        networkMapa.on("oncontext", function (params) {
            params.event.preventDefault();

            var nodeId = networkMapa.getNodeAt(params.pointer.DOM);

            if (!nodeId) {
                return;
            }

            var nodo = dataNodosMapa.find(function (x) {
                return x.id === nodeId;
            });

            if (!nodo) {
                return;
            }

            if (nodo.tipo === "grupoCaso") {
                mostrarParticipantesGrupoCaso(nodo);
                return;
            }

            mostrarDetalleNodo(nodo);
        });
    }

    function mostrarParticipantesGrupoCaso(nodo) {

        var participantes = nodo.participantesCaso || [];

        var htmlParticipantes = "";

        if (participantes.length === 0) {
            htmlParticipantes = `
            <div class="op-table-empty">
                No hay participantes registrados para este grupo en el asunto.
            </div>
        `;
        } else {
            htmlParticipantes = `
            <div class="op-participant-list">
                ${participantes.map(function (p) {

                var botonFicha = "";

                if (p.int_id_objetivo) {
                    botonFicha = `
                            <button type="button"
                                    class="btn btn-primary btn-sm op-btn-ficha-participante"
                                    title="Abrir ficha informativa"
                                    onclick="abrirFichaObjetivo(${p.int_id_objetivo})">
                                <i class="fa fa-eye"></i>
                            </button>
                        `;
                }

                return `
                        <div class="op-participant-item">

                            <div class="op-participant-info">
                                <strong>${p.nombre || "SIN NOMBRE"}</strong>
                                <span>${p.alias || "SIN ALIAS"}</span>

                                <div class="op-participant-role">
                                    ${p.rol || "Por definir"}
                                </div>

                                ${p.participacion ? `
                                    <div class="op-participant-desc">
                                        ${p.participacion}
                                    </div>
                                ` : ""}
                            </div>

                            ${botonFicha}

                        </div>
                    `;
            }).join("")}
            </div>
        `;
        }

        $("#panelDetalleNodo").html(`
        <div class="op-panel-empty">
            <i class="fa fa-users"></i>
            <p><strong>${nodo.alias || nodo.label || "Grupo"}</strong></p>
            <p>Participantes del grupo en el asunto</p>
        </div>

        <div class="op-node-info">
            <label>Asunto</label>
            <div>${nodo.asunto || "Sin información"}</div>

            <label>Grupo / cártel</label>
            <div>${nodo.nombre || nodo.label || "Sin información"}</div>

            ${nodo.perteneceObjetivoPrincipal ? `
                <label>Relación con el objetivo seleccionado</label>
                <div>Este es un grupo/cártel donde aparece registrado el objetivo seleccionado.</div>
            ` : ""}

            <label>Total participantes</label>
            <div>${participantes.length}</div>
        </div>

        ${htmlParticipantes}
    `);
    }
    function mostrarVictimasCaso(nodo) {

        var victimas = nodo.victimasCaso || [];

        var htmlVictimas = "";

        if (victimas.length === 0) {
            htmlVictimas = `
            <div class="op-table-empty">
                No hay víctimas registradas para este asunto.
            </div>
        `;
        } else {
            htmlVictimas = `
            <div class="op-participant-list">
                ${victimas.map(function (v) {
                return `
                        <div class="op-participant-item">
                            <div>
                                <strong>${v.nombre || "VÍCTIMA SIN NOMBRE"}</strong>
                                <span>Víctima relacionada</span>
                            </div>
                            <small>Víctima</small>
                        </div>
                    `;
            }).join("")}
            </div>
        `;
        }

        $("#panelDetalleNodo").html(`
        <div class="op-panel-empty">
            <i class="fa fa-users"></i>
            <p><strong>Víctimas</strong></p>
            <p>Víctimas relacionadas al asunto</p>
        </div>

        <div class="op-node-info">
            <label>Asunto</label>
            <div>${nodo.asunto || "Sin información"}</div>

            <label>Total víctimas</label>
            <div>${victimas.length}</div>
        </div>

        ${htmlVictimas}
    `);
    }

    function mostrarDetalleNodo(nodo) {

        if (!nodo) {
            limpiarPanelDetalle();
            return;
        }

        if (nodo.tipo === "album") {
            $("#panelDetalleNodo").html(`
                <div class="op-panel-empty">
                    <i class="fa fa-folder-open"></i>
                    <p><strong>${nodo.nombre || nodo.label || "Álbum"}</strong></p>
                    <p>Álbum de objetivos prioritarios</p>
                </div>

                <div class="op-node-info">
                    <label>Descripción</label>
                    <div>${nodo.descripcion || "Sin información"}</div>

                    <label>Total de objetivos</label>
                    <div>${nodo.total || 0}</div>
                </div>
            `);
            return;
        }

        if (nodo.tipo === "asunto") {
            $("#panelDetalleNodo").html(`
                <div class="op-panel-empty">
                    <i class="fa fa-share-alt"></i>
                    <p><strong>${nodo.label || "Asunto relacionado"}</strong></p>
                    <p>Asunto relacionado</p>
                </div>

                <div class="op-node-info">
                    <label>Descripción</label>
                    <div>${nodo.descripcion || nodo.title || "Sin información"}</div>

                    <label>Número de carpeta / AVP</label>
                    <div>${nodo.numavp || "Sin información"}</div>

                    <label>Fecha del asunto</label>
                    <div>${nodo.fecha || "Sin información"}</div>
                </div>
            `);
            return;
        }

        if (nodo.tipo === "victima") {
            $("#panelDetalleNodo").html(`
                <img class="op-node-photo" src="${nodo.image}" />

                <div class="op-node-name">${nodo.nombre || "VÍCTIMA SIN NOMBRE"}</div>
                <div class="op-node-alias">Víctima relacionada</div>

                <div class="op-node-info">
                    <label>Tipo de nodo</label>
                    <div>Víctima</div>
                </div>
            `);
            return;
        }
        if (nodo.tipo === "grupoCaso") {
    mostrarParticipantesGrupoCaso(nodo);
    return;
}

if (nodo.tipo === "victimasCaso") {
    mostrarVictimasCaso(nodo);
    return;
}


        if (nodo.tipo === "grupo") {
            $("#panelDetalleNodo").html(`
                <div class="op-panel-empty">
                    <i class="fa fa-users"></i>
                    <p><strong>${nodo.label || "Grupo delictivo"}</strong></p>
                    <p>Grupo delictivo</p>
                </div>

                <div class="op-node-info">
                    <label>Alias / clave</label>
                    <div>${nodo.title || "Sin información"}</div>
                </div>
            `);
            return;
        }

        if (nodo.tipo !== "objetivo") {
            $("#panelDetalleNodo").html(`
                <div class="op-panel-empty">
                    <i class="fa fa-sitemap"></i>
                    <p>${nodo.label || "Nodo seleccionado"}</p>
                </div>
            `);
            return;
        }

        var bloqueExtra = "";

        if (nodo.esPrincipal) {
            bloqueExtra = `
        <label>Tipo</label>
        <div>Objetivo seleccionado</div>

        <label>Grupo / cártel registrado</label>
        <div>${nodo.grupos || "Sin grupo"}</div>

        <label>Puesto / nivel</label>
        <div>${nodo.puestos || "Por definir"}</div>
    `;
        }
        else if (nodo.rol || nodo.participacion) {
            bloqueExtra = `
                <label>Rol en el asunto</label>
                <div>${nodo.rol || "Por definir"}</div>

                <label>Participación</label>
                <div>${nodo.participacion || "Sin información"}</div>
            `;
        }
        else if (nodo.grupos || nodo.puestos || nodo.estatus) {
            bloqueExtra = `
                <label>Grupos</label>
                <div>${nodo.grupos || "Sin grupo"}</div>

                <label>Puesto / nivel</label>
                <div>${nodo.puestos || "Por definir"}</div>

                <label>Estatus</label>
                <div>${nodo.estatus || "Sin estatus"}</div>

                <label>Descripción estatus</label>
                <div>${nodo.descripcionEstatus || "Sin información"}</div>
            `;
        }
        else {
            bloqueExtra = `
                <label>Puesto / nivel</label>
                <div>${nodo.puesto || "Por definir"}</div>

                <label>Función dentro del grupo</label>
                <div>${nodo.funcion || "Sin información"}</div>

                <label>Fecha ingreso</label>
                <div>${nodo.fechaIngreso || "Sin información"}</div>

                <label>Fecha salida</label>
                <div>${nodo.fechaSalida || "Sin información"}</div>
            `;
        }

        $("#panelDetalleNodo").html(`
            <img class="op-node-photo" src="${nodo.image}" />

            <div class="op-node-name">${nodo.nombre || "SIN NOMBRE"}</div>
            <div class="op-node-alias">${nodo.alias || "SIN ALIAS"}</div>

            <div class="op-node-info">
                ${bloqueExtra}

                <label>Observaciones</label>
                <div>${nodo.observaciones || "Sin información"}</div>
            </div>

            <button type="button"
                    class="btn btn-primary btn-block"
                    onclick="abrirFichaObjetivo(${nodo.int_id_objetivo})">
                <i class="fa fa-eye"></i> Abrir ficha informativa
            </button>
        `);
    }

    function limpiarPanelDetalle() {
        $("#panelDetalleNodo").html(`
            <div class="op-panel-empty">
                <i class="fa fa-mouse-pointer"></i>
                <p>Selecciona un nodo del mapa para ver su información.</p>
            </div>
        `);
    }

    function abrirFichaObjetivo(idObjetivo) {
        window.open("@Url.Action("EditFichaObjetivos", "FichaObjetivo")?int_id_objetivo=" + idObjetivo, "_blank");
    }
</script>