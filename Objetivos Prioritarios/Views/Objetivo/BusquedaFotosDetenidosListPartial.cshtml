@{
    var rowData = ViewBag.RowData;
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">📸 Foto principal del detenido</h5>
        </div>
        <div class="card-body text-center">
            <div class="mb-4">
                <p><strong>ID Objetivo:</strong> @ViewBag.IdObjetivo</p>
                <p><strong>Nombre completo:</strong> @($"{rowData.nombre} {rowData.paterno} {rowData.materno}")</p>
                <p><strong>Clave PERSO:</strong> @rowData.CLAVE_PERSO</p>
            </div>

            <div class="mb-4">
                @if (string.IsNullOrEmpty(ViewBag.FotoBase64))
                {
                    <div class="text-muted" style="font-style: italic;">Cargando Fotografía</div>
                }
                else if (ViewBag.FotoBase64.StartsWith("/Content"))
                {
                    <img id="previewFoto"
                         src="@ViewBag.FotoBase64"
                         alt="Foto del detenido"
                         class="img-thumbnail mb-3"
                         style="width: 250px; height: 250px; object-fit: cover;">
                }
                else
                {
                    <img id="previewFoto"
                         src="data:image/jpeg;base64,@ViewBag.FotoBase64"
                         alt="Foto del detenido"
                         class="img-thumbnail mb-3"
                         style="width: 250px; height: 250px; object-fit: cover;">
                }
            </div>

        </div>
        <input type="hidden" id="fotoBase64Hidden" value="@ViewBag.FotoBase64" />
        <button id="btnGuardarFoto" class="btn btn-success px-4">✅ Aceptar / Guardar foto</button>
    </div>
</div>

<script>
$(document).ready(function () {

    const $input = $("#int_id_objetivo");
    const idObjetivo = parseInt('@ViewBag.IdObjetivo', 10);
    const $btnGuardar = $("#btnGuardarFoto");

    if ($input.length > 0 && $input.val()) {

        const idGlobal = parseInt($input.val(), 10);

        console.log("Existe int_id_objetivo:", idGlobal);
        console.log("ID Objetivo actual:", idObjetivo);

        // 🔴 Si es de OTRO objetivo
        if (idGlobal !== idObjetivo) {

            $btnGuardar
                .prop("disabled", true)                 // ✅ DESHABILITADO REAL
                .removeClass("btn-success")
                .addClass("btn-warning")
                .html("⚠️ Foto de otro objetivo")
                .css({
                    "cursor": "not-allowed",
                    "opacity": "0.7"
                })
                .attr("title", "Esta foto pertenece a otro objetivo");
        }
    }

    // 🔹 Click (por seguridad extra)
    $btnGuardar.on("click", function (e) {
        if ($(this).prop("disabled")) {
            e.preventDefault();
            return;
        }

        const fotoBase64 = document.getElementById('fotoBase64Hidden').value;

        if (!fotoBase64) {
            swal("Atención", "No hay foto disponible para guardar.", "warning");
            return;
        }

        const datos = {
            IdObjetivo: idObjetivo,
            FotoBase64: fotoBase64
        };

        $.ajax({
            url: '/Objetivo/GuardarFotoDetenido',
            type: 'POST',
            data: JSON.stringify(datos),
            contentType: 'application/json; charset=utf-8',
            success: function (response) {
                if (response && response.IsSuccess) {
                    swal({
                        title: "Éxito",
                        text: response.Message,
                        type: 'success',
                        confirmButtonText: "Continuar"
                    }, function () {
                        location.reload();
                    });
                } else {
                    swal("Error", response ? response.Message : "Respuesta inesperada", "error");
                }
            },
            error: function () {
                swal("Error", "No se pudo guardar la foto.", "error");
            }
        });
    });

});
</script>


