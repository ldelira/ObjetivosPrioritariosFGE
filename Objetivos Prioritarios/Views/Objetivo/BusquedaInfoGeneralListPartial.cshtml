@model List<Objetivos_Prioritarios.Models.SP_ObjPri_getListinfogeneral_Result>

<div class="table-responsive w-100 border-0 p-1">
    <table id="objetivoDataTable" class="table table-hover table-institutional w-100"></table>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var infoGeneralColumns = [
            { title: "ID", data: "id", orderable: true, visible: false },
            { title: "Clave Persona", data: "CLAVE_PERSO", orderable: true },
            {
                title: "ID's",
                data: "id_concat",
                orderable: true,
                render: function (data) {
                    return data ? `<span class="text-muted small">${data.replace(/(\r\n|\n|\r)/g, "<br>")}</span>` : "";
                }
            },
            {
                title: "Nombre Completo",
                data: null,
                render: function (data, type, row) {
                    let nombreLines = (row.nombre || "").split(/\r\n|\r|\n/);
                    let paternoLines = (row.paterno || "").split(/\r\n|\r|\n/);
                    let maternoLines = (row.materno || "").split(/\r\n|\r|\n/);
                    let maxLen = Math.max(nombreLines.length, paternoLines.length, maternoLines.length);
                    let resultado = [];

                    for (let i = 0; i < maxLen; i++) {
                        let n = nombreLines[i] || "";
                        let p = paternoLines[i] || "";
                        let m = maternoLines[i] || "";
                        // Se agrega un pequeño estilo de negrita al nombre para que resalte
                        if(n || p || m) {
                            resultado.push(`<span class="fw-semibold text-dark">${n} ${p} ${m}</span>`);
                        }
                    }
                    return resultado.join("<br>");
                }
            },
            {
                title: "Alias",
                data: "alias",
                orderable: true,
                render: function (data) {
                    if (!data) return '<span class="text-muted fst-italic small">Sin alias</span>';
                    return data.split(/\r\n|\r|\n/).map(a => a.trim()).filter(a => a !== "").join("<br>");
                }
            },
            { title: "Cla_Calle", data: "Cla_Calle", orderable: true, visible: false },
            { title: "Cla_Calle_concat", data: "Cla_Calle_concat", orderable: true, visible: false },
            {
                title: "Calle",
                data: "Calle",
                orderable: true,
                render: function (data) {
                    if (!data) return "";
                    return data.split(/\r\n|\r|\n/).map(a => a.trim()).join(", ");
                }
            },
            {
                title: "Número",
                data: "Num_Casa",
                orderable: true,
                render: function (data) {
                    if (!data) return "";
                    return data.split(/\r\n|\r|\n/).map(a => a.trim()).join("<br>");
                }
            },
            { title: "Cve_col_concat", data: "Cve_col_concat", orderable: true, visible: false },
            { title: "Cve_col", data: "Cve_col", orderable: true, visible: false },
            {
                title: "Colonia",
                data: "Colonia",
                orderable: true,
                render: function (data) {
                    if (!data) return "";
                    return data.split(/\r\n|\r|\n/).map(a => a.trim()).join("<br>");
                }
            },
            { title: "Cve_mun_concat", data: "Cve_mun_concat", orderable: true, visible: false },
            { title: "Cve_mun", data: "Cve_mun", orderable: true, visible: false },
            {
                title: "Municipio",
                data: "Municipio",
                orderable: true,
                render: function (data) {
                    if (!data) return "";
                    return data.split(/\r\n|\r|\n/).map(a => a.trim()).join("<br>");
                }
            },
            { title: "Cve_Edo_concat", data: "Cve_Edo_concat", orderable: true, visible: false },
            { title: "Cve_Edo", data: "Cve_Edo", orderable: true, visible: false },
            {
                title: "Estado",
                data: "Estado",
                orderable: true,
                render: function (data) {
                    if (!data) return "";
                    return data.split(/\r\n|\r|\n/).map(a => a.trim()).join("<br>");
                }
            },
            {
                title: "Fecha Captura",
                data: "Fec_Captu_concat",
                orderable: true,
                render: function (data) {
                    if (!data) return "";
                    let fechas = data.split(/\r\n|\r|\n/).filter(Boolean);
                    fechas = fechas.map(f => {
                        const fecha = new Date(f);
                        return isNaN(fecha) ? f : fecha.toLocaleDateString();
                    });
                    return `<span class="text-muted small">${fechas.join("<br>")}</span>`;
                }
            },
            { title: "CLAVE_PERSO", data: "CLAVE_PERSO", orderable: true, visible: false },
            { title: "IDOBJETIVO", data: "ObjetivoPrioritario", orderable: true, visible: false },
            {
                title: "Acciones",
                data: null,
                orderable: false,
                render: function (data, type, row) {
                    // Diseño de botones compactos y modernos
                    let btnVerFoto = `
                        <button class="btn-action btn-action-view btnVerImagen me-1" data-id="${row.id}" title="Ver Fotografía">
                            <i class="fa fa-camera"></i>
                        </button>`;

                    // Si NO tiene ObjetivoPrioritario
                    if (row.ObjetivoPrioritario === null || row.ObjetivoPrioritario === "" || row.ObjetivoPrioritario === undefined) {
                        return `
                            <div class="d-flex align-items-center justify-content-center">
                                ${btnVerFoto}
                                <button class="btn btn-sm btn-outline-success fw-bold btnAddInfo" data-id="${row.id}" style="border-radius: 6px; font-size: 0.75rem;">
                                    <i class="fa fa-plus me-1"></i> Agregar
                                </button>
                            </div>`;
                    }

                    // Si SÍ tiene ObjetivoPrioritario
                    return `
                        <div class="d-flex align-items-center justify-content-center">
                            ${btnVerFoto}
                            <button class="btn btn-sm btn-outline-primary fw-bold btnIrObjetivo" data-idobjetivo="${row.ObjetivoPrioritario}" style="border-radius: 6px; font-size: 0.75rem;">
                                <i class="fa fa-arrow-right me-1"></i> Ir a Obj. ${row.ObjetivoPrioritario}
                            </button>
                        </div>`;
                }
            }
        ];

        var datos = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));

        var tabla = $('#objetivoDataTable').DataTable({
            destroy: true,
            searching: true,
            responsive: false, // Apagado para evitar conflictos con scrollX
            scrollX: true,
            autoWidth: false,  // Clave para evitar el descuadre de encabezados
            data: datos,
            columns: infoGeneralColumns,
            dom: "<'row mb-3'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6 d-flex justify-content-end'f>>" +
                 "<'row'<'col-sm-12'tr>>" +
                 "<'row mt-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
            language: {
                "sProcessing": "Procesando...",
                "sLengthMenu": "Mostrar _MENU_ registros",
                "sZeroRecords": "No se encontraron resultados",
                "sEmptyTable": "Ningún dato disponible en esta tabla",
                "sInfo": "Mostrando del _START_ al _END_ de _TOTAL_ registros",
                "sInfoEmpty": "Mostrando 0 registros",
                "sInfoFiltered": "(filtrado de _MAX_ totales)",
                "sSearch": "<i class='fa fa-search text-muted me-2'></i>",
                "sSearchPlaceholder": "Buscar en resultados...",
                "oPaginate": {
                    "sFirst": "Primero",
                    "sLast": "Último",
                    "sNext": "Siguiente",
                    "sPrevious": "Anterior"
                }
            }
        });

        // SOLUCIÓN AL DESCUADRE DE ENCABEZADOS EN EL MODAL
        tabla.on('draw.dt', function () {
            setTimeout(function () {
                tabla.columns.adjust();
            }, 50);
        });

        // Al abrir la pestaña de Resultados en el Modal, forzar ajuste de tabla
        $('button[data-bs-target="#resultadosTab"]').on('shown.bs.tab', function (e) {
            tabla.columns.adjust();
        });


        // ==========================================
        // EVENTOS DE BOTONES
        // ==========================================
        $('#objetivoDataTable').on('click', '.btnAddInfo', function () {
            const rowData = tabla.row($(this).closest('tr')).data();
            AddObjetivoInfoGeneral(rowData);
        });

        $('#objetivoDataTable').on('click', '.btnIrObjetivo', function () {
            const idObjetivo = $(this).data('idobjetivo');
            ObjetivoPrioritario(idObjetivo);
        });

        $('#objetivoDataTable').on('click', '.btnVerImagen', function () {
            const rowData = tabla.row($(this).closest('tr')).data();
            cargarFotoPrincipal(rowData);
        });

    });

    // ==========================================
    // FUNCIONES AJAX
    // ==========================================
    function AddObjetivoInfoGeneral(rowData) {
        var idObjetivo = parseInt($("#int_id_objetivo").val(), 10) || null;
        var Datos = Object.assign({}, rowData, { id_objetivo: idObjetivo });

        $.ajax({
            url: "@Url.Action("AddInfoGeneral", "Objetivo")",
            type: 'POST',
            data: JSON.stringify(Datos),
            contentType: 'application/json; charset=utf-8',
            success: function (response) {
                if (response && response.IsSuccess) {
                    var tabTrigger = new bootstrap.Tab(document.querySelector('#fotos-tab'));
                    tabTrigger.show();

                    $.ajax({
                        url: "@Url.Action("FotoPrincipal", "Objetivo")",
                        type: 'POST',
                        data: JSON.stringify(Datos),
                        contentType: 'application/json; charset=utf-8',
                        beforeSend: function () {
                            $('#busquedafotos #galeriaFotos')
                                .empty()
                                .html('<div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div><span class="ms-2 text-muted small">Cargando foto...</span></div>');
                        },
                        success: function (partialHtml) {
                            if (typeof partialHtml === 'object' && partialHtml.IsSuccess === false) {
                                swal({
                                    title: "No Existe Una Fotografía del Objetivo",
                                    text: response.Message,
                                    type: 'info',
                                    confirmButtonText: "Continuar",
                                    confirmButtonColor: "#1d63d3",
                                    closeOnConfirm: true,
                                });
                                return;
                            }
                            $('#busquedafotos #galeriaFotos').html(partialHtml);
                        },
                        error: function () {
                            swal("Error", "No se pudo cargar la foto del detenido.", "error");
                        }
                    });
                } else {
                    swal("Error", response ? response.Message : "Respuesta inesperada", "error");
                }
            },
            error: function () {
                swal("Error", "No se pudo guardar la información.", "error");
            }
        });
    }

    function ObjetivoPrioritario(idObjetivo) {
        if (!idObjetivo) {
            swal("Error", "No se encontró el ID del objetivo.", "error");
            return;
        }
        location.href = '@Url.Action("AddEditObjetivos","Objetivo")?int_id_objetivo=' + idObjetivo;
    }

    function cargarFotoPrincipal(Datos) {
        var tabTrigger = new bootstrap.Tab(document.querySelector('#fotos-tab'));
        tabTrigger.show();

        $.ajax({
            url: "@Url.Action("FotoPrincipal", "Objetivo")",
            type: 'POST',
            data: JSON.stringify(Datos),
            contentType: 'application/json; charset=utf-8',
            beforeSend: function () {
                $('#busquedafotos #galeriaFotos')
                    .empty()
                    .html('<div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div><span class="ms-2 text-muted small">Cargando foto...</span></div>');
            },
            success: function (partialHtml) {
                if (typeof partialHtml === 'object' && partialHtml.IsSuccess === false) {
                    swal({
                        title: "No Existe Una Fotografía del Objetivo",
                        text: partialHtml.Message || "",
                        type: 'info',
                        confirmButtonText: "Continuar",
                        confirmButtonColor: "#1d63d3",
                        closeOnConfirm: true
                    });
                    return;
                }
                $('#busquedafotos #galeriaFotos').html(partialHtml);
            },
            error: function () {
                swal("Error", "No se pudo cargar la foto del detenido.", "error");
            }
        });
    }
</script>