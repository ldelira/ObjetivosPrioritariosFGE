<div class="row align-items-end">
    <div class="col-md-3">
        <label class="control-label">Estado:</label>
        <select class="form-control" id="estadoObjetivoGrupo">
            <option value="1" id="1" @((bool)ViewBag.Actives ? "selected" : "")>Activo</option>
            <option value="0" id="0" @(!(bool)ViewBag.Actives ? "selected" : "")>Inactivo</option>
        </select>
    </div>

    <div class="col-md-9" style="text-align:right;">
        <button type="button" class="btn btn-primary" onclick="AddObjetivoGrupoModal()">
            <i class="fa fa-plus"></i> Agregar grupo
        </button>
    </div>
</div>

<br />

<div class="row">
    <div class="col-md-12">
        <table id="objetivoGrupoDataTable" class="dataTable table table-striped table-hover" style="width:100%"></table>
    </div>
</div>

<script type="text/javascript">

    $(document).ready(function () {
        FillGridObjetivoGrupo();
    });

    $("#estadoObjetivoGrupo").off("change").on("change", function () {
        var valor = $("#estadoObjetivoGrupo").val();
        refreshGrupoList(valor === "1");
    });

    var objetivoGrupoColumns = [
        {
            title: "Id",
            data: "id_objetivo_grupo",
            orderable: true,
            className: "dt-nowrap"
        },
        {
            title: "Grupo",
            data: "nvarchar_alias",
            orderable: true,
            render: function (data, type, row) {
                var alias = data || "";
                var grupo = row.nvarchar_grupo || "";

                if (grupo) {
                    return `<strong>${alias}</strong><br><small>${grupo}</small>`;
                }

                return alias;
            }
        },
        {
            title: "Puesto / nivel",
            data: "nivel_organizacion",
            orderable: true,
            className: "dt-nowrap",
            render: function (data) {
                if (!data || data === "Por definir") {
                    return `<span class="op-badge op-badge-muted">Por definir</span>`;
                }

                return `<span class="op-badge op-badge-success">${data}</span>`;
            }
        },
        {
            title: "Función",
            data: "funcion_grupo",
            orderable: true,
            render: function (data) {
                return data || "Sin información";
            }
        },
        {
            title: "Fecha ingreso",
            data: "fecha_ingreso",
            orderable: true,
            className: "dt-nowrap",
            visible: false
        },
        {
            title: "Fecha salida",
            data: "fecha_salida",
            orderable: true,
            className: "dt-nowrap",
            visible: false
        },
        {
            title: "Observaciones",
            data: "observaciones",
            orderable: true,
            render: function (data) {
                return data || "Sin observaciones";
            }
        },
        {
            title: "Acciones",
            data: "id_objetivo_grupo",
            orderable: false,
            searchable: false,
            className: "dt-nowrap text-center",
            render: function (data, type, full, meta) {

                if ('@ViewBag.Actives'.toUpperCase() === 'TRUE') {
                    return `
                        <div class="dt-actions">
                            <button type="button"
                                    class="btn btn-sm btn-primary"
                                    onclick="EditObjetivoGrupo(${data})"
                                    title="Editar grupo del objetivo"
                                    aria-label="Editar grupo del objetivo">
                                <i class="fa fa-edit"></i>
                            </button>

                            <button type="button"
                                    class="btn btn-sm btn-danger"
                                    onclick="DisableObjetivoGrupo(${data})"
                                    title="Desactivar grupo del objetivo"
                                    aria-label="Desactivar grupo del objetivo">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                    `;
                }

                return `
                    <div class="dt-actions">
                        <button type="button"
                                class="btn btn-sm btn-success"
                                onclick="ActivateObjetivoGrupo(${data})"
                                title="Reactivar grupo del objetivo"
                                aria-label="Reactivar grupo del objetivo">
                            <i class="fa fa-power-off"></i>
                        </button>
                    </div>
                `;
            }
        }
    ];

    function FillGridObjetivoGrupo() {
        $.ajax({
            type: "POST",
            url: '@Url.Action("FillObjetivoGrupoList", "Objetivo")',
            data: {
                active: @Json.Encode(ViewBag.Actives),
                int_id_objetivo: $("#int_id_objetivo").val()
            },
            success: function (data) {

                if ($.fn.dataTable.isDataTable("#objetivoGrupoDataTable")) {
                    $("#objetivoGrupoDataTable").DataTable().clear().destroy();
                    $("#objetivoGrupoDataTable").empty();
                }

                $("#objetivoGrupoDataTable").DataTable({
                    destroy: true,
                    searching: true,
                    responsive: false,
                    scrollX: true,
                    scrollCollapse: true,
                    autoWidth: false,
                    data: data,
                    columns: objetivoGrupoColumns,
                    order: [[0, "desc"]],
                    language: {
                        sProcessing: "Procesando...",
                        sLengthMenu: "Mostrar _MENU_ registros",
                        sZeroRecords: "No se encontraron resultados",
                        sEmptyTable: "Ningún dato disponible en esta tabla",
                        sInfo: "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                        sInfoEmpty: "Mostrando registros del 0 al 0 de un total de 0 registros",
                        sInfoFiltered: "(filtrado de un total de _MAX_ registros)",
                        sSearch: "Buscar:",
                        sLoadingRecords: "Cargando...",
                        oPaginate: {
                            sFirst: "Primero",
                            sLast: "Último",
                            sNext: "Siguiente",
                            sPrevious: "Anterior"
                        }
                    },
                    initComplete: function () {
                        setTimeout(function () {
                            $("#objetivoGrupoDataTable").DataTable().columns.adjust();
                        }, 150);
                    }
                });
            },
            error: function (xhr) {
                console.log(xhr.responseText);
                swal("Error", "Ocurrió un error al cargar los grupos del objetivo.", "error");
            }
        });
    }

    function DisableObjetivoGrupo(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("DesactivarObjetivoGrupo", "Objetivo")',
            data: { int_id_objetivo_grupo: id },
            success: function (data) {
                if (data.IsSuccess) {
                    swal({
                        title: "",
                        text: data.Message,
                        type: "success",
                        confirmButtonText: "Continuar",
                        closeOnConfirm: true
                    }, function () {
                        swal.close();
                        refreshGrupoList(true);
                    });
                } else {
                    swal({
                        title: "Error",
                        text: data.Message || "No tienes permisos para esta acción. Contacta al administrador.",
                        type: "error",
                        confirmButtonText: "Continuar",
                        closeOnConfirm: true
                    });
                }
            },
            error: function (xhr) {
                console.log(xhr.responseText);
                swal("Error", "Ocurrió un error al desactivar el grupo del objetivo.", "error");
            }
        });
    }

    function ActivateObjetivoGrupo(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("ReactivarObjetivoGrupo", "Objetivo")',
            data: { int_id_objetivo_grupo: id },
            success: function (data) {
                if (data.IsSuccess) {
                    swal({
                        title: "",
                        text: data.Message,
                        type: "success",
                        confirmButtonText: "Continuar",
                        closeOnConfirm: true
                    }, function () {
                        swal.close();
                        refreshGrupoList(false);
                    });
                } else {
                    swal({
                        title: "Error",
                        text: data.Message || "No tienes permisos para esta acción. Contacta al administrador.",
                        type: "error",
                        confirmButtonText: "Continuar",
                        closeOnConfirm: true
                    });
                }
            },
            error: function (xhr) {
                console.log(xhr.responseText);
                swal("Error", "Ocurrió un error al activar el grupo del objetivo.", "error");
            }
        });
    }

</script>
