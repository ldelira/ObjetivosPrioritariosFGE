@model List<Objetivos_Prioritarios.Models.tb_Objetivo>

<div class="main-panel">
    <div class="content-wrapper">

        <div class="op-page-header">
            <div>
                @*<h2>OBJETIVOS PRIORITARIOS</h2>*@
                <p>Listado de objetivos dados de alta en el sistema</p>
            </div>

            @*<button type="button" class="btn btn-primary" onclick="AddObjetivo2()">
                <i class="fa fa-plus"></i> Agregar objetivo prioritario
            </button>*@
        </div>

        <div class="op-card op-card-flat">

            <div class="row align-items-end">
                <div class="col-md-3">
                    <label class="control-label">Estado</label>
                    <select class="form-control" id="estadoGeneral">
                        <option value="1" @((bool)ViewBag.Actives ? "selected" : "")>Activo</option>
                        <option value="0" @(!(bool)ViewBag.Actives ? "selected" : "")>Inactivo</option>
                    </select>
                </div>

                <div class="col-md-9 d-flex justify-content-end">
                    <button type="button" class="btn btn-primary" onclick="AddObjetivo2()">
                        <i class="fa fa-plus"></i> Agregar objetivo prioritario
                    </button>
                </div>
            </div>

            <br />

            <div class="op-table-container">
                <table id="generalDataTable" class="table table-striped table-hover" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Nombres</th>
                            <th>Alias</th>
                            <th>Grupo</th>
                            <th>Fecha nacimiento</th>
                            <th>Fotografía</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

        </div>

    </div>
</div>

<script>
    $(document).ready(function () {
        FillGrid($("#estadoGeneral").val() === "1");
    });

    $("#estadoGeneral").off("change").on("change", function () {
        var activo = $("#estadoGeneral").val() === "1";
        FillGrid(activo);
    });

    function escapeHtml(text) {
        if (text === null || text === undefined) return "";

        return text.toString()
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    function limitarTexto(texto, max) {
        if (!texto) return "";

        texto = texto.toString();

        if (texto.length <= max) {
            return `<span>${escapeHtml(texto)}</span>`;
        }

        var corto = texto.substring(0, max) + "...";

        return `
            <span title="${escapeHtml(texto)}">
                ${escapeHtml(corto)}
            </span>
        `;
    }

    function badgeFoto(valor) {
        if (valor && valor.toString().toUpperCase() === "CON FOTO") {
            return `<span class="op-badge op-badge-success">CON FOTO</span>`;
        }

        return `<span class="op-badge op-badge-muted">SIN FOTO</span>`;
    }

    function badgeGrupo(valor) {
        if (!valor || valor.toString().toUpperCase() === "SIN GRUPO") {
            return `<span class="op-badge op-badge-muted">SIN GRUPO</span>`;
        }

        return `<span class="op-badge op-badge-success">${escapeHtml(valor)}</span>`;
    }

    function formatearFechaMx(data, type) {
        if (!data) return "";

        var fecha = null;

        // Formato MVC: /Date(1719792000000)/
        if (typeof data === "string" && data.indexOf("/Date(") === 0) {
            var timestamp = parseInt(data.replace("/Date(", "").replace(")/", ""));
            fecha = new Date(timestamp);
        }
        // Si ya viene como fecha ISO o texto fecha
        else {
            fecha = new Date(data);
        }

        // Si no se pudo convertir, regresar el dato original
        if (isNaN(fecha.getTime())) {
            return data;
        }

        // Para que DataTables ordene correctamente
        if (type === "sort" || type === "type") {
            return fecha.getTime();
        }

        var dia = ("0" + fecha.getDate()).slice(-2);
        var mes = ("0" + (fecha.getMonth() + 1)).slice(-2);
        var anio = fecha.getFullYear();

        return dia + "-" + mes + "-" + anio;
    }


    var columnFichaInfo = [
        {
            title: "Id",
            data: "int_id_objetivo",
            orderable: true,
            className: "dt-nowrap"
        },
        {
            title: "Nombres",
            data: "Nombres",
            orderable: true,
            className: "dt-text-main",
            render: function (data) {
                return limitarTexto(data, 120);
            }
        },
        {
            title: "Alias",
            data: "Aliases",
            orderable: true,
            className: "dt-text-small",
            render: function (data) {
                return limitarTexto(data, 45);
            }
        },
        {
            title: "Grupo",
            data: "GruposDelictivos",
            orderable: true,
            className: "dt-nowrap",
            render: function (data) {
                return badgeGrupo(data);
            }
        },
        {
            title: "Fecha nacimiento",
            data: "FechaNacimiento",
            orderable: true,
            className: "dt-nowrap",
            render: function (data, type, row) {
                return formatearFechaMx(data, type);
            }
        },
        {
            title: "Fotografía",
            data: "TieneFoto",
            orderable: true,
            className: "dt-nowrap",
            render: function (data) {
                return badgeFoto(data);
            }
        },
        {
            title: "Acciones",
            data: "int_id_objetivo",
            orderable: false,
            searchable: false,
            className: "dt-nowrap text-center",
            render: function (data, type, full, meta) {

                var activo = $("#estadoGeneral").val() === "1";

                if (activo) {
                    return `
        <div class="dt-actions">

            <button type="button"
                    class="btn btn-sm btn-primary"
                    onclick="EditObjetivo(${data})"
                    title="Abrir ficha del objetivo"
                    aria-label="Abrir ficha del objetivo">
                <i class="fa fa-eye"></i>
            </button>

            <button type="button"
                    class="btn btn-sm btn-danger"
                    onclick="DisableObjetivo(${data})"
                    title="Desactivar objetivo"
                    aria-label="Desactivar objetivo">
                <i class="fa fa-trash"></i>
            </button>

        </div>
    `;
                }

                return `
    <div class="dt-actions">

        <button type="button"
                class="btn btn-sm btn-success"
                onclick="ActivateObjetivo(${data})"
                title="Reactivar objetivo"
                aria-label="Reactivar objetivo">
            <i class="fa fa-power-off"></i>
        </button>

    </div>
`;
            }
        }
    ];

    function FillGrid(active) {

        $.ajax({
            type: "POST",
            url: '@Url.Action("FillObjetivosList", "Objetivo")',
            data: {
                active: active
            },
            success: function (data) {

                if ($.fn.dataTable.isDataTable("#generalDataTable")) {
                    $("#generalDataTable").DataTable().clear().destroy();
                    $("#generalDataTable tbody").empty();
                }

                $("#generalDataTable").DataTable({
                    destroy: true,
                    searching: true,
                    responsive: false,
                    scrollX: true,
                    scrollCollapse: true,
                    autoWidth: false,
                    processing: true,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    data: data,
                    columns: columnFichaInfo,
                    order: [[0, "desc"]],
                    language: {
                        sProcessing: "Procesando...",
                        sLengthMenu: "Mostrar _MENU_ registros",
                        sZeroRecords: "No se encontraron resultados",
                        sEmptyTable: "Ningún dato disponible en esta tabla",
                        sInfo: "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                        sInfoEmpty: "Mostrando registros del 0 al 0 de un total de 0 registros",
                        sInfoFiltered: "(filtrado de un total de _MAX_ registros)",
                        sSearch: "Buscar:",
                        sLoadingRecords: "Cargando...",
                        oPaginate: {
                            sFirst: "Primero",
                            sLast: "Último",
                            sNext: "Siguiente",
                            sPrevious: "Anterior"
                        },
                        oAria: {
                            sSortAscending: ": Activar para ordenar la columna de manera ascendente",
                            sSortDescending: ": Activar para ordenar la columna de manera descendente"
                        }
                    },
                    initComplete: function () {
                        setTimeout(function () {
                            $("#generalDataTable").DataTable().columns.adjust();
                        }, 150);
                    }
                });
            },
            error: function (xhr) {
                console.log(xhr.responseText);
                swal("Error", "Ocurrió un error al cargar los objetivos.", "error");
            }
        });
    }

    function AddObjetivo2() {
        swal({
            title: "¿Estás seguro?",
            text: "Se generará un nuevo objetivo prioritario.",
            type: "warning",
            showCancelButton: true,
            confirmButtonText: "Sí",
            cancelButtonText: "No",
            closeOnConfirm: false,
            closeOnCancel: true
        }, function (isConfirm) {

            if (!isConfirm) {
                return;
            }

            $.ajax({
                type: "POST",
                url: "@Url.Action("CrearObjetivoFicha", "FichaObjetivo")",
                success: function (resp) {

                    if (resp.IsSuccess) {
                        window.location.href = resp.RedirectUrl;
                    } else {
                        swal("Error", resp.Message, "error");
                    }
                },
                error: function (xhr) {
                    console.log(xhr.responseText);
                    swal("Error", "Ocurrió un error al crear el objetivo.", "error");
                }
            });
        });
    }

    function EditObjetivo(int_id_objetivo) {
        location.href = '@Url.Action("EditFichaObjetivos", "FichaObjetivo")?int_id_objetivo=' + int_id_objetivo;
    }

    function DisableObjetivo(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("DisableObjetivo", "Objetivo")',
            data: {
                int_id_objetivo: id
            },
            success: function (data) {
                if (data.IsSuccess) {
                    swal({
                        title: "",
                        text: data.Message,
                        type: "success",
                        confirmButtonText: "Continuar",
                        closeOnConfirm: true
                    }, function () {
                        swal.close();
                        FillGrid($("#estadoGeneral").val() === "1");
                    });
                } else {
                    swal({
                        title: "Error",
                        text: "No tienes permisos para esta acción. Contacta al administrador.",
                        type: "error",
                        confirmButtonText: "Continuar",
                        closeOnConfirm: true
                    }, function () {
                        window.location.href = '@Url.Action("Index", "Objetivo")';
                    });
                }
            },
            error: function (xhr) {
                console.log(xhr.responseText);
                swal("Error", "Ocurrió un error al desactivar el objetivo.", "error");
            }
        });
    }

    function ActivateObjetivo(id) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("ActivateObjetivo", "Objetivo")',
            data: {
                int_id_objetivo: id
            },
            success: function (data) {
                if (data.IsSuccess) {
                    swal({
                        title: "",
                        text: data.Message,
                        type: "success",
                        confirmButtonText: "Continuar",
                        closeOnConfirm: true
                    }, function () {
                        swal.close();
                        FillGrid($("#estadoGeneral").val() === "1");
                    });
                } else {
                    swal({
                        title: "Error",
                        text: "No tienes permisos para esta acción. Contacta al administrador.",
                        type: "error",
                        confirmButtonText: "Continuar",
                        closeOnConfirm: true
                    }, function () {
                        window.location.href = '@Url.Action("Index", "Objetivo")';
                    });
                }
            },
            error: function (xhr) {
                console.log(xhr.responseText);
                swal("Error", "Ocurrió un error al activar el objetivo.", "error");
            }
        });
    }
</script>