@using Objetivos_Prioritarios.Models

@{
    ViewBag.Title = "Personas de Interés";

    tb_Usuarios usuario = Session["User"] as tb_Usuarios;

    string nombreUsuario =
       usuario != null
           ? usuario.nvarchar_no_interno.ToUpper()
           : "";
}


@if (nombreUsuario == "LDELIRA" || nombreUsuario == "ESALAS")
{
    <div class="card">
        <div class="card-body">

            <h5 class="card-title">
                Tiempo de espera de búsqueda
            </h5>

            <p>
                Tiempo actual:
                <strong id="lblTiempoBusqueda">
                    @ViewBag.TiempoEsperaBusqueda
                </strong>
                segundos
            </p>

            <div style="display:flex;gap:10px;align-items:center;max-width:400px;">

                <input type="number"
                       id="txtTiempoBusqueda"
                       class="form-control"
                       min="0"
                       max="300"
                       value="@ViewBag.TiempoEsperaBusqueda" />

                <button type="button"
                        id="btnActualizarTiempoBusqueda"
                        class="btn btn-primary">
                    Actualizar
                </button>

            </div>

            @Html.AntiForgeryToken()

        </div>
    </div>
}

<div class="op-page">

    <div class="op-page-title">
        <h2>Personas de Interés</h2>
        <div class="op-breadcrumb">
            Personas de Interés / Listado general
        </div>
    </div>

    <div class="op-card">

        <div class="op-section-header" style="text-align:right">
            @*<div>
                    <h3>Registro de personas de interés</h3>
                    <p>Consulta, registra o actualiza personas con información parcial, fotografía o huellas.</p>
                </div>*@

            <a class="btn btn-primary" href="@Url.Action("AddEditPersonaInteres", "PersonasInteres")">
                <i class="fa fa-plus"></i> Registrar persona
            </a>
        </div>

        <table id="personasInteresDataTable" class="table table-striped" style="width:100%">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Persona</th>
                    <th>Edad aprox.</th>
                    <th>Sexo</th>
                    <th>Estatura</th>
                    <th>Observaciones</th>
                    <th>Fecha registro</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>

    </div>

</div>

<script>
    $(document).ready(function () {
        FillPersonasInteres();
    });

    function FillPersonasInteres() {

        $.ajax({
            type: "POST",
            url: "@Url.Action("FillPersonasInteresList", "PersonasInteres")",
            success: function (data) {

                if ($.fn.DataTable.isDataTable("#personasInteresDataTable")) {
                    $("#personasInteresDataTable").DataTable().clear().destroy();
                    $("#personasInteresDataTable tbody").empty();
                }

                $("#personasInteresDataTable").DataTable({
                    destroy: true,
                    searching: true,
                    responsive: false,
                    scrollX: true,
                    autoWidth: false,
                    data: data,
                    columns: [
                        {
                            title: "ID",
                            data: "idPersona",
                            width: "70px"
                        },
                        {
                            title: "Persona",
                            data: "nombreMostrar",
                            render: function (data, type, row) {
                                if (!data || data.trim() === "") {
                                    return `<strong>Persona sin identificar</strong>`;
                                }

                                if (data === "Persona sin identificar") {
                                    return `<strong class="text-muted">${data}</strong>`;
                                }

                                return `<strong>${data}</strong>`;
                            }
                        },
                        {
                            title: "Edad aprox.",
                            data: "edadAproximada",
                            defaultContent: "Sin edad"
                        },
                        {
                            title: "Sexo",
                            data: "sexo",
                            defaultContent: "Sin dato"
                        },
                        {
                            title: "Estatura",
                            data: "estatura",
                            defaultContent: "Sin dato"
                        },
                        {
                            title: "Observaciones",
                            data: "observacionesCorta",
                            defaultContent: ""
                        },
                        {
                            title: "Fecha registro",
                            data: "fechaRegistro",
                            defaultContent: ""
                        },
                        {
                            title: "Acciones",
                            data: "idPersona",
                            orderable: false,
                            searchable: false,
                            className: "text-center dt-nowrap",
                            render: function (data) {
                                return `
                                    <div class="dt-actions">
                                        <button type="button"
                                                class="btn btn-sm btn-primary"
                                                onclick="abrirPersonaInteres(${data})"
                                                title="Abrir ficha">
                                            <i class="fa fa-eye"></i>
                                        </button>
                                    </div>
                                `;
                            }
                        }
                    ],
                    language: {
                        sProcessing: "Procesando...",
                        sLengthMenu: "Mostrar _MENU_ registros",
                        sZeroRecords: "No se encontraron resultados",
                        sEmptyTable: "Ningún dato disponible en esta tabla",
                        sInfo: "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                        sInfoEmpty: "Mostrando registros del 0 al 0 de un total de 0 registros",
                        sInfoFiltered: "(filtrado de un total de _MAX_ registros)",
                        sSearch: "Buscar:",
                        sLoadingRecords: "Cargando...",
                        oPaginate: {
                            sFirst: "Primero",
                            sLast: "Último",
                            sNext: "Siguiente",
                            sPrevious: "Anterior"
                        }
                    }
                });
            },
            error: function (xhr) {
                console.log(xhr.responseText);
                swal("Error", "Ocurrió un error al cargar las personas de interés.", "error");
            }
        });
    }

    function abrirPersonaInteres(idPersona) {
        window.location.href = "@Url.Action("AddEditPersonaInteres", "PersonasInteres")?idPersona=" + idPersona;
    }






    $("#btnActualizarTiempoBusqueda").click(function () {

        var valor =
            parseInt(
                $("#txtTiempoBusqueda").val()
            );

        if (
            isNaN(valor) ||
            valor < 0 ||
            valor > 300
        ) {
            Swal.fire(
                "Valor incorrecto",
                "Capture un valor entre 0 y 300 segundos.",
                "warning"
            );

            return;
        }

        $.ajax({
            url: '@Url.Action("ActualizarTiempoEsperaBusqueda", "PersonasInteres")',
            type: 'POST',
            data: {
                valor: valor
            },
            success: function (respuesta) {

                if (!respuesta.success) {
                    alert(respuesta.message);
                    return;
                }

                $("#lblTiempoBusqueda")
                    .text(
                        respuesta.valor
                    );

                alert(
                    "El tiempo de espera ahora es de " +
                    respuesta.valor +
                    " segundos."
                );
            },
            error: function () {

                alert(
                    "No fue posible actualizar el tiempo."
                );
            }
        });
    });


</script>