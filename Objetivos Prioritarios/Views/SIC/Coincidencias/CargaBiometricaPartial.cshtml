@model Objetivos_Prioritarios.Models.Extends.BusquedaCoincidenciasViewModel

<section class="sic-biometria-card">

    <div class="sic-card-encabezado sic-biometria-encabezado">

        <div class="sic-card-icono sic-card-icono-biometria">
            <i class="fa fa-id-card-o">
                <img width="90%" src="~/images/icons8-fingerprint-50.png" />
            </i>
            
            
        </div>

        <div>
            <h2>Biometría</h2>

            <p>
                Agregue una fotografía, una o varias huellas,
                o combine ambas evidencias para reforzar la búsqueda.
            </p>
        </div>

        

    </div>


    <div class="sic-biometria-grid">


        <!-- ============================================================
             FOTOGRAFÍA
             ============================================================ -->

        <article class="sic-biometrico-tile"
                 data-tipo-biometrico="fotografia">

            @Html.TextBoxFor(
                     model => model.Fotografia,
                     new
                     {
                         type = "file",
                         id = "Fotografia",
                         @class = "sic-file-input js-biometrico-input",
                         accept = ".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp",
                         data_tipo = "fotografia",
                         data_preview = "previewFotografia",
                         data_vacio = "estadoVacioFotografia",
                         data_quitar = "btnQuitarFotografia"
                     }
                 )


            <label for="Fotografia"
                   id="dropzoneFotografia"
                   class="sic-biometrico-preview-zona sic-dropzone"
                   data-input-id="Fotografia">

                <div id="estadoVacioFotografia"
                     class="sic-biometrico-vacio">

                    <i class="fa fa-camera"></i>

                    <strong>
                        Fotografía
                    </strong>

                    <span>
                        Seleccione o arrastre
                    </span>

                </div>


                <img id="previewFotografia"
                     class="sic-biometrico-preview sic-biometrico-preview-foto"
                     src=""
                     alt="Vista previa de la fotografía"
                     style="display:none;" />

            </label>


            <div class="sic-biometrico-informacion">

                <div class="sic-biometrico-titulo-fila">

                    <div>

                        <strong>
                            Fotografía
                        </strong>

                        <span>
                            Rostro frontal y claramente visible
                        </span>

                    </div>

                    <span class="sic-biometrico-tipo">
                        Facial
                    </span>

                </div>


                <small>
                    JPG, PNG o WEBP · Máximo 10 MB
                </small>


                <div class="sic-biometrico-acciones">

                    <button type="button"
                            class="sic-btn-biometrico sic-btn-seleccionar js-seleccionar-biometrico"
                            data-input-id="Fotografia">

                        <i class="fa fa-folder-open"></i>

                        <span>
                            Seleccionar
                        </span>

                    </button>


                    <button type="button"
                            id="btnQuitarFotografia"
                            class="sic-btn-biometrico sic-btn-quitar js-quitar-biometrico"
                            data-input-id="Fotografia"
                            disabled>

                        <i class="fa fa-trash"></i>

                        <span>
                            Quitar
                        </span>

                    </button>

                </div>

            </div>

        </article>



        <!-- ============================================================
             HUELLAS MÚLTIPLES
             ============================================================ -->

        <article id="tileHuellas"
                 class="sic-biometrico-tile sic-biometrico-tile-huellas"
                 data-tipo-biometrico="huella">


            <!--
                IMPORTANTE:

                name="Huellas"

                coincide exactamente con:

                List<HttpPostedFileBase> Huellas

                del ViewModel.
            -->

            <input type="file"
                   id="Huellas"
                   name="Huellas"
                   class="sic-file-input js-huellas-input"
                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                   multiple />


            <!-- ZONA PARA AGREGAR HUELLAS -->

            <div id="dropzoneHuellas"
                 class="sic-huellas-dropzone">

                <div class="sic-biometrico-vacio">

                    <i class="fa fa-hand-pointer-o"></i>

                    <strong>
                        Huellas digitales
                    </strong>

                    <span>
                        Seleccione o arrastre
                    </span>

                </div>

            </div>


            <!-- INFORMACIÓN -->

            <div class="sic-biometrico-informacion">

                <div class="sic-biometrico-titulo-fila">

                    <div>

                        <strong>
                            Huellas digitales
                        </strong>

                        <span>
                            Puede agregar hasta 10 imágenes de huellas
                        </span>

                    </div>


                    <span class="sic-biometrico-tipo">
                        Dactilar
                    </span>

                </div>


                <div class="sic-huellas-info-linea">

                    <small>
                        JPG, PNG o WEBP · Máximo 10 MB cada una
                    </small>


                    <strong id="contadorHuellas"
                            class="sic-huellas-contador">

                        0 / 10

                    </strong>

                </div>


                <div class="sic-biometrico-acciones">

                    <button type="button"
                            id="btnAgregarHuellas"
                            class="sic-btn-biometrico sic-btn-seleccionar js-seleccionar-huellas">

                        <i class="fa fa-folder-open"></i>

                        <span>
                            Agregar huellas
                        </span>

                    </button>


                    <button type="button"
                            id="btnQuitarTodasHuellas"
                            class="sic-btn-biometrico sic-btn-quitar js-quitar-todas-huellas"
                            disabled>

                        <i class="fa fa-trash"></i>

                        <span>
                            Quitar todas
                        </span>

                    </button>

                </div>

            </div>


            <!-- ========================================================
                 PREVIEWS DE LAS HUELLAS SELECCIONADAS
                 ======================================================== -->

            <div id="contenedorHuellasSeleccionadas"
                 class="sic-huellas-seleccionadas"
                 style="display:none;">
            </div>

        </article>

    </div>

</section>