@model Objetivos_Prioritarios.Models.Extends.DetalleFGEADetenidoApiDto

@using Objetivos_Prioritarios.Models
@using System
@using System.Globalization
@using System.Linq
@using System.Collections.Generic

@{
    Objetivos_Prioritarios.Models.Extends.CoincidenciaResultadoViewModel coincidencia =
    ViewBag.Coincidencia as Objetivos_Prioritarios.Models.Extends.CoincidenciaResultadoViewModel;


    bool tieneMandamientos =
    coincidencia != null &&
    coincidencia.TieneAvisoMandamientos &&
    coincidencia.MandamientosJudiciales != null &&
    coincidencia.MandamientosJudiciales.Any();

    int totalMandamientos =
        tieneMandamientos
            ? coincidencia.MandamientosJudiciales.Count
            : 0;

    string imagenNoDisponible =
Url.Content("~/Content/imagenes/Nodisponible.jpg");

    string fotoUrl =
        imagenNoDisponible;

    if (
        coincidencia != null &&
        !string.IsNullOrWhiteSpace(coincidencia.FotoUrl)
    )
    {
        if (
            coincidencia.FotoUrl.StartsWith(
                "http",
                StringComparison.OrdinalIgnoreCase
            )
        )
        {
            fotoUrl =
                coincidencia.FotoUrl;
        }
        else
        {
            fotoUrl =
                Url.Content(
                    coincidencia.FotoUrl
                );
        }
    }


    /*
     * ============================================================
     * DATOS PRINCIPALES
     * ============================================================
     */

    string nombre =
        string.IsNullOrWhiteSpace(Model.NombreCompleto)
            ? "SIN INFORMACIÓN"
            : Model.NombreCompleto.Trim();

    string alias =
        string.IsNullOrWhiteSpace(Model.AliasPrincipal)
            ? "SIN INFORMACIÓN"
            : Model.AliasPrincipal.Trim();

    string sexo =
        string.IsNullOrWhiteSpace(Model.Sexo)
            ? "SIN INFORMACIÓN"
            : Model.Sexo.Trim();

    string edad =
        Model.Edad.HasValue &&
        Model.Edad.Value > 0
            ? Model.Edad.Value + " años"
            : "SIN INFORMACIÓN";

    string filiacion =
        string.IsNullOrWhiteSpace(Model.NumeroFiliacion)
            ? "SIN INFORMACIÓN"
            : Model.NumeroFiliacion.Trim();

    string fechaFiliacion =
        Model.FechaFiliacion.HasValue
            ? Model.FechaFiliacion.Value.ToString("dd/MM/yyyy")
            : "SIN INFORMACIÓN";


    /*
  * ============================================================
  * EVIDENCIA PRINCIPAL
  * ============================================================
  *
  * Determina cuál fue la evidencia individual con el
  * porcentaje más alto.
  *
  * En caso de empate damos prioridad a biometría:
  *
  * Huella > Fotografía > Alias > Nombre
  * ============================================================
  */

    decimal porcentajeEvidenciaPrincipal = 0;

    string evidenciaTexto =
        "Coincidencia encontrada";

    string evidenciaIcono =
        "fa-check-circle";


    if (coincidencia != null)
    {
        decimal porcentajeNombre =
            coincidencia.PorcentajeNombre;

        decimal porcentajeAlias =
            coincidencia.PorcentajeAlias;

        decimal porcentajeFoto =
            coincidencia.PorcentajeFoto;

        decimal porcentajeHuella =
            coincidencia.PorcentajeHuella;


        /*
         * NOMBRE
         */
        if (porcentajeNombre > 0)
        {
            porcentajeEvidenciaPrincipal =
                porcentajeNombre;

            evidenciaTexto =
                "Coincidencia por nombre";

            evidenciaIcono =
                "fa-user";
        }


        /*
         * ALIAS
         */
        if (
            porcentajeAlias > 0 &&
            porcentajeAlias > porcentajeEvidenciaPrincipal
        )
        {
            porcentajeEvidenciaPrincipal =
                porcentajeAlias;

            evidenciaTexto =
                "Coincidencia por alias";

            evidenciaIcono =
                "fa-user-secret";
        }


        /*
         * TEXTO
         *
         * Solamente se utiliza como respaldo si por alguna razón
         * la API trae PorcentajeTexto pero no separó Nombre/Alias.
         */
        if (
            porcentajeEvidenciaPrincipal <= 0 &&
            coincidencia.PorcentajeTexto > 0
        )
        {
            porcentajeEvidenciaPrincipal =
                coincidencia.PorcentajeTexto;

            evidenciaTexto =
                "Coincidencia textual";

            evidenciaIcono =
                "fa-font";
        }


        /*
         * FOTOGRAFÍA
         *
         * >= porque si empata con texto/nombre/alias,
         * preferimos mostrar la evidencia biométrica.
         */
        if (
            porcentajeFoto > 0 &&
            porcentajeFoto >= porcentajeEvidenciaPrincipal
        )
        {
            porcentajeEvidenciaPrincipal =
                porcentajeFoto;

            evidenciaTexto =
                "Comparación de fotografía";

            evidenciaIcono =
                "fa-camera";
        }


        /*
         * HUELLA
         *
         * >= hace que huella gane también un empate
         * contra fotografía.
         */
        if (
            porcentajeHuella > 0 &&
            porcentajeHuella >= porcentajeEvidenciaPrincipal
        )
        {
            porcentajeEvidenciaPrincipal =
                porcentajeHuella;

            evidenciaTexto =
                "Comparación de huella";

            evidenciaIcono =
                "fa-hand-pointer-o";
        }
    }


    /*
     * ============================================================
     * SECCIONES DISPONIBLES
     * ============================================================
     */

    bool tieneInformacionFiliacion =
Model.ClavePerso > 0 ||
!string.IsNullOrWhiteSpace(Model.NumeroFicha) ||
!string.IsNullOrWhiteSpace(Model.NumeroFiliacion) ||
Model.FechaNacimiento.HasValue ||
Model.FechaFiliacion.HasValue ||
!string.IsNullOrWhiteSpace(Model.Estatura) ||
!string.IsNullOrWhiteSpace(Model.Peso) ||
!string.IsNullOrWhiteSpace(Model.Telefono) ||
!string.IsNullOrWhiteSpace(Model.Observaciones);

    bool tieneNombres =
        Model.Nombres != null &&
        Model.Nombres.Any();

    bool tieneAlias =
        Model.Alias != null &&
        Model.Alias.Any();

    bool tieneNombresAlias =
        tieneNombres ||
        tieneAlias;

    bool tieneDomicilioBase =
        !string.IsNullOrWhiteSpace(Model.Calle) ||
        !string.IsNullOrWhiteSpace(Model.NumeroCasa) ||
        !string.IsNullOrWhiteSpace(Model.Colonia) ||
        !string.IsNullOrWhiteSpace(Model.CodigoPostal) ||
        !string.IsNullOrWhiteSpace(Model.Municipio);

    bool tieneDomicilios =
        Model.Domicilios != null &&
        Model.Domicilios.Any();

    bool tieneSeccionDomicilios =
        tieneDomicilioBase ||
        tieneDomicilios;

    bool tieneIngresos =
        Model.Ingresos != null &&
        Model.Ingresos.Any();

    bool tieneDelitos =
        Model.Delitos != null &&
        Model.Delitos.Any();

    bool tieneTrabajo =
        !string.IsNullOrWhiteSpace(Model.LugarTrabajo) ||
        !string.IsNullOrWhiteSpace(Model.UbicacionTrabajo) ||
        !string.IsNullOrWhiteSpace(Model.TelefonoTrabajo);


    /*
     * ============================================================
     * COORDENADAS DEL DOMICILIO BASE
     * ============================================================
     */

    decimal latitudBase = 0;
    decimal longitudBase = 0;

    bool tieneCoordenadasBase =
        decimal.TryParse(
            Model.CoordY,
            NumberStyles.Any,
            CultureInfo.InvariantCulture,
            out latitudBase
        ) &&
        decimal.TryParse(
            Model.CoordX,
            NumberStyles.Any,
            CultureInfo.InvariantCulture,
            out longitudBase
        ) &&
        latitudBase != 0 &&
        longitudBase != 0;

    string urlMapaBase =
        tieneCoordenadasBase
            ? "https://www.google.com/maps/search/?api=1&query=" +
              latitudBase.ToString(
                  CultureInfo.InvariantCulture
              ) +
              "," +
              longitudBase.ToString(
                  CultureInfo.InvariantCulture
              )
            : "";


    var carpetasInvestigacion =
    Model.Ingresos == null
        ? new List<string>()
        : Model.Ingresos
            .Where(x =>
                !string.IsNullOrWhiteSpace(
                    x.NumeroAvp
                )
            )
            .Select(x =>
                x.NumeroAvp.Trim()
            )
            .Distinct(
                StringComparer.OrdinalIgnoreCase
            )
            .ToList();

    bool tieneCarpetas =
        carpetasInvestigacion.Count > 0;

}


<div class="sic-fgea-detalle">

    <!-- =========================================================
         CABECERA
         ========================================================= -->

    <div class="sic-fgea-cabecera">

        <div class="sic-fgea-foto-wrap">

            <button type="button"
                    class="sic-fgea-btn-foto js-ampliar-foto"
                    data-foto="@fotoUrl"
                    data-nombre="@nombre"
                    data-fuente="FGEA - DETENIDOS"
                    title="Ver fotografía en grande">

                <img src="@fotoUrl"
                     alt="@nombre"
                     class="sic-fgea-foto"
                     onerror="this.onerror=null;this.src='@imagenNoDisponible';" />


                <span class="sic-fgea-foto-zoom">

                    <i class="fa fa-search-plus"></i>

                </span>

            </button>

        </div>


        <div class="sic-fgea-identidad">

            <div class="sic-fgea-fuente">
                <i class="fa fa-database"></i>
                FGEA - DETENIDOS
            </div>

            <h2 class="sic-fgea-nombre">
                @nombre
            </h2>

            <div class="sic-fgea-alias">
                Alias:
                <strong>
                    @alias
                </strong>
            </div>


            <div class="sic-fgea-resumen">

                <div class="sic-fgea-resumen-item">

                    <span>
                        Sexo
                    </span>

                    <strong>
                        @sexo
                    </strong>

                </div>


                <div class="sic-fgea-resumen-item">

                    <span>
                        Edad
                    </span>

                    <strong>
                        @edad
                    </strong>

                </div>


                <div class="sic-fgea-resumen-item">

                    <span>
                        Filiación
                    </span>

                    <strong>
                        @filiacion
                    </strong>

                </div>


                <div class="sic-fgea-resumen-item">

                    <span>
                        Fecha filiación
                    </span>

                    <strong>
                        @fechaFiliacion
                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         EVIDENCIA
         ========================================================= -->

    <div class="sic-fgea-evidencia">

        <div class="sic-fgea-evidencia-icono">

            <i class="fa @evidenciaIcono"></i>

        </div>


        <div class="sic-fgea-evidencia-info">

            <small>
                Evidencia principal
            </small>

            <span>
                @evidenciaTexto
            </span>

        </div>


        <strong>
            @porcentajeEvidenciaPrincipal.ToString("0")%
        </strong>

    </div>

    @if (
    coincidencia != null &&
    (
        coincidencia.PorcentajeNombre > 0 ||
        coincidencia.PorcentajeAlias > 0 ||
        coincidencia.PorcentajeFoto > 0 ||
        coincidencia.PorcentajeHuella > 0
    )
)
    {
        <div class="sic-fgea-evidencia-desglose">

            @if (coincidencia.PorcentajeNombre > 0)
            {
                <div class="sic-fgea-evidencia-item">

                    <div class="sic-fgea-evidencia-item-icono">
                        <i class="fa fa-user"></i>
                    </div>

                    <div>
                        <span>Nombre</span>

                        <strong>
                            @coincidencia.PorcentajeNombre.ToString("0")%
                        </strong>
                    </div>

                </div>
            }


            @if (coincidencia.PorcentajeAlias > 0)
            {
                <div class="sic-fgea-evidencia-item">

                    <div class="sic-fgea-evidencia-item-icono">
                        <i class="fa fa-user-secret"></i>
                    </div>

                    <div>
                        <span>Alias</span>

                        <strong>
                            @coincidencia.PorcentajeAlias.ToString("0")%
                        </strong>
                    </div>

                </div>
            }


            @if (coincidencia.PorcentajeFoto > 0)
            {
                <div class="sic-fgea-evidencia-item">

                    <div class="sic-fgea-evidencia-item-icono">
                        <i class="fa fa-camera"></i>
                    </div>

                    <div>
                        <span>Fotografía</span>

                        <strong>
                            @coincidencia.PorcentajeFoto.ToString("0")%
                        </strong>
                    </div>

                </div>
            }


            @if (coincidencia.PorcentajeHuella > 0)
            {
                <div class="sic-fgea-evidencia-item">

                    <div class="sic-fgea-evidencia-item-icono">
                        <i class="fa fa-hand-pointer-o"></i>
                    </div>

                    <div>
                        <span>Huella</span>

                        <strong>
                            @coincidencia.PorcentajeHuella.ToString("0")%
                        </strong>
                    </div>

                </div>
            }

        </div>
    }



    <!-- =========================================================
         INFORMACIÓN DE FILIACIÓN
         ========================================================= -->

    @if (tieneInformacionFiliacion)
    {
        <details class="sic-fgea-seccion" open>

            <summary>

                <i class="fa fa-id-card-o"></i>

                Información de filiación

            </summary>


            <div class="sic-fgea-seccion-contenido">

                <div class="sic-fgea-grid">


                    @if (Model.ClavePerso > 0)
                    {
                        <div class="sic-fgea-campo">

                            <span>
                                Clave persona
                            </span>

                            <strong>
                                @Model.ClavePerso
                            </strong>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.NumeroFiliacion))
                    {
                        <div class="sic-fgea-campo">

                            <span>
                                Número de filiación
                            </span>

                            <strong>
                                @Model.NumeroFiliacion
                            </strong>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.NumeroFicha))
                    {
                        <div class="sic-fgea-campo">

                            <span>
                                Número de ficha
                            </span>

                            <strong>
                                @Model.NumeroFicha
                            </strong>

                        </div>
                    }


                    @if (Model.FechaNacimiento.HasValue)
                    {
                        <div class="sic-fgea-campo">

                            <span>
                                Fecha de nacimiento
                            </span>

                            <strong>
                                @Model.FechaNacimiento.Value.ToString("dd/MM/yyyy")
                            </strong>

                        </div>
                    }


                    @if (Model.FechaFiliacion.HasValue)
                    {
                        <div class="sic-fgea-campo">

                            <span>
                                Fecha de filiación
                            </span>

                            <strong>
                                @Model.FechaFiliacion.Value.ToString("dd/MM/yyyy")
                            </strong>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.Estatura))
                    {
                        <div class="sic-fgea-campo">

                            <span>
                                Estatura
                            </span>

                            <strong>
                                @Model.Estatura cm
                            </strong>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.Peso))
                    {
                        <div class="sic-fgea-campo">

                            <span>
                                Peso
                            </span>

                            <strong>
                                @Model.Peso kg
                            </strong>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.Telefono))
                    {
                        <div class="sic-fgea-campo">

                            <span>
                                Teléfono
                            </span>

                            <strong>
                                @Model.Telefono
                            </strong>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
                    {
                        <div class="sic-fgea-campo sic-fgea-campo-completo">

                            <span>
                                Observaciones
                            </span>

                            <strong class="sic-fgea-texto-largo">
                                @Model.Observaciones
                            </strong>

                        </div>
                    }

                </div>

            </div>

        </details>
    }


    <!-- =========================================================
         NOMBRES Y ALIAS
         ========================================================= -->

    @if (tieneNombresAlias)
    {
        <details class="sic-fgea-seccion">

            <summary>

                <i class="fa fa-user"></i>

                Nombres y alias

            </summary>


            <div class="sic-fgea-seccion-contenido">


                @if (tieneNombres)
                {
                    <div class="sic-fgea-subtitulo">

                        <i class="fa fa-address-card-o"></i>

                        Nombres registrados

                    </div>


                    <div class="sic-fgea-lista">

                        @foreach (
                            Objetivos_Prioritarios.Models.Extends.DetalleFGEANombreApiDto item
                            in Model.Nombres
                        )
                        {
                            <div class="sic-fgea-registro">

                                <div class="sic-fgea-registro-principal">

                                    @item.NombreCompleto

                                </div>


                                <div class="sic-fgea-registro-meta">

                                    @if (item.IdNomPerso > 0)
                                    {
                                        <span>
                                            ID nombre:
                                            <strong>
                                                @item.IdNomPerso
                                            </strong>
                                        </span>
                                    }

                                    @if (item.FechaCaptura.HasValue)
                                    {
                                        <span>
                                            Registro:
                                            <strong>
                                                @item.FechaCaptura.Value.ToString("dd/MM/yyyy")
                                            </strong>
                                        </span>
                                    }

                                </div>

                            </div>
                        }

                    </div>
                }


                @if (tieneAlias)
                {
                    <div class="sic-fgea-subtitulo sic-fgea-subtitulo-separado">

                        <i class="fa fa-user-secret"></i>

                        Alias registrados

                    </div>


                    <div class="sic-fgea-lista">

                        @foreach (
                            Objetivos_Prioritarios.Models.Extends.DetalleFGEAAliasApiDto item
                            in Model.Alias
                        )
                        {
                            <div class="sic-fgea-registro">

                                <div class="sic-fgea-registro-principal">

                                    @item.Alias

                                </div>


                                @if (
                                    item.FechaAlias.HasValue ||
                                    item.FechaCaptura.HasValue
                                )
                                {
                                    <div class="sic-fgea-registro-meta">

                                        @if (item.FechaAlias.HasValue)
                                        {
                                            <span>
                                                Fecha:
                                                <strong>
                                                    @item.FechaAlias.Value.ToString("dd/MM/yyyy")
                                                </strong>
                                            </span>
                                        }

                                    </div>
                                }

                            </div>
                        }

                    </div>
                }

            </div>

        </details>
    }


    <!-- =========================================================
         DOMICILIOS
         ========================================================= -->

    @if (tieneSeccionDomicilios)
    {
        <details class="sic-fgea-seccion">

            <summary>

                <i class="fa fa-map-marker"></i>

                Domicilios

            </summary>


            <div class="sic-fgea-seccion-contenido">


                @if (tieneDomicilioBase)
                {
                    <div class="sic-fgea-subtitulo">

                        <i class="fa fa-home"></i>

                        Domicilio de filiación

                    </div>


                    <div class="sic-fgea-grid">


                        @if (!string.IsNullOrWhiteSpace(Model.Calle))
                        {
                            <div class="sic-fgea-campo">

                                <span>
                                    Calle
                                </span>

                                <strong>
                                    @Model.Calle
                                </strong>

                            </div>
                        }


                        @if (!string.IsNullOrWhiteSpace(Model.NumeroCasa))
                        {
                            <div class="sic-fgea-campo">

                                <span>
                                    Número
                                </span>

                                <strong>
                                    @Model.NumeroCasa
                                </strong>

                            </div>
                        }


                        @if (!string.IsNullOrWhiteSpace(Model.Colonia))
                        {
                            <div class="sic-fgea-campo">

                                <span>
                                    Colonia
                                </span>

                                <strong>
                                    @Model.Colonia
                                </strong>

                            </div>
                        }


                        @if (!string.IsNullOrWhiteSpace(Model.CodigoPostal))
                        {
                            <div class="sic-fgea-campo">

                                <span>
                                    Código postal
                                </span>

                                <strong>
                                    @Model.CodigoPostal
                                </strong>

                            </div>
                        }


                        @if (!string.IsNullOrWhiteSpace(Model.Municipio))
                        {
                            <div class="sic-fgea-campo">

                                <span>
                                    Municipio
                                </span>

                                <strong>
                                    @Model.Municipio
                                </strong>

                            </div>
                        }


                        @if (!string.IsNullOrWhiteSpace(Model.Estado))
                        {
                            <div class="sic-fgea-campo">

                                <span>
                                    Estado
                                </span>

                                <strong>
                                    @Model.Estado
                                </strong>

                            </div>
                        }


                        @if (tieneCoordenadasBase)
                        {
                            <div class="sic-fgea-ubicacion">

                                <div>

                                    <span>
                                        Coordenadas
                                    </span>

                                    <strong>
                                        @latitudBase,
                                        @longitudBase
                                    </strong>

                                </div>


                                <a href="@urlMapaBase"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="sic-fgea-btn-mapa">

                                    <i class="fa fa-map-marker"></i>

                                    Ver ubicación

                                </a>

                            </div>
                        }

                    </div>
                }


                @if (tieneDomicilios)
                {
                    <div class="sic-fgea-subtitulo sic-fgea-subtitulo-separado">

                        <i class="fa fa-map-o"></i>

                        Historial de domicilios

                    </div>


                    <div class="sic-fgea-lista">

                        @foreach (
                            Objetivos_Prioritarios.Models.Extends.DetalleFGEADomicilioApiDto domicilio
                            in Model.Domicilios
                        )
                        {
                            decimal latitud = 0;
                            decimal longitud = 0;

                            bool tieneCoordenadas =
                                decimal.TryParse(
                                    domicilio.CoordY,
                                    NumberStyles.Any,
                                    CultureInfo.InvariantCulture,
                                    out latitud
                                ) &&
                                decimal.TryParse(
                                    domicilio.CoordX,
                                    NumberStyles.Any,
                                    CultureInfo.InvariantCulture,
                                    out longitud
                                ) &&
                                latitud != 0 &&
                                longitud != 0;

                            string urlMapa =
                                tieneCoordenadas
                                    ? "https://www.google.com/maps/search/?api=1&query=" +
                                      latitud.ToString(
                                          CultureInfo.InvariantCulture
                                      ) +
                                      "," +
                                      longitud.ToString(
                                          CultureInfo.InvariantCulture
                                      )
                                    : "";


                            <div class="sic-fgea-registro">

                                <div class="sic-fgea-registro-titulo">

                                    <div>

                                        <strong>
                                            @{
                                                string domicilioTexto =
                                                    string.Join(
                                                        " ",
                                                        new[]
                                                        {
                                                            domicilio.Calle,
                                                            domicilio.NumeroCasa
}
                                                        .Where(x =>
                                                            !string.IsNullOrWhiteSpace(x)
                                                        )
                                                    );

                                                if (string.IsNullOrWhiteSpace(domicilioTexto))
                                                {
                                                    domicilioTexto =
                                                        "Domicilio registrado";
                                                }
                                            }

                                            @domicilioTexto

                                        </strong>


                                        @if (domicilio.EsActual)
                                        {
                                            <span class="sic-fgea-badge-actual">
                                                Actual
                                            </span>
                                        }

                                    </div>


                                    @if (tieneCoordenadas)
                                    {
                                        <a href="@urlMapa"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="sic-fgea-btn-mapa sic-fgea-btn-mapa-chico">

                                            <i class="fa fa-map-marker"></i>

                                            Ver ubicación

                                        </a>
                                    }

                                </div>


                                <div class="sic-fgea-registro-meta">

                                    @if (!string.IsNullOrWhiteSpace(domicilio.Colonia))
                                    {
                                        <span>
                                            Colonia:
                                            <strong>
                                                @domicilio.Colonia
                                            </strong>
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(domicilio.Municipio))
                                    {
                                        <span>
                                            Municipio:
                                            <strong>
                                                @domicilio.Municipio
                                            </strong>
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(domicilio.CodigoPostal))
                                    {
                                        <span>
                                            CP:
                                            <strong>
                                                @domicilio.CodigoPostal
                                            </strong>
                                        </span>
                                    }

                                    @if (domicilio.FechaAlta.HasValue)
                                    {
                                        <span>
                                            Alta:
                                            <strong>
                                                @domicilio.FechaAlta.Value.ToString("dd/MM/yyyy")
                                            </strong>
                                        </span>
                                    }

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

        </details>
    }


    @if (tieneCarpetas)
    {
        <details class="sic-fgea-seccion">

            <summary>
                <i class="fa fa-folder-open-o"></i>

                Carpetas de investigación

                <span class="sic-fgea-contador">
                    @carpetasInvestigacion.Count
                </span>
            </summary>

            <div class="sic-fgea-seccion-contenido">

                <div class="sic-fgea-lista">

                    @foreach (string carpeta in carpetasInvestigacion)
                    {
                        <div class="sic-fgea-registro">

                            <div class="sic-fgea-registro-principal">
                                <i class="fa fa-folder-o"></i>
                                @carpeta
                            </div>

                        </div>
                    }

                </div>

            </div>

        </details>
    }


    <!-- =========================================================
         INGRESOS / DETENCIONES
         ========================================================= -->

    @if (tieneIngresos)
    {
        <details class="sic-fgea-seccion">

            <summary>

                <i class="fa fa-shield"></i>

                Historial de ingresos y detenciones

                <span class="sic-fgea-contador">
                    @Model.Ingresos.Count
                </span>

            </summary>


            <div class="sic-fgea-seccion-contenido">

                <div class="sic-fgea-lista">


                    @foreach (
                        Objetivos_Prioritarios.Models.Extends.DetalleFGEAIngresoApiDto ingreso
                        in Model.Ingresos
                    )
                    {
                        decimal latitud = 0;
                        decimal longitud = 0;

                        bool tieneCoordenadas =
                            decimal.TryParse(
                                ingreso.CoordY,
                                NumberStyles.Any,
                                CultureInfo.InvariantCulture,
                                out latitud
                            ) &&
                            decimal.TryParse(
                                ingreso.CoordX,
                                NumberStyles.Any,
                                CultureInfo.InvariantCulture,
                                out longitud
                            ) &&
                            latitud != 0 &&
                            longitud != 0;

                        string urlMapa =
                            tieneCoordenadas
                                ? "https://www.google.com/maps/search/?api=1&query=" +
                                  latitud.ToString(
                                      CultureInfo.InvariantCulture
                                  ) +
                                  "," +
                                  longitud.ToString(
                                      CultureInfo.InvariantCulture
                                  )
                                : "";


                        <div class="sic-fgea-ingreso">

                            <div class="sic-fgea-ingreso-header">

                                <div>

                                    <span>
                                        Detención
                                    </span>

                                    <strong>

                                        @if (ingreso.FechaDetencion.HasValue)
                                        {
                                            @ingreso.FechaDetencion.Value.ToString("dd/MM/yyyy")
                                        }
                                        else
                                        {
                                            @:SIN FECHA
                                        }

                                        @if (!string.IsNullOrWhiteSpace(ingreso.HoraDetencion))
                                        {
                                            @: · @ingreso.HoraDetencion
                                        }

                                    </strong>

                                </div>


                                @if (!string.IsNullOrWhiteSpace(ingreso.NumeroAvp))
                                {
                                    <div class="sic-fgea-ci">
                                        <span>Carpeta de investigación</span>
                                        <strong>@ingreso.NumeroAvp</strong>
                                    </div>
                                }

                            </div>


                            <div class="sic-fgea-grid sic-fgea-grid-interno">


                                @if (!string.IsNullOrWhiteSpace(ingreso.LugarDetencion))
                                {
                                    <div class="sic-fgea-campo">

                                        <span>
                                            Lugar de detención
                                        </span>

                                        <strong>
                                            @ingreso.LugarDetencion
                                        </strong>

                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(ingreso.PersonaDetiene))
                                {
                                    <div class="sic-fgea-campo">

                                        <span>
                                            Corporación / persona que detiene
                                        </span>

                                        <strong>
                                            @ingreso.PersonaDetiene
                                        </strong>

                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(ingreso.DetenidoPor))
                                {
                                    <div class="sic-fgea-campo">

                                        <span>
                                            Detenido por
                                        </span>

                                        <strong>
                                            @ingreso.DetenidoPor
                                        </strong>

                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(ingreso.MinisterioPublico))
                                {
                                    <div class="sic-fgea-campo">

                                        <span>
                                            Ministerio Público
                                        </span>

                                        <strong>
                                            @ingreso.MinisterioPublico
                                        </strong>

                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(ingreso.MotivoDetencion))
                                {
                                    <div class="sic-fgea-campo">

                                        <span>
                                            Motivo de detención
                                        </span>

                                        <strong>
                                            @ingreso.MotivoDetencion
                                        </strong>

                                    </div>
                                }


                                @if (ingreso.FechaIngreso.HasValue)
                                {
                                    <div class="sic-fgea-campo">

                                        <span>
                                            Fecha de ingreso
                                        </span>

                                        <strong>

                                            @ingreso.FechaIngreso.Value.ToString("dd/MM/yyyy")

                                            @if (!string.IsNullOrWhiteSpace(ingreso.HoraIngreso))
                                            {
                                                @: · @ingreso.HoraIngreso
                                            }

                                        </strong>

                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(ingreso.DisposicionDetenido))
                                {
                                    <div class="sic-fgea-campo">

                                        <span>
                                            Disposición
                                        </span>

                                        <strong>
                                            @ingreso.DisposicionDetenido
                                        </strong>

                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(ingreso.NumeroOrden))
                                {
                                    <div class="sic-fgea-campo">

                                        <span>
                                            Número de orden
                                        </span>

                                        <strong>
                                            @ingreso.NumeroOrden
                                        </strong>

                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(ingreso.LugarConsigna))
                                {
                                    <div class="sic-fgea-campo">

                                        <span>
                                            Lugar de consignación
                                        </span>

                                        <strong>
                                            @ingreso.LugarConsigna
                                        </strong>

                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(ingreso.ObservacionConsigna))
                                {
                                    <div class="sic-fgea-campo sic-fgea-campo-completo">

                                        <span>
                                            Observación de consignación
                                        </span>

                                        <strong class="sic-fgea-texto-largo">
                                            @ingreso.ObservacionConsigna
                                        </strong>

                                    </div>
                                }


                                @if (tieneCoordenadas)
                                {
                                    <div class="sic-fgea-ubicacion">

                                        <div>

                                            <span>
                                                Coordenadas
                                            </span>

                                            <strong>
                                                @latitud,
                                                @longitud
                                            </strong>

                                        </div>


                                        <a href="@urlMapa"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="sic-fgea-btn-mapa">

                                            <i class="fa fa-map-marker"></i>

                                            Ver ubicación

                                        </a>

                                    </div>
                                }

                            </div>

                        </div>
                    }

                </div>

            </div>

        </details>
    }


    <!-- =========================================================
         DELITOS
         ========================================================= -->

    @if (tieneDelitos)
    {
        <details class="sic-fgea-seccion">

            <summary>

                <i class="fa fa-gavel"></i>

                Delitos registrados

                <span class="sic-fgea-contador">
                    @Model.Delitos.Count
                </span>

            </summary>


            <div class="sic-fgea-seccion-contenido">

                <div class="sic-fgea-lista">


                    @foreach (
                        Objetivos_Prioritarios.Models.Extends.DetalleFGEADelitoApiDto delito
                        in Model.Delitos
                    )
                    {
                        <div class="sic-fgea-delito">

                            <div class="sic-fgea-delito-icono">

                                <i class="fa fa-gavel"></i>

                            </div>


                            <div class="sic-fgea-delito-info">

                                <strong>
                                    @delito.Delito
                                </strong>


                                <div class="sic-fgea-registro-meta">

                                    @if (delito.FechaDelito.HasValue)
                                    {
                                        <span>
                                            Fecha:
                                            <strong>
                                                @delito.FechaDelito.Value.ToString("dd/MM/yyyy")
                                            </strong>
                                        </span>
                                    }


                                    @if (delito.ClaveDelito.HasValue)
                                    {
                                        <span>
                                            Clave:
                                            <strong>
                                                @delito.ClaveDelito.Value
                                            </strong>
                                        </span>
                                    }

                                </div>


                                @if (!string.IsNullOrWhiteSpace(delito.Observacion))
                                {
                                    <div class="sic-fgea-delito-observacion">

                                        @delito.Observacion

                                    </div>
                                }

                            </div>

                        </div>
                    }

                </div>

            </div>

        </details>
    }



    @if (tieneMandamientos)
    {
        <details class="sic-fgea-seccion sic-fgea-mandamientos">

            <summary>

                <i class="fa fa-gavel"></i>

                Posibles mandamientos judiciales

                <span class="sic-fgea-contador sic-fgea-contador-mandamientos">
                    @totalMandamientos
                </span>

            </summary>


            <div class="sic-fgea-seccion-contenido">

                <div class="sic-fgea-mandamientos-aviso">

                    <i class="fa fa-exclamation-triangle"></i>

                    <div>
                        <strong>
                            Coincidencias nominales
                        </strong>

                        <span>
                            Los siguientes registros fueron encontrados por
                            similitud de nombre y no representan por sí solos
                            una vinculación confirmada con esta persona.
                        </span>
                    </div>

                </div>


                <div class="sic-fgea-lista">

                    @foreach (
                        var mandamiento
                        in coincidencia.MandamientosJudiciales
                    )
                    {
                        <div class="sic-fgea-registro sic-fgea-mandamiento-registro">

                            <div class="sic-fgea-mandamiento-header">

                                <div>

                                    <span class="sic-fgea-mandamiento-tipo">
                                        @(string.IsNullOrWhiteSpace(mandamiento.TipoMandamiento) ||
                                      mandamiento.TipoMandamiento.Equals(
                                          "SIN INFORMACIÓN",
                                          StringComparison.OrdinalIgnoreCase
                                      )
                                        ? "MANDAMIENTO JUDICIAL"
                                        : mandamiento.TipoMandamiento)
                                    </span>

                                    @if (
                                        !string.IsNullOrWhiteSpace(
                                            mandamiento.EstadoProceso
                                        ) &&
                                        !mandamiento.EstadoProceso.Equals(
                                            "SIN INFORMACIÓN",
                                            StringComparison.OrdinalIgnoreCase
                                        )
                                    )
                                    {
                                        <span class="sic-fgea-mandamiento-estado">
                                            @mandamiento.EstadoProceso
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(mandamiento.Delito))
                                    {
                                        <span class="sic-fgea-mandamiento-estado">
                                            @mandamiento.Delito
                                        </span>
                                    }

                                </div>


                                @if (mandamiento.PorcentajeNombre > 0)
                                {
                                    <strong class="sic-fgea-mandamiento-porcentaje">
                                        @mandamiento.PorcentajeNombre%
                                    </strong>
                                }

                            </div>


                            <div class="sic-fgea-grid sic-fgea-mandamiento-grid">

                                @if (!string.IsNullOrWhiteSpace(mandamiento.NombreCompleto))
                                {
                                    <div class="sic-fgea-campo sic-fgea-campo-completo">

                                        <span>
                                            Nombre encontrado
                                        </span>

                                        <strong>
                                            @mandamiento.NombreCompleto
                                        </strong>

                                    </div>
                                }


                                @if (
                                    !string.IsNullOrWhiteSpace(
                                        mandamiento.NumeroControl
                                    ) &&
                                    !mandamiento.NumeroControl.Equals(
                                        "SIN INFORMACIÓN",
                                        StringComparison.OrdinalIgnoreCase
                                    )
                                )
                                {
                                    <div class="sic-fgea-campo">

                                        <span>
                                            Número de control
                                        </span>

                                        <strong>
                                            @mandamiento.NumeroControl
                                        </strong>

                                    </div>
                                }


                                @if (
                                    !string.IsNullOrWhiteSpace(
                                        mandamiento.NumeroExpediente
                                    ) &&
                                    !mandamiento.NumeroExpediente.Equals(
                                        "SIN INFORMACIÓN",
                                        StringComparison.OrdinalIgnoreCase
                                    )
                                )
                                {
                                    <div class="sic-fgea-campo">

                                        <span>
                                            Expediente
                                        </span>

                                        <strong>
                                            @mandamiento.NumeroExpediente
                                        </strong>

                                    </div>
                                }


                                @if (mandamiento.FechaExpedicion.HasValue)
                                {
                                    <div class="sic-fgea-campo">

                                        <span>
                                            Fecha de expedición
                                        </span>

                                        <strong>
                                            @mandamiento.FechaExpedicion.Value.ToString("dd/MM/yyyy")
                                        </strong>

                                    </div>
                                }


                                @if (mandamiento.FechaAlta.HasValue)
                                {
                                    <div class="sic-fgea-campo">

                                        <span>
                                            Fecha de alta
                                        </span>

                                        <strong>
                                            @mandamiento.FechaAlta.Value.ToString("dd/MM/yyyy")
                                        </strong>

                                    </div>
                                }

                            </div>

                        </div>
                    }

                </div>

            </div>

        </details>
    }

    <!-- =========================================================
         INFORMACIÓN LABORAL
         ========================================================= -->

    @if (tieneTrabajo)
    {
        <details class="sic-fgea-seccion">

            <summary>

                <i class="fa fa-briefcase"></i>

                Información laboral

            </summary>


            <div class="sic-fgea-seccion-contenido">

                <div class="sic-fgea-grid">


                    @if (!string.IsNullOrWhiteSpace(Model.LugarTrabajo))
                    {
                        <div class="sic-fgea-campo">

                            <span>
                                Lugar de trabajo
                            </span>

                            <strong>
                                @Model.LugarTrabajo
                            </strong>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.TelefonoTrabajo))
                    {
                        <div class="sic-fgea-campo">

                            <span>
                                Teléfono de trabajo
                            </span>

                            <strong>
                                @Model.TelefonoTrabajo
                            </strong>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.UbicacionTrabajo))
                    {
                        <div class="sic-fgea-campo sic-fgea-campo-completo">

                            <span>
                                Ubicación del trabajo
                            </span>

                            <strong class="sic-fgea-texto-largo">
                                @Model.UbicacionTrabajo
                            </strong>

                        </div>
                    }

                </div>

            </div>

        </details>
    }

</div>



<style>

    .sic-fgea-detalle {
        padding: 28px;
        color: #121b39;
        box-sizing: border-box;
    }


    /* =========================================================
       CABECERA
       ========================================================= */

    .sic-fgea-cabecera {
        display: flex;
        align-items: flex-start;
        gap: 18px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e4e9f3;
    }

    .sic-fgea-foto-wrap {
        width: 112px;
        min-width: 112px;
    }

    .sic-fgea-foto {
        display: block;
        width: 112px;
        height: 130px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #d8dfec;
        background: #f5f7fb;
    }

    .sic-fgea-identidad {
        flex: 1;
        min-width: 0;
    }

    .sic-fgea-fuente {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 10px;
        padding: 6px 10px;
        border: 1px solid #e7c35c;
        border-radius: 18px;
        background: #fff6d9;
        color: #785800;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .sic-fgea-nombre {
        margin: 0;
        color: #0c1742;
        font-size: 22px;
        line-height: 1.15;
        font-weight: 900;
        text-transform: uppercase;
    }

    .sic-fgea-alias {
        margin-top: 7px;
        color: #626d84;
        font-size: 12px;
    }

        .sic-fgea-alias strong {
            color: #121b39;
        }


    /* =========================================================
       RESUMEN
       ========================================================= */

    .sic-fgea-resumen {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 9px;
        margin-top: 17px;
    }

    .sic-fgea-resumen-item {
        min-height: 65px;
        padding: 10px 11px;
        border: 1px solid #e0e6f0;
        border-radius: 8px;
        background: #fafbfe;
        box-sizing: border-box;
    }

        .sic-fgea-resumen-item span {
            display: block;
            margin-bottom: 8px;
            color: #7e879c;
            font-size: 8px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .sic-fgea-resumen-item strong {
            color: #0d1738;
            font-size: 11px;
            font-weight: 800;
        }


    /* =========================================================
       EVIDENCIA
       ========================================================= */

    .sic-fgea-evidencia {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 14px 0;
        padding: 13px;
        border: 1px solid #b9e1c4;
        border-radius: 9px;
        background: #f0fbf3;
    }

    .sic-fgea-evidencia-icono {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #daf3e1;
        color: #30964d;
        font-size: 14px;
    }

    .sic-fgea-evidencia-texto {
        flex: 1;
    }

        .sic-fgea-evidencia-texto span {
            display: block;
            margin-bottom: 3px;
            color: #52745b;
            font-size: 8px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .sic-fgea-evidencia-texto strong {
            color: #142319;
            font-size: 12px;
            font-weight: 500;
        }

    .sic-fgea-evidencia-porcentaje {
        color: #247438;
        font-size: 18px;
        font-weight: 900;
    }


    /* =========================================================
       SECCIONES
       ========================================================= */

    .sic-fgea-seccion {
        margin-bottom: 9px;
        overflow: hidden;
        border: 1px solid #dce3ef;
        border-radius: 8px;
        background: #fff;
    }

        .sic-fgea-seccion > summary {
            position: relative;
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 11px 13px;
            background: #f7f9fd;
            color: #101a42;
            font-size: 12px;
            font-weight: 800;
            cursor: pointer;
            list-style: none;
            user-select: none;
        }

            .sic-fgea-seccion > summary::-webkit-details-marker {
                display: none;
            }

            .sic-fgea-seccion > summary:after {
                content: "\f107";
                position: absolute;
                right: 13px;
                top: 50%;
                transform: translateY(-50%);
                font-family: FontAwesome;
                color: #74809b;
                font-size: 11px;
            }

        .sic-fgea-seccion[open] > summary:after {
            content: "\f106";
        }

    .sic-fgea-seccion-contenido {
        padding: 13px;
    }

    .sic-fgea-contador {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 21px;
        height: 21px;
        margin-left: 4px;
        padding: 0 6px;
        border-radius: 12px;
        background: #e9eefb;
        color: #445b9f;
        font-size: 9px;
        font-weight: 800;
        box-sizing: border-box;
    }


    /* =========================================================
       GRID / CAMPOS
       ========================================================= */

    .sic-fgea-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 9px;
    }

    .sic-fgea-grid-interno {
        margin-top: 11px;
    }

    .sic-fgea-campo {
        min-height: 66px;
        padding: 10px;
        border: 1px solid #e4e8f0;
        border-radius: 7px;
        background: #fbfcfe;
        box-sizing: border-box;
    }

    .sic-fgea-campo-completo {
        grid-column: 1 / -1;
    }

    .sic-fgea-campo span {
        display: block;
        margin-bottom: 8px;
        color: #7c859b;
        font-size: 8px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .sic-fgea-campo strong {
        color: #0f1737;
        font-size: 11px;
        font-weight: 800;
        word-break: break-word;
    }

    .sic-fgea-texto-largo {
        line-height: 1.55;
        font-weight: 500 !important;
    }


    /* =========================================================
       SUBTÍTULOS
       ========================================================= */

    .sic-fgea-subtitulo {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 9px;
        color: #556079;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .sic-fgea-subtitulo-separado {
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px solid #edf0f5;
    }


    /* =========================================================
       LISTAS
       ========================================================= */

    .sic-fgea-lista {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

