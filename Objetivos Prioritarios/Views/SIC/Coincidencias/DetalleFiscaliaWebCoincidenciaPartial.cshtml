@model Objetivos_Prioritarios.Models.Extends.DetalleFiscaliaWebApiDto

@using System

@{
    Objetivos_Prioritarios.Models.Extends.CoincidenciaResultadoViewModel coincidencia =
        ViewBag.Coincidencia
        as Objetivos_Prioritarios.Models.Extends.CoincidenciaResultadoViewModel;

    string imagenNoDisponible =
        Url.Content("~/Content/imagenes/Nodisponible.jpg");


    /*
     * ============================================================
     * FOTO
     * ============================================================
     */

    string fotoUrl =
        imagenNoDisponible;

    if (
        Model.TieneFoto &&
        !string.IsNullOrWhiteSpace(Model.FotoUrl)
    )
    {
        if (
            Model.FotoUrl.StartsWith(
                "http",
                StringComparison.OrdinalIgnoreCase
            )
        )
        {
            fotoUrl =
                Model.FotoUrl;
        }
        else
        {
            fotoUrl =
                Url.Content(Model.FotoUrl);
        }
    }


    /*
     * ============================================================
     * DATOS PRINCIPALES
     * ============================================================
     */

    string nombre =
        string.IsNullOrWhiteSpace(Model.NombreCompleto)
            ? "SIN INFORMACIÓN"
            : Model.NombreCompleto.Trim();

    string fuente =
        string.IsNullOrWhiteSpace(Model.Fuente)
            ? "REGISTRO FGEA"
            : Model.Fuente.Trim();

    string sexo =
        string.IsNullOrWhiteSpace(Model.Sexo)
            ? "SIN INFORMACIÓN"
            : Model.Sexo.Trim();

    string edad =
        Model.Edad.HasValue &&
        Model.Edad.Value > 0
            ? Model.Edad.Value + " años"
            : "SIN INFORMACIÓN";

    string fecha =
        Model.FechaAusencia.HasValue
            ? Model.FechaAusencia.Value.ToString("dd/MM/yyyy")
            : "SIN INFORMACIÓN";

    string lugar =
        string.IsNullOrWhiteSpace(Model.LugarAusencia)
            ? "SIN INFORMACIÓN"
            : Model.LugarAusencia.Trim();

    string senas =
        string.IsNullOrWhiteSpace(Model.SenasParticulares)
            ? ""
            : Model.SenasParticulares.Trim();

    string resumen =
        string.IsNullOrWhiteSpace(Model.ResumenHechos)
            ? ""
            : Model.ResumenHechos.Trim();


    /*
     * ============================================================
     * ALIAS DE LA COINCIDENCIA
     * ============================================================
     */

    string alias =
        "";

    if (
        coincidencia != null &&
        !string.IsNullOrWhiteSpace(coincidencia.Alias) &&
        !coincidencia.Alias.Equals(
            "SIN INFORMACIÓN",
            StringComparison.OrdinalIgnoreCase
        )
    )
    {
        alias =
            coincidencia.Alias.Trim();
    }


    /*
 * ============================================================
 * EVIDENCIA PRINCIPAL
 * ============================================================
 *
 * Se muestra la evidencia individual con mayor porcentaje.
 *
 * En caso de empate:
 *
 * Huella > Fotografía > Alias > Nombre
 * ============================================================
 */

    decimal porcentajeEvidenciaPrincipal = 0;

    string evidenciaTexto =
        "Coincidencia encontrada";

    string evidenciaIcono =
        "fa-check-circle";


    if (coincidencia != null)
    {
        decimal porcentajeNombre =
            coincidencia.PorcentajeNombre;

        decimal porcentajeAlias =
            coincidencia.PorcentajeAlias;

        decimal porcentajeFoto =
            coincidencia.PorcentajeFoto;

        decimal porcentajeHuella =
            coincidencia.PorcentajeHuella;


        /*
         * NOMBRE
         */
        if (porcentajeNombre > 0)
        {
            porcentajeEvidenciaPrincipal =
                porcentajeNombre;

            evidenciaTexto =
                "Coincidencia por nombre";

            evidenciaIcono =
                "fa-user";
        }


        /*
         * ALIAS
         */
        if (
            porcentajeAlias > 0 &&
            porcentajeAlias > porcentajeEvidenciaPrincipal
        )
        {
            porcentajeEvidenciaPrincipal =
                porcentajeAlias;

            evidenciaTexto =
                "Coincidencia por alias";

            evidenciaIcono =
                "fa-user-secret";
        }


        /*
         * TEXTO
         *
         * Respaldo si existe PorcentajeTexto pero no viene
         * separado como Nombre o Alias.
         */
        if (
            porcentajeEvidenciaPrincipal <= 0 &&
            coincidencia.PorcentajeTexto > 0
        )
        {
            porcentajeEvidenciaPrincipal =
                coincidencia.PorcentajeTexto;

            evidenciaTexto =
                "Coincidencia textual";

            evidenciaIcono =
                "fa-font";
        }


        /*
         * FOTOGRAFÍA
         *
         * >= para que la biometría gane en caso de empate.
         */
        if (
            porcentajeFoto > 0 &&
            porcentajeFoto >= porcentajeEvidenciaPrincipal
        )
        {
            porcentajeEvidenciaPrincipal =
                porcentajeFoto;

            evidenciaTexto =
                "Comparación de fotografía";

            evidenciaIcono =
                "fa-camera";
        }


        /*
         * HUELLA
         *
         * >= para que huella gane también el empate
         * contra fotografía.
         */
        if (
            porcentajeHuella > 0 &&
            porcentajeHuella >= porcentajeEvidenciaPrincipal
        )
        {
            porcentajeEvidenciaPrincipal =
                porcentajeHuella;

            evidenciaTexto =
                "Comparación de huella";

            evidenciaIcono =
                "fa-hand-pointer-o";
        }
    }




    /*
     * ============================================================
     * COLOR DE FUENTE
     *
     * 2 = CAPEA / FEMDLP
     * 7 = Alerta Amber
     * 8 = Protocolo Alba
     * ============================================================
     */

    string claseFuente =
"sic-fw-fuente-capea";

    if (Model.IdTbFuente == 7)
    {
        claseFuente =
            "sic-fw-fuente-amber";
    }
    else if (Model.IdTbFuente == 8)
    {
        claseFuente =
            "sic-fw-fuente-alba";
    }


    /*
     * ============================================================
     * SECCIONES
     * ============================================================
     */

    bool tieneDatosRegistro =
        Model.IdPersona > 0 ||
        Model.FechaAusencia.HasValue ||
        !string.IsNullOrWhiteSpace(Model.LugarAusencia);

    bool tieneSenas =
        !string.IsNullOrWhiteSpace(senas);

    bool tieneResumen =
        !string.IsNullOrWhiteSpace(resumen);
}


<div class="sic-fw-detalle">

    <!-- =========================================================
         CABECERA
         ========================================================= -->

    <div class="sic-fw-cabecera">

        <div class="sic-fw-foto-wrap">

            <img src="@fotoUrl"
                 alt="@nombre"
                 class="sic-fw-foto"
                 onerror="this.onerror=null;this.src='@imagenNoDisponible';" />

        </div>


        <div class="sic-fw-identidad">

            <div class="sic-fw-fuente @claseFuente">

                <i class="fa fa-database"></i>

                @fuente

            </div>


            <h2 class="sic-fw-nombre">
                @nombre
            </h2>


            @if (!string.IsNullOrWhiteSpace(alias))
            {
                <div class="sic-fw-alias">

                    Alias:

                    <strong>
                        @alias
                    </strong>

                </div>
            }


            <div class="sic-fw-resumen">


                <div class="sic-fw-resumen-item">

                    <span>
                        Sexo
                    </span>

                    <strong>
                        @sexo
                    </strong>

                </div>


                <div class="sic-fw-resumen-item">

                    <span>
                        Edad
                    </span>

                    <strong>
                        @edad
                    </strong>

                </div>


                <div class="sic-fw-resumen-item">

                    <span>
                        Fecha ausencia / hechos
                    </span>

                    <strong>
                        @fecha
                    </strong>

                </div>


                <div class="sic-fw-resumen-item">

                    <span>
                        ID registro
                    </span>

                    <strong>
                        @Model.IdPersona
                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         EVIDENCIA
         ========================================================= -->

    @if (coincidencia != null)
    {
        <div class="sic-fw-evidencia">

            <div class="sic-fw-evidencia-icono">

                <i class="fa @evidenciaIcono"></i>

            </div>


            <div class="sic-fw-evidencia-info">

                <small>
                    Evidencia principal
                </small>

                <span>
                    @evidenciaTexto
                </span>

            </div>


            <strong>
                @porcentajeEvidenciaPrincipal.ToString("0")%
            </strong>

        </div>
    }

    @if (
    coincidencia != null &&
    (
        coincidencia.PorcentajeNombre > 0 ||
        coincidencia.PorcentajeAlias > 0 ||
        coincidencia.PorcentajeFoto > 0 ||
        coincidencia.PorcentajeHuella > 0
    )
)
    {
        <div class="sic-fw-evidencia-desglose">

            @if (coincidencia.PorcentajeNombre > 0)
            {
                <div class="sic-fw-evidencia-item">

                    <i class="fa fa-user"></i>

                    <div>
                        <span>Nombre</span>

                        <strong>
                            @coincidencia.PorcentajeNombre.ToString("0")%
                        </strong>
                    </div>

                </div>
            }


            @if (coincidencia.PorcentajeAlias > 0)
            {
                <div class="sic-fw-evidencia-item">

                    <i class="fa fa-user-secret"></i>

                    <div>
                        <span>Alias</span>

                        <strong>
                            @coincidencia.PorcentajeAlias.ToString("0")%
                        </strong>
                    </div>

                </div>
            }


            @if (coincidencia.PorcentajeFoto > 0)
            {
                <div class="sic-fw-evidencia-item">

                    <i class="fa fa-camera"></i>

                    <div>
                        <span>Fotografía</span>

                        <strong>
                            @coincidencia.PorcentajeFoto.ToString("0")%
                        </strong>
                    </div>

                </div>
            }


            @if (coincidencia.PorcentajeHuella > 0)
            {
                <div class="sic-fw-evidencia-item">

                    <i class="fa fa-hand-pointer-o"></i>

                    <div>
                        <span>Huella</span>

                        <strong>
                            @coincidencia.PorcentajeHuella.ToString("0")%
                        </strong>
                    </div>

                </div>
            }

        </div>
    }
    <!-- =========================================================
         INFORMACIÓN DEL REGISTRO
         ========================================================= -->

    @if (tieneDatosRegistro)
    {
        <details class="sic-fw-seccion" open>

            <summary>

                <i class="fa fa-info-circle"></i>

                Información del registro

            </summary>


            <div class="sic-fw-seccion-contenido">

                <div class="sic-fw-grid">


                    @if (Model.IdPersona > 0)
                    {
                        <div class="sic-fw-campo">

                            <span>
                                ID persona
                            </span>

                            <strong>
                                @Model.IdPersona
                            </strong>

                        </div>
                    }


                    <div class="sic-fw-campo">

                        <span>
                            Fuente
                        </span>

                        <strong>
                            @fuente
                        </strong>

                    </div>


                    @if (Model.FechaAusencia.HasValue)
                    {
                        <div class="sic-fw-campo">

                            <span>
                                Fecha de ausencia / hechos
                            </span>

                            <strong>
                                @Model.FechaAusencia.Value.ToString("dd/MM/yyyy")
                            </strong>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.LugarAusencia))
                    {
                        <div class="sic-fw-campo">

                            <span>
                                Lugar
                            </span>

                            <strong>
                                @Model.LugarAusencia
                            </strong>

                        </div>
                    }

                </div>

            </div>

        </details>
    }


    <!-- =========================================================
         SEÑAS PARTICULARES
         ========================================================= -->

    @if (tieneSenas)
    {
        <details class="sic-fw-seccion">

            <summary>

                <i class="fa fa-address-card-o"></i>

                Señas particulares

            </summary>


            <div class="sic-fw-seccion-contenido">

                <div class="sic-fw-campo sic-fw-campo-completo">

                    <span>
                        Descripción
                    </span>

                    <strong class="sic-fw-texto-largo">
                        @senas
                    </strong>

                </div>

            </div>

        </details>
    }


    <!-- =========================================================
         RESUMEN DE HECHOS
         ========================================================= -->

    @if (tieneResumen)
    {
        <details class="sic-fw-seccion">

            <summary>

                <i class="fa fa-file-text-o"></i>

                Resumen de los hechos

            </summary>


            <div class="sic-fw-seccion-contenido">

                <div class="sic-fw-campo sic-fw-campo-completo">

                    <span>
                        Hechos
                    </span>

                    <strong class="sic-fw-texto-largo">
                        @resumen
                    </strong>

                </div>

            </div>

        </details>
    }

</div>


<style>

    /* =========================================================
       CONTENEDOR
       ========================================================= */

    .sic-fw-detalle {
        padding: 28px;
        color: #111a3b;
        box-sizing: border-box;
    }


    /* =========================================================
       CABECERA
       ========================================================= */

    .sic-fw-cabecera {
        display: flex;
        align-items: flex-start;
        gap: 18px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e3e8f1;
    }

    .sic-fw-foto-wrap {
        width: 112px;
        min-width: 112px;
    }

    .sic-fw-foto {
        display: block;
        width: 112px;
        height: 135px;
        object-fit: cover;
        border: 1px solid #d8dfec;
        border-radius: 10px;
        background: #f5f7fb;
    }

    .sic-fw-identidad {
        flex: 1;
        min-width: 0;
    }


    /* =========================================================
       FUENTE
       ========================================================= */

    .sic-fw-fuente {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 10px;
        padding: 7px 11px;
        border: 1px solid;
        border-radius: 18px;
        font-size: 11px;
        line-height: 1.3;
        font-weight: 800;
        text-transform: uppercase;
    }


    .sic-fw-fuente-capea {
        border-color: #b8cdf8;
        background: #edf3ff;
        color: #31539c;
    }


    .sic-fw-fuente-amber {
        border-color: #e6c45e;
        background: #fff6d8;
        color: #775700;
    }


    .sic-fw-fuente-alba {
        border-color: #cebdf7;
        background: #f3efff;
        color: #6546aa;
    }


    /* =========================================================
       NOMBRE / ALIAS
       ========================================================= */

    .sic-fw-nombre {
        margin: 0;
        color: #0d1743;
        font-size: 23px;
        line-height: 1.2;
        font-weight: 900;
        text-transform: uppercase;
    }

    .sic-fw-alias {
        margin-top: 7px;
        color: #626d84;
        font-size: 14px;
        line-height: 1.4;
    }

        .sic-fw-alias strong {
            color: #121b39;
        }


    /* =========================================================
       RESUMEN SUPERIOR
       ========================================================= */

    .sic-fw-resumen {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 9px;
        margin-top: 17px;
    }

    .sic-fw-resumen-item {
        min-height: 75px;
        padding: 12px;
        border: 1px solid #e0e6f0;
        border-radius: 8px;
        background: #fafbfe;
        box-sizing: border-box;
    }

        .sic-fw-resumen-item span {
            display: block;
            margin-bottom: 10px;
            color: #7e879c;
            font-size: 11px;
            line-height: 1.3;
            font-weight: 700;
            text-transform: uppercase;
        }

        .sic-fw-resumen-item strong {
            color: #0d1738;
            font-size: 14px;
            line-height: 1.4;
            font-weight: 800;
        }


    /* =========================================================
       EVIDENCIA
       ========================================================= */

    .sic-fw-evidencia {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 14px 0;
        padding: 14px;
        border: 1px solid #b9e1c4;
        border-radius: 9px;
        background: #f0fbf3;
    }

    .sic-fw-evidencia-icono {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        min-width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #daf3e1;
        color: #30964d;
        font-size: 14px;
    }

    .sic-fw-evidencia-info {
        flex: 1;
    }

        .sic-fw-evidencia-info small {
            display: block;
            margin-bottom: 5px;
            color: #52745b;
            font-size: 10px;
            line-height: 1.3;
            font-weight: 700;
            text-transform: uppercase;
        }

        .sic-fw-evidencia-info span {
            color: #142319;
            font-size: 14px;
            line-height: 1.4;
        }

    .sic-fw-evidencia > strong {
        color: #247438;
        font-size: 20px;
        font-weight: 900;
    }


    /* =========================================================
       SECCIONES
       ========================================================= */

    .sic-fw-seccion {
        margin-bottom: 9px;
        overflow: hidden;
        border: 1px solid #dce3ef;
        border-radius: 8px;
        background: #fff;
    }

        .sic-fw-seccion > summary {
            position: relative;
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 12px 14px;
            background: #f7f9fd;
            color: #101a42;
            font-size: 14px;
            line-height: 1.4;
            font-weight: 800;
            cursor: pointer;
            list-style: none;
            user-select: none;
        }

            .sic-fw-seccion > summary::-webkit-details-marker {
                display: none;
            }

            .sic-fw-seccion > summary:after {
                content: "\f107";
                position: absolute;
                right: 14px;
                top: 50%;
                transform: translateY(-50%);
                font-family: FontAwesome;
                color: #74809b;
                font-size: 12px;
            }

        .sic-fw-seccion[open] > summary:after {
            content: "\f106";
        }

    .sic-fw-seccion-contenido {
        padding: 13px;
    }


    /* =========================================================
       GRID
       ========================================================= */

    .sic-fw-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 9px;
    }


    /* =========================================================
       CAMPOS
       ========================================================= */

    .sic-fw-campo {
        min-height: 78px;
        padding: 13px 14px;
        border: 1px solid #e4e8f0;
        border-radius: 7px;
        background: #fbfcfe;
        box-sizing: border-box;
    }

    .sic-fw-campo-completo {
        grid-column: 1 / -1;
    }

    .sic-fw-campo span {
        display: block;
        margin-bottom: 10px;
        color: #7c859b;
        font-size: 11px;
        line-height: 1.3;
        font-weight: 700;
        text-transform: uppercase;
    }

    .sic-fw-campo strong {
        color: #0f1737;
        font-size: 14px;
        line-height: 1.45;
        font-weight: 800;
        word-break: break-word;
    }


    /* =========================================================
       TEXTOS LARGOS
       ========================================================= */

    .sic-fw-texto-largo {
        display: block;
        font-size: 13px !important;
        line-height: 1.7 !important;
        font-weight: 500 !important;
        white-space: pre-line;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 900px) {

        .sic-fw-detalle {
            padding: 18px;
        }

        .sic-fw-cabecera {
            flex-direction: column;
        }

        .sic-fw-resumen {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .sic-fw-grid {
            grid-template-columns: 1fr;
        }

        .sic-fw-campo-completo {
            grid-column: auto;
        }
    }


    .sic-fw-evidencia-desglose {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
        margin-top: -5px;
        margin-bottom: 14px;
    }

    .sic-fw-evidencia-item {
        display: flex;
        align-items: center;
        gap: 9px;
        min-height: 58px;
        padding: 9px 11px;
        border: 1px solid #dce6df;
        border-radius: 8px;
        background: #fbfefc;
    }

        .sic-fw-evidencia-item > i {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 31px;
            min-width: 31px;
            height: 31px;
            border-radius: 50%;
            background: #e7f6eb;
            color: #368a4d;
            font-size: 12px;
        }

        .sic-fw-evidencia-item span {
            display: block;
            margin-bottom: 3px;
            color: #6e7b72;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .sic-fw-evidencia-item strong {
            display: block;
            color: #176b31;
            font-size: 15px;
            font-weight: 900;
        }

    @@media (max-width: 1100px) {
        .sic-fw-evidencia-desglose {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

</style>