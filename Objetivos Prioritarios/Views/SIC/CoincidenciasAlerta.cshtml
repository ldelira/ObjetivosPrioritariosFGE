@model System.Collections.ArrayList

@if (Model != null && Model.Count > 0)
{
    <div class="sic-coincidencias-alerta">

        @foreach (object elemento in Model)
        {
            object[] coincidencia =
                elemento as object[];

            if (coincidencia == null ||
                coincidencia.Length < 5)
            {
                continue;
            }

            int estatus = 0;
            int porcentaje = 0;
            int idTipoAlerta = 0;

            int.TryParse(
                Convert.ToString(coincidencia[1]),
                out estatus
            );

            int.TryParse(
                Convert.ToString(coincidencia[2]),
                out porcentaje
            );

            int.TryParse(
                Convert.ToString(coincidencia[3]),
                out idTipoAlerta
            );

            string nombreTipo =
                Convert.ToString(coincidencia[4]);

            if (string.IsNullOrWhiteSpace(nombreTipo))
            {
                nombreTipo =
                    "SIN TIPO DE ALERTA";
            }

            string claseEstatus =
 estatus == 2 || estatus == 3
     ? "sic-coincidencia-confirmada"
     : estatus == 0
         ? "sic-coincidencia-descartada"
         : "sic-coincidencia-pendiente";

            <span class="sic-porcentaje-coincidencia @claseEstatus"
                  data-id-tipo-alerta="@idTipoAlerta"
                  data-estatus="@estatus">

                <strong>
                    @(porcentaje)%
                </strong>

                <span>
                    de coincidencia en @nombreTipo
                </span>

            </span>
        }

    </div>
}