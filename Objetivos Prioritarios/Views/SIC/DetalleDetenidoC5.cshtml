<script>
    $(document).ready(function () {
        var titulo = $('.pagetitle h1').first();

        if (titulo.length > 0) {
            var contenedorTitulo = titulo.closest('.pagetitle');

            if (contenedorTitulo.length > 0) {
                contenedorTitulo.css({
                    'display': 'flex',
                    'align-items': 'center',
                    'justify-content': 'space-between',
                    'gap': '12px'
                });

                titulo.css({
                    'margin': '0'
                });

                if (contenedorTitulo.find('.sic-page-title-actions').length === 0) {
                    contenedorTitulo.append(
                        '<div class="sic-page-title-actions">' +
                            '<a href="@Url.Action("Index", "SIC")" class="sic-btn-light">' +
                                '<i class="fa fa-arrow-left"></i> Volver' +
                            '</a>' +
                        '</div>'
                    );
                }
            }
        }

        registrarEventosDetalleSic();
    });

    function registrarEventosDetalleSic() {
        var documento = $(document);

        /* Limpia cualquier registro anterior de estos mismos eventos. */
        documento.off('click', '.sic-source-tab');
        documento.off('click', '.sic-capea-next, .sic-capea-prev');
        documento.off('click', '.sic-detenidos-next');
        documento.off('click', '.sic-detenidos-prev');
        documento.off('click', '.js-confirmar-identidad-normal');
        documento.off('click', '.js-confirmar-identidad-detenido');
        documento.off('click', '.sic-btn-descartar-alerta');
        documento.off('click', '.sic-btn-descartar-alerta-detenidos');
        documento.off('click', '.sic-btn-reactivar-alerta');
        documento.off('click', '.sic-btn-reactivar-alerta-detenidos');

        documento.on('click.sicDetalle', '.sic-source-tab', function () {
            var tabId = $(this).data('tab');

            $('.sic-source-tab').removeClass('active');
            $(this).addClass('active');

            $('.sic-source-tab-content').removeClass('active');
            $('#' + tabId).addClass('active');
        });

        documento.on(
            'click.sicDetalle',
            '.sic-capea-next, .sic-capea-prev',
            function (e) {
                e.preventDefault();

                var boton = $(this);
                var carousel = boton.closest('.sic-capea-carousel');
                var slides = carousel.find('.sic-capea-slide');
                var total = slides.length;

                if (total <= 1) {
                    return;
                }

                var indice = slides.index(slides.filter('.active'));

                if (boton.hasClass('sic-capea-next')) {
                    indice++;
                } else {
                    indice--;
                }

                if (indice >= total) {
                    indice = 0;
                }

                if (indice < 0) {
                    indice = total - 1;
                }

                slides.removeClass('active');
                slides.eq(indice).addClass('active');

                carousel.find('.sic-capea-current').text(indice + 1);
            }
        );

        documento.on('click.sicDetalle', '.sic-detenidos-next', function (e) {
            e.preventDefault();
            moverCarruselDetenidos($(this), 1);
        });

        documento.on('click.sicDetalle', '.sic-detenidos-prev', function (e) {
            e.preventDefault();
            moverCarruselDetenidos($(this), -1);
        });

        documento.on(
            'click.sicDetalle',
            '.js-confirmar-identidad-normal',
            confirmarIdentidadNormal
        );

        documento.on(
            'click.sicDetalle',
            '.js-confirmar-identidad-detenido',
            confirmarIdentidadDetenido
        );

        documento.on(
            'click.sicDetalle',
            '.sic-btn-descartar-alerta',
            descartarCoincidenciaNormal
        );

        documento.on(
