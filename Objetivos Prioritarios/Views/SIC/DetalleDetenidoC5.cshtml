                                                nombreDetenido =
                                                    nombreDetenido.Trim();

                                                if (!idsNomPersoPorNombre.ContainsKey(nombreDetenido))
                                                {
                                                    idsNomPersoPorNombre.Add(
                                                        nombreDetenido,
                                                        idNomPerso
                                                    );
                                                }
                                            }
                                        }
                                    }
                                    catch
                                    {
                                        idsNomPersoPorNombre.Clear();
                                    }
                                }

                                var listaAliasObjetivo = new System.Collections.Generic.List<string>();

                                if (!string.IsNullOrWhiteSpace(aliasObjetivoTexto) &&
                                    aliasObjetivoTexto != "SIN ALIAS")
                                {
                                    listaAliasObjetivo = aliasObjetivoTexto
                                        .Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
                                        .Select(x => x.Trim())
                                        .Where(x => !string.IsNullOrWhiteSpace(x))
                                        .Distinct()
                                        .ToList();
                                }

                                <div class="sic-rel-card">

                                    <div class="sic-rel-photo-wrap">

