            + '<button type="button" class="sic-btn-descartada" disabled>'
            + '<i class="fa fa-times-circle"></i> Descartada'
            + '</button>'

            + '<button type="button"'
            + ' class="sic-btn-reactivar-alerta-detenidos"'
            + ' data-estatus-anterior="0"'
            + ' data-id-detenido="' + idDetenido + '"'
            + ' data-id-origen="' + idOrigen + '"'
            + ' data-id-tipo-alerta="' + idTipoAlerta + '">'
            + '<i class="fa fa-undo"></i> Cancelar Confirmación'
            + '</button>';
    }

    function desactivarOtrasCoincidenciasDetenidos(botonConfirmado, idDetenido) {
        var slideSeleccionado =
            botonConfirmado.closest('.sic-detenido-slide');

        $('#tab-fgea-detenidos .sic-detenido-slide')
            .each(function () {

                var slide =
                    $(this);

                /*
                 * La ficha que acabamos de confirmar
                 * NO se toca.
                 */
                if (slideSeleccionado.length > 0 &&
                    slide[0] === slideSeleccionado[0]) {
                    return;
                }

                var acciones =
                    slide.find('.sic-rel-actions').first();

                if (acciones.length === 0) {
                    return;
                }

                /*
                 * Tomamos los identificadores que ya tiene
                 * cualquiera de los botones de esa ficha.
                 */
                var botonDatos =
                    acciones
                        .find(
                            '[data-id-origen][data-id-tipo-alerta]'
                        )
                        .first();

                if (botonDatos.length === 0) {
                    return;
                }

                var idOrigen =
                    parseInt(
                        botonDatos.attr('data-id-origen'),
                        10
                    );

                var idTipoAlerta =
                    parseInt(
                        botonDatos.attr('data-id-tipo-alerta'),
                        10
                    );

                if (isNaN(idOrigen) ||
                    idOrigen <= 0 ||
                    isNaN(idTipoAlerta) ||
                    idTipoAlerta <= 0) {
                    return;
                }

                /*
                 * El service acaba de poner estas alertas
                 * en Estatus = 0.
                 *
                 * Reflejamos ese cambio también en pantalla.
                 */
                acciones.html(
                    htmlDescartadoDetenido(
                        idDetenido,
                        idOrigen,
                        idTipoAlerta
                    )
                );
            });
    }

    async function confirmarAccionSIC(
        titulo,
        mensaje,
        textoConfirmar,
        icono
    ) {
        var resultado = await Swal.fire({
            title: titulo,
            text: mensaje,
            icon: icono || 'question',

            showCancelButton: true,

            confirmButtonText: textoConfirmar,
            cancelButtonText: 'Cancelar',

            reverseButtons: true,
            allowOutsideClick: false,
            allowEscapeKey: true
        });

        return resultado.isConfirmed;
    }


    function mostrarMensajeSIC(
        titulo,
        mensaje,
        icono
    ) {
        return Swal.fire({
            title: titulo,
            text: mensaje,
            icon: icono || 'info',
            confirmButtonText: 'Aceptar',
            allowOutsideClick: false
        });
    }

    async function confirmarIdentidadNormal(e) {
    e.preventDefault();
    e.stopImmediatePropagation();

    var boton = $(this);

    var idDetenido =
        parseInt(
            boton.attr('data-id-detenido'),
            10
        );

    var idOrigen =
        parseInt(
            boton.attr('data-id-origen'),
            10
        );

    var idFuente =
        parseInt(
            boton.attr('data-id-fuente'),
            10
        );

    var idTipoAlerta =
        parseInt(
            boton.attr('data-id-tipo-alerta'),
            10
        );

    var esFusion =
        parseInt(
            boton.attr('data-es-fusion'),
            10
        ) === 1;

    if (isNaN(idDetenido) ||
        idDetenido <= 0 ||
        isNaN(idOrigen) ||
        idOrigen <= 0 ||
        isNaN(idFuente) ||
        idFuente <= 0 ||
        isNaN(idTipoAlerta) ||
        idTipoAlerta <= 0) {

        mostrarMensajeSIC(
            'Datos incompletos',
            'Faltan datos para confirmar la identidad.',
            'warning'
        );

        return;
    }

    var continuar = await confirmarAccionSIC(
        esFusion
            ? 'Fusionar registros'
            : 'Confirmar identidad',

        esFusion
            ? 'Se confirmará que ambos registros pertenecen a la misma persona. ¿Deseas continuar?'
            : '¿Seguro que deseas confirmar la identidad de este registro?',

        esFusion
            ? 'Sí, fusionar'
            : 'Sí, confirmar',

        'question'
    );

    if (!continuar) {
        return;
    }

    bloquearBoton(
        boton,
        esFusion
            ? 'Fusionando...'
            : 'Confirmando...'
    );

    $.ajax({
        url: '@Url.Action("ConfirmarIdentidad", "SIC")',
        type: 'POST',

