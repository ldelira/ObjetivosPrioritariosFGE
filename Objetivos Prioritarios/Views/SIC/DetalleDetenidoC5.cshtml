@model Objetivos_Prioritarios.Models.sp_BuscarDetenido_Result

@{
    ViewBag.Title = "Ficha del detenido en Municipio / Sistema de Identificación Criminal";

    string nombreCompleto = string.IsNullOrWhiteSpace(Model.Nombre) ? "SIN INFORMACIÓN" : Model.Nombre;
    string alias = string.IsNullOrWhiteSpace(Model.ALIAS) ? "SIN INFORMACIÓN" : Model.ALIAS;
    string folio = string.IsNullOrWhiteSpace(Model.Folio) ? "SIN INFORMACIÓN" : Model.Folio;
    string sexo = string.IsNullOrWhiteSpace(Model.SEXO) ? "SIN INFORMACIÓN" : Model.SEXO;
    string municipioDetencion = string.IsNullOrWhiteSpace(Model.MunicipioDetencion) ? "SIN INFORMACIÓN" : Model.MunicipioDetencion;
    string siglasMunicipio = string.IsNullOrWhiteSpace(Model.SiglasMunicipio) ? "SIN INFORMACIÓN" : Model.SiglasMunicipio;

    string idDetenido = Convert.ToString(Model.IDDETENIDO);
    string idDetencion = Convert.ToString(Model.IDDETENCION);
    string edad = Convert.ToString(Model.EDAD);

    string totalFotos = Convert.ToString(Model.TotalFotos);
    string totalHuellas = Convert.ToString(Model.TotalHuellas);
    string totalAlertas = Convert.ToString(Model.TotalRegistroAlertas);
    string totalRegistrosDetenido = Convert.ToString(Model.TotalRegistrosDetenido);

    idDetenido = string.IsNullOrWhiteSpace(idDetenido) ? "SIN INFORMACIÓN" : idDetenido;
    idDetencion = string.IsNullOrWhiteSpace(idDetencion) ? "SIN INFORMACIÓN" : idDetencion;
    edad = string.IsNullOrWhiteSpace(edad) ? "SIN INFORMACIÓN" : edad;

    totalFotos = string.IsNullOrWhiteSpace(totalFotos) ? "0" : totalFotos;
    totalHuellas = string.IsNullOrWhiteSpace(totalHuellas) ? "0" : totalHuellas;
    totalAlertas = string.IsNullOrWhiteSpace(totalAlertas) ? "0" : totalAlertas;
    totalRegistrosDetenido = string.IsNullOrWhiteSpace(totalRegistrosDetenido) ? "0" : totalRegistrosDetenido;

    string fotoPrincipalUrl = Url.Action("FotoDetenidoC5", "SIC", new { idDetenido = Model.IDDETENIDO });

    string fuente = "SIC / C5";
    string tipoAlerta = "Coincidencia activa";
    string estatus = "Coincidencia pendiente";

    string lugarDetencion = municipioDetencion;
    string fechaDetencion = "SIN INFORMACIÓN";
    string horaDetencion = "SIN INFORMACIÓN";
    string anio = "SIN INFORMACIÓN";

    string hecho = "SIN INFORMACIÓN";
    string causa = "SIN INFORMACIÓN";
    string aseguramiento = "SIN INFORMACIÓN";

    string latitud = "";
    string longitud = "";

    var capeas = ViewBag.Capeas as System.Collections.Generic.List<Objetivos_Prioritarios.Models.Capea_boletin_busqueda>
             ?? new System.Collections.Generic.List<Objetivos_Prioritarios.Models.Capea_boletin_busqueda>();
    var mandamientos = ViewBag.Mandamientos as System.Data.DataTable;

    var objetivosPrioritarios = ViewBag.ObjetivosPrioritarios as System.Data.DataTable
    ?? new System.Data.DataTable();

    var detenidos = ViewBag.Detenidos as System.Data.DataTable
        ?? new System.Data.DataTable();

    int fuenteCapea = ViewBag.FuenteCapea == null ? 0 : Convert.ToInt32(ViewBag.FuenteCapea);
    var detencionC5 = ViewBag.DetencionC5 as Objetivos_Prioritarios.Models.tb_DETENCION_C5;
    var datosDetenidoC5 = ViewBag.DatosDetenidoC5 as Objetivos_Prioritarios.Models.tb_DETENIDO_C5;

    var fotosC5 = ViewBag.FotosC5 as System.Collections.Generic.List<Objetivos_Prioritarios.Models.tb_FOTO_C5>
              ?? new System.Collections.Generic.List<Objetivos_Prioritarios.Models.tb_FOTO_C5>();

    var huellasC5 = ViewBag.HuellasC5 as System.Collections.Generic.List<Objetivos_Prioritarios.Models.tb_HUELLA_C5>
                ?? new System.Collections.Generic.List<Objetivos_Prioritarios.Models.tb_HUELLA_C5>();

    var rasgosC5 = ViewBag.RasgosC5 as System.Collections.Generic.List<Objetivos_Prioritarios.Models.tb_FOTO_C5>
               ?? new System.Collections.Generic.List<Objetivos_Prioritarios.Models.tb_FOTO_C5>();

    var alertasTipo = ViewBag.AlertasTipo as System.Collections.Generic.List<System.Tuple<int, int, int, int, int, string>>
               ?? new System.Collections.Generic.List<System.Tuple<int, int, int, int, int, string>>();

    var alertasPersonaInteres = ViewBag.AlertasPersonaInteres as System.Collections.Generic.List<System.Tuple<int, int, int, int, int, string>>
               ?? new System.Collections.Generic.List<System.Tuple<int, int, int, int, int, string>>();

    int totalAlertasActivas = ViewBag.TotalAlertasActivas == null
? 0
: Convert.ToInt32(ViewBag.TotalAlertasActivas);

    int totalAlertasRevisadas = ViewBag.TotalAlertasRevisadas == null
        ? 0
        : Convert.ToInt32(ViewBag.TotalAlertasRevisadas);

    int totalCoincidenciasConfirmadas =
    ViewBag.TotalCoincidenciasConfirmadas == null
        ? 0
        : Convert.ToInt32(ViewBag.TotalCoincidenciasConfirmadas);

    var tiposAlertas = ViewBag.TiposAlertas as System.Collections.Generic.List<System.Tuple<int, int>>
           ?? new System.Collections.Generic.List<System.Tuple<int, int>>();

    

}

