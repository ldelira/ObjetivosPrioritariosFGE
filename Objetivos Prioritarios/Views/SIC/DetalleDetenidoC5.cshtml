var urlDetenidosObjetivoModal =
    '@Url.Action("ObtenerDetenidosObjetivoModal", "SIC")';

$(document).on(
    'click',
    '.js-ver-detenidos-objetivo',
    function (event) {

        event.preventDefault();

        var idNomPerso = parseInt(
            $(this).attr('data-id-nom-perso'),
            10
        );

        var nombre = (
            $(this).attr('data-nombre') || ''
        ).toString().trim();

        if (isNaN(idNomPerso) || idNomPerso <= 0) {

            Swal.fire(
                'Sin información',
                'No se encontró el ID del nombre seleccionado.',
                'warning'
            );

            return;
        }

        var tituloModal =
            'Información del detenido';

        if (nombre !== '') {
            tituloModal += ' - ' + nombre;
        }

        $('#tituloModalDetenidosObjetivo')
            .text(tituloModal);

        $('#contenidoDetenidosObjetivo').html(
            '<div class="sic-modal-detenido-cargando">' +
                '<i class="fa fa-spinner fa-spin"></i>' +
                '<div>Cargando información...</div>' +
            '</div>'
        );

        $('#modalDetenidosObjetivo').modal('show');

        $.ajax({
            url: urlDetenidosObjetivoModal,
            type: 'GET',
            cache: false,
            data: {
                idNomPerso: idNomPerso
            },
            success: function (html) {

                $('#contenidoDetenidosObjetivo')
                    .html(html);
            },
            error: function (xhr) {

                var mensaje =
                    'No se pudo cargar la información del detenido.';

                if (
                    xhr &&
                    xhr.responseText
                ) {
                    mensaje = xhr.responseText;
                }

                var alerta = $('<div>')
                    .addClass('alert alert-warning')
                    .text(mensaje);

                $('#contenidoDetenidosObjetivo')
                    .empty()
                    .append(alerta);
            }
        });
    }
);

    function escaparTextoModal(valor) {

        return $('<div>')
            .text(
                valor === null ||
                    valor === undefined
                    ? ''
                    : valor.toString()
            )
            .html();

    }

    function mostrarDetenidoObjetivoModal(indice) {

        var $slides =
            $('#contenidoDetenidosObjetivo')
                .find('.sic-modal-detenido-slide');

        var total =
            $slides.length;

        if (total === 0) {
            return;
        }

        if (indice < 0) {
            indice =
                total - 1;
        }

        if (indice >= total) {
            indice =
                0;
        }

        $slides.removeClass(
            'active'
        );

        $slides.eq(indice).addClass(
            'active'
        );

        $('#contenidoDetenidosObjetivo')
            .find('.sic-modal-detenidos-current')
            .text(
                indice + 1
            );

        $('#contenidoDetenidosObjetivo')
            .data(
                'indice-detenido',
                indice
            );

    }


    $(document).on(
        'click',
        '.sic-modal-detenidos-prev',
        function () {

            var indiceActual =
                parseInt(
                    $('#contenidoDetenidosObjetivo')
                        .data('indice-detenido'),
                    10
                );

            if (isNaN(indiceActual)) {
                indiceActual = 0;
            }

            mostrarDetenidoObjetivoModal(
                indiceActual - 1
            );

        }
    );


    $(document).on(
        'click',
        '.sic-modal-detenidos-next',
        function () {

            var indiceActual =
                parseInt(
                    $('#contenidoDetenidosObjetivo')
                        .data('indice-detenido'),
                    10
                );

            if (isNaN(indiceActual)) {
                indiceActual = 0;
            }

            mostrarDetenidoObjetivoModal(
                indiceActual + 1
            );

        }
    );


    $(document).on(
        'click',
        '.js-cerrar-modal-detenido',
        function (event) {

            event.preventDefault();
            event.stopPropagation();

            var $modal =
                $('#modalDetenidosObjetivo');

            if (
                $.fn.modal &&
                typeof $modal.modal === 'function'
            ) {
                $modal.modal('hide');
                return;
            }

            var elementoModal =
                document.getElementById(
                    'modalDetenidosObjetivo'
                );

            if (
                window.bootstrap &&
                window.bootstrap.Modal &&
                elementoModal
            ) {
                var instancia =
                    window.bootstrap.Modal.getInstance(
                        elementoModal
                    );

                if (!instancia) {
                    instancia =
                        new window.bootstrap.Modal(
                            elementoModal
                        );
                }

                instancia.hide();
                return;
            }

            $modal
                .removeClass('show')
                .hide()
                .attr('aria-hidden', 'true');

            $('body')
                .removeClass('modal-open')
                .css('padding-right', '');

            $('.modal-backdrop').remove();
        }
    );

function abrirFotoExpandida(src, descripcion) {

        if (!src) {
            return;
        }

        $('#sicVisorFotoContenido')
            .removeClass('comparando');

        $('#sicVistaComparacion')
            .hide();

        $('#sicVistaFotoUnica')
            .show();

        $('#sicFotoExpandida')
            .css('display', 'block')
            .attr('src', src)
            .attr(
                'alt',
                descripcion || 'Fotografía ampliada'
            );

        $('#sicFotoExpandidaTexto')
            .text(
                descripcion || 'Fotografía del detenido'
            );

        $('#sicVisorFoto')
            .addClass('activo')
            .attr('aria-hidden', 'false');

        $('body').css('overflow', 'hidden');
    }


    function abrirComparacionFotos(
        srcFotoDetenido,
        descripcionDetenido
    ) {

        if (!srcFotoDetenido) {
            return;
        }

        var fotoPrincipal =
            document.getElementById(
                'sicFotoPrincipalC5'
            );

        var srcFotoPrincipal =
            fotoPrincipal
                ? fotoPrincipal.currentSrc ||
                fotoPrincipal.src
                : '';

        if (!srcFotoPrincipal) {

            abrirFotoExpandida(
                srcFotoDetenido,
                descripcionDetenido
            );

            return;
        }

        $('#sicVisorFotoContenido')
            .addClass('comparando');

        $('#sicVistaFotoUnica')
            .hide();

        $('#sicVistaComparacion')
            .css('display', 'grid');

        $('#sicFotoComparacionPrincipal')
            .css('display', 'block')
            .attr('src', srcFotoPrincipal)
            .attr(
                'alt',
                fotoPrincipal.alt ||
                'Fotografía del detenido en municipio'
            );

        $('#sicFotoComparacionDetenido')
            .css('display', 'block')
            .attr('src', srcFotoDetenido)
            .attr(
                'alt',
                descripcionDetenido ||
                'Fotografía del registro de detenidos FGEA'
            );

        $('#sicVisorFoto')
            .addClass('activo')
            .attr('aria-hidden', 'false');

        $('body').css('overflow', 'hidden');
    }


    function cerrarFotoExpandida() {

        var visor =
            document.getElementById('sicVisorFoto');

        var contenido =
            document.getElementById('sicVisorFotoContenido');

        var vistaComparacion =
            document.getElementById('sicVistaComparacion');

        var vistaFotoUnica =
            document.getElementById('sicVistaFotoUnica');

        var fotoExpandida =
            document.getElementById('sicFotoExpandida');

        var fotoPrincipal =
            document.getElementById('sicFotoComparacionPrincipal');

        var fotoDetenido =
            document.getElementById('sicFotoComparacionDetenido');


        if (visor) {
            visor.classList.remove('activo');
            visor.setAttribute('aria-hidden', 'true');
        }

        if (contenido) {
            contenido.classList.remove('comparando');
        }

        if (vistaComparacion) {
            vistaComparacion.style.display = 'none';
        }

        if (vistaFotoUnica) {
            vistaFotoUnica.style.display = 'block';
        }

        if (fotoExpandida) {
            fotoExpandida.removeAttribute('src');
        }

        if (fotoPrincipal) {
            fotoPrincipal.removeAttribute('src');
        }

        if (fotoDetenido) {
            fotoDetenido.removeAttribute('src');
        }

        document.body.style.overflow = '';
    }



    function cerrarFotoExpandidaAlFondo(event) {

        if (
            event &&
            event.target &&
            event.target.id === 'sicVisorFoto'
        ) {
            cerrarFotoExpandida();
        }
    }

var sicGaleriasEstado = {};

function obtenerFotosGaleriaSic(grupo) {
    var elementos = document.querySelectorAll(
        '.sic-gallery-item-expandible[data-galeria="' + grupo + '"]'
    );

    var fotos = [];

    elementos.forEach(function (elemento) {
        var imagen = elemento.querySelector('.sic-gallery-foto');
        var descripcion = elemento.querySelector('.sic-gallery-caption span');

        if (!imagen) {
            return;
        }

        var src = imagen.currentSrc || imagen.src || '';

        if (!src) {
            return;
        }

        fotos.push({
            src: src,
            descripcion: descripcion
                ? descripcion.textContent.trim()
                : 'Imagen'
        });
    });

    return fotos;
}

function abrirGaleriaSic(grupo, visorId, indice, titulo) {
    var fotos = obtenerFotosGaleriaSic(grupo);

    if (fotos.length === 0) {
        return;
    }

    var indiceActual = parseInt(indice, 10);

    if (isNaN(indiceActual) || indiceActual < 0) {
        indiceActual = 0;
    }

    if (indiceActual >= fotos.length) {
        indiceActual = fotos.length - 1;
    }

    sicGaleriasEstado[visorId] = {
        fotos: fotos,
        indice: indiceActual,
        titulo: titulo || 'Galería'
    };

    mostrarImagenGaleriaSic(visorId);

    var visor = document.getElementById(visorId);

    if (visor) {
        visor.classList.add('activo');
        visor.setAttribute('aria-hidden', 'false');
    }

    document.body.style.overflow = 'hidden';
}

function mostrarImagenGaleriaSic(visorId) {
    var estado = sicGaleriasEstado[visorId];
    var visor = document.getElementById(visorId);

    if (!estado || !visor || estado.fotos.length === 0) {
        return;
    }

    var foto = estado.fotos[estado.indice];
    var titulo = visor.querySelector('[data-sic-galeria-titulo]');
    var imagen = visor.querySelector('[data-sic-galeria-imagen]');
    var error = visor.querySelector('[data-sic-galeria-error]');
    var descripcion = visor.querySelector('[data-sic-galeria-descripcion]');
    var contador = visor.querySelector('[data-sic-galeria-contador]');
    var anterior = visor.querySelector('[data-sic-galeria-anterior]');
    var siguiente = visor.querySelector('[data-sic-galeria-siguiente]');

    if (titulo) {
        titulo.textContent = estado.titulo;
    }

    if (error) {
        error.style.display = 'none';
    }

    if (imagen) {
        imagen.style.display = 'block';

        imagen.onerror = function () {
            imagen.style.display = 'none';

            if (error) {
                error.style.display = 'flex';
            }
        };

        imagen.src = foto.src;
        imagen.alt = foto.descripcion || 'Imagen ampliada';
    }

    if (descripcion) {
        descripcion.textContent = foto.descripcion || 'Imagen';
    }

    if (contador) {
        contador.textContent =
            (estado.indice + 1) + ' / ' + estado.fotos.length;
    }

    var hayVarias = estado.fotos.length > 1;

    if (anterior) {
        anterior.style.display = hayVarias ? 'flex' : 'none';
    }

    if (siguiente) {
        siguiente.style.display = hayVarias ? 'flex' : 'none';
    }
}

function navegarGaleriaSic(visorId, direccion) {
    var estado = sicGaleriasEstado[visorId];

    if (!estado || estado.fotos.length <= 1) {
        return;
    }

    estado.indice += direccion;

    if (estado.indice >= estado.fotos.length) {
        estado.indice = 0;
    }

    if (estado.indice < 0) {
        estado.indice = estado.fotos.length - 1;
    }

    mostrarImagenGaleriaSic(visorId);
}

function cerrarGaleriaSic(visorId) {
    var visor = document.getElementById(visorId);

    if (!visor) {
        return;
    }

    visor.classList.remove('activo');
    visor.setAttribute('aria-hidden', 'true');

    var imagen = visor.querySelector('[data-sic-galeria-imagen]');

    if (imagen) {
        imagen.removeAttribute('src');
    }

    document.body.style.overflow = '';
}

function cerrarGaleriaSicAlFondo(event, visorId) {
    if (event && event.target && event.target.id === visorId) {
        cerrarGaleriaSic(visorId);
    }
}

function mostrarErrorFotoGaleria(imagen) {
    if (!imagen) {
        return;
    }

    imagen.onerror = null;
    imagen.style.display = 'none';

    var contenedor = imagen.parentElement;

    if (!contenedor) {
        return;
    }

    var error = contenedor.querySelector('.sic-gallery-image-error');
    var zoom = contenedor.querySelector('.sic-gallery-zoom');

    if (error) {
        error.style.display = 'flex';
    }

    if (zoom) {
        zoom.style.display = 'none';
    }
}

document.addEventListener('keydown', function (event) {
    var visorFoto = document.getElementById('sicVisorFoto');

    if (
        event.key === 'Escape' &&
        visorFoto &&
        visorFoto.classList.contains('activo')
    ) {
        cerrarFotoExpandida();
        return;
    }

    var visorGaleria = document.querySelector('.sic-galeria-visor.activo');

    if (!visorGaleria) {
        return;
    }

    if (event.key === 'Escape') {
        cerrarGaleriaSic(visorGaleria.id);
        return;
    }

    if (event.key === 'ArrowLeft') {
        navegarGaleriaSic(visorGaleria.id, -1);
        return;
    }

    if (event.key === 'ArrowRight') {
        navegarGaleriaSic(visorGaleria.id, 1);
    }
});

$(document)
    .off('click.sicResguardoFgea', '.js-resguardo-fgea')
    .on(
        'click.sicResguardoFgea',
        '.js-resguardo-fgea',
        async function (e) {

            e.preventDefault();
            e.stopImmediatePropagation();

            var boton = $(this);

            var idDetenido =
                boton.data('id-detenido');

            var idOrigen =
                boton.data('id-origen');

            var idFuente =
                boton.data('id-fuente');

            var idTipoAlerta =
                parseInt(
                    boton.attr('data-id-tipo-alerta'),
                    10
                );

            if (!idDetenido ||
                !idOrigen ||
                !idFuente ||
                isNaN(idTipoAlerta) ||
                idTipoAlerta <= 0) {

                mostrarMensajeSIC(
                    'Datos incompletos',
                    'Faltan datos para enviar el registro a Resguardo FGEA.',
                    'warning'
                );

                return;
            }


            var continuar =
                await confirmarAccionSIC(
                    'Resguardo FGEA',
                    '¿Seguro que deseas poner este registro en Resguardo FGEA?',
                    'Sí, enviar a resguardo',
                    'question'
                );


            if (!continuar) {
                return;
            }


            bloquearBoton(
                boton,
                'Procesando...'
            );


            $.ajax({

                url:
                    '@Url.Action("ResguardoFGEA", "SIC")',

                type: 'POST',

                data: {
                    idDetenido: idDetenido,
                    idOrigen: idOrigen,
                    idFuente: idFuente,
                    idTipoAlerta: idTipoAlerta
                },

                success: function (response) {

                    if (!response.success) {

                        boton
                            .prop('disabled', false)
                            .html(
                                '<i class="fa fa-shield"></i> En Resguardo FGEA'
                            );

                        mostrarMensajeSIC(
                            'No se pudo actualizar',
                            response.message ||
                            'No se pudo enviar el registro a Resguardo FGEA.',
                            'error'
                        );

                        return;
                    }


                    boton.closest('.sic-rel-actions')
                        .html(
                            htmlResguardoFGEA(
                                idDetenido,
                                idOrigen,
                                idFuente,
                                idTipoAlerta
                            )
                        );


                    actualizarPildoraEstadoIdentidad(
                        idDetenido
                    );


                    mostrarMensajeSIC(
                        'Resguardo FGEA',
                        response.message ||
                        'El registro fue puesto en Resguardo FGEA.',
                        'success'
                    );
                },

                error: function (xhr) {

                    console.log(
                        xhr.responseText
                    );

                    boton
                        .prop('disabled', false)
                        .html(
                            '<i class="fa fa-shield"></i> En Resguardo FGEA'
                        );

                    mostrarMensajeSIC(
                        'Error',
                        'Ocurrió un error al enviar el registro a Resguardo FGEA.',
                        'error'
                    );
                }

            });
        }
    );




</script>

