                'warning'
            );

            return;
        }

        var continuar = await confirmarAccionSIC(
            'Confirmar identidad',
            '¿Seguro que deseas confirmar la identidad de este registro?',
            'Sí, confirmar',
            'question'
        );

        if (!continuar) {
            return;
        }

        bloquearBoton(
            boton,
            'Confirmando...'
        );

        $.ajax({
            url: '@Url.Action("ConfirmarIdentidad", "SIC")',
            type: 'POST',
            data: {
                idDetenido: idDetenido,
                idOrigen: idOrigen,
                idFuente: idFuente
