    function actualizarContadoresAlertas(
        cambioActivas,
        cambioRevisadas,
        cambioConfirmadas
    ) {
        var activas =
            parseInt($('#contadorAlertasActivas').text(), 10) || 0;

        var revisadas =
            parseInt($('#contadorAlertasRevisadas').text(), 10) || 0;

        var confirmadas =
            parseInt($('#contadorCoincidenciasConfirmadas').text(), 10) || 0;

        cambioActivas =
            typeof cambioActivas === 'number' ? cambioActivas : 0;

        cambioRevisadas =
            typeof cambioRevisadas === 'number' ? cambioRevisadas : 0;

        cambioConfirmadas =
            typeof cambioConfirmadas === 'number' ? cambioConfirmadas : 0;

        activas = Math.max(0, activas + cambioActivas);
        revisadas = Math.max(0, revisadas + cambioRevisadas);
        confirmadas = Math.max(0, confirmadas + cambioConfirmadas);

        $('#contadorAlertasActivas').text(activas);
        $('#contadorAlertasRevisadas').text(revisadas);
        $('#contadorCoincidenciasConfirmadas').text(confirmadas);
        $('#pillAlertasActivas').text(activas);
    }

