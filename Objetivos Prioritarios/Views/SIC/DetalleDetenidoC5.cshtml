                            <path d="M12 2a8 8 0 0 0-8 8c0 1.46.3 2.7.68 3.82.2.58.83.89 1.41.69.58-.2.89-.83.69-1.41A9.65 9.65 0 0 1 6 10a6 6 0 0 1 12 0c0 3.56-1.05 6.54-2.7 9.22a1 1 0 0 0 1.7 1.06C18.84 17.3 20 13.93 20 10a8 8 0 0 0-8-8Z"></path>

                            <path d="M12 6a4 4 0 0 0-4 4c0 2.92-.69 5.32-1.86 7.48a1 1 0 1 0 1.76.96C9.22 16 10 13.24 10 10a2 2 0 0 1 4 0c0 4.5-1.22 8.15-3.36 11.32a1 1 0 1 0 1.66 1.12C14.66 18.95 16 14.9 16 10a4 4 0 0 0-4-4Z"></path>

                            <path d="M12 9a1 1 0 0 0-1 1c0 3.47-.84 6.28-2.34 8.7a1 1 0 1 0 1.7 1.06C12.06 17.03 13 13.83 13 10a1 1 0 0 0-1-1Z"></path>

                        </svg>
                    </div>

                    <div class="sic-hero-counter-texto">
                        <label>Coincidencia huella</label>
                        <strong>@ViewBag.TotalCoincidenciaHuella</strong>
                    </div>
                </div>

                <div class="sic-hero-counter sic-counter-fotos-municipio">
                    <div class="sic-hero-counter-icon">
                        <i class="fa fa-picture-o"></i>
                    </div>
                    <div class="sic-hero-counter-texto">
                        <label>Fotos en municipio</label>
                        <strong>@totalFotos</strong>
                    </div>
                </div>

                <div class="sic-hero-counter sic-counter-huellas-municipio">
                    <div class="sic-hero-counter-icon">
                        <i class="fa fa-hand-paper-o"></i>
                    </div>
                    <div class="sic-hero-counter-texto">
                        <label>Huellas en municipio</label>
                        <strong>@totalHuellas</strong>
                    </div>
                </div>

            </div>

        </div>
    </div>

