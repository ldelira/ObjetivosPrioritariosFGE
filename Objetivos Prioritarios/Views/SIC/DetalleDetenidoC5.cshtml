    <div class="sic-hero">
        <div class="sic-hero-content">

            <div class="sic-photo-main-wrap">
                <div class="sic-photo-main sic-photo-placeholder-wrap">
                    @if (!string.IsNullOrWhiteSpace(fotoPrincipalUrl))
                    {
                        <img src="@fotoPrincipalUrl"
                             alt="Foto de frente detenido en Municipio"
                             onerror="mostrarFotoNoExiste(this);" />
                    }
                    else
                    {
                        <div class="sic-photo-no-existe">
                            <i class="fa fa-user"></i>
                            <span>NO EXISTE FOTO EN ARCHIVO</span>
                        </div>
                    }
                </div>
            </div>

