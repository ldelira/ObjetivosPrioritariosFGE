                                         alt="@Texto(rasgo.TIPO)"
                                         onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=&quot;fa fa-picture-o&quot;></i>';" />

                                    <div class="sic-gallery-caption">
                                        <span>@Texto(rasgo.TIPO)</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="sic-empty-source">
                            <i class="fa fa-picture-o"></i>
                            <strong>Rasgos en Municipio</strong>
                            <span>Sin rasgos registrados por el momento.</span>
                        </div>
                    }

                </div>

            </div>
        </div>
    </div>

</div>

    <script>
    $(document).ready(function () {
        var titulo = $('.pagetitle h1').first();

        if (titulo.length === 0) {
            return;
        }

        var contenedorTitulo = titulo.closest('.pagetitle');

        if (contenedorTitulo.length === 0) {
            return;
        }

        contenedorTitulo.css({
            'display': 'flex',
            'align-items': 'center',
            'justify-content': 'space-between',
            'gap': '12px'
        });

        titulo.css({
            'margin': '0'
        });

        if (contenedorTitulo.find('.sic-page-title-actions').length > 0) {
            return;
        }

        contenedorTitulo.append(`
            <div class="sic-page-title-actions">
                <a href="@Url.Action("Index", "SIC")" class="sic-btn-light">
                    <i class="fa fa-arrow-left"></i>
                    Volver
                </a>

                <button type="button" class="sic-btn-warning-soft">
                    <i class="fa fa-bell-slash"></i>
                    Apagar notificación
                </button>
            </div>
        `);
    });

    $(document).on('click', '.sic-source-tab', function () {
        var tabId = $(this).data('tab');

        $('.sic-source-tab').removeClass('active');
        $(this).addClass('active');

        $('.sic-source-tab-content').removeClass('active');
        $('#' + tabId).addClass('active');
    });

    $(document).on('click', '.sic-capea-next, .sic-capea-prev', function (e) {
        e.preventDefault();

        var carousel = $(this).closest('.sic-capea-carousel');
        var slides = carousel.find('.sic-capea-slide');
        var total = slides.length;

        if (total <= 1) {
            return;
        }

        var active = slides.filter('.active');
        var index = active.index();

        if ($(this).hasClass('sic-capea-next')) {
            index++;
        } else {
            index--;
        }

        if (index >= total) {
            index = 0;
        }

        if (index < 0) {
            index = total - 1;
        }

        slides.removeClass('active');
        slides.eq(index).addClass('active');

        carousel.find('.sic-capea-current').text(index + 1);
    });


    $(document).on('click', '.sic-btn-apagar-alerta', function () {
        var boton = $(this);

        var idDetenido = boton.data('id-detenido');
        var idOrigen = boton.data('id-origen');
        var idFuente = boton.data('id-fuente');

        if (!confirm('¿Seguro que deseas apagar esta notificación?')) {
            return;
        }

        boton.prop('disabled', true);
        boton.html('<i class="fa fa-spinner fa-spin"></i> Apagando...');

        var idDetenido = boton.data('id-detenido');
        var idOrigen = boton.data('id-origen');
        var idFuente = boton.data('id-fuente');

        console.log('Mandando:', {
            idDetenido: idDetenido,
            idOrigen: idOrigen,
            idFuente: idFuente
        });

        if (!idDetenido || !idOrigen || !idFuente) {
            alert('Faltan datos para apagar la notificación. Revisa data-id-detenido, data-id-origen o data-id-fuente.');
            return;
        }

        $.ajax({
            url: '@Url.Action("ApagarNotificacion", "SIC")',
            type: 'POST',
            data: {
                idDetenido: idDetenido,
                idOrigen: idOrigen,
                idFuente: idFuente
            },
            success: function (resp) {
                if (resp.success) {
                    boton.removeClass('sic-btn-warning-soft sic-btn-apagar-alerta');
                    boton.addClass('sic-btn-alerta-desactivada');
                    boton.html('<i class="fa fa-check-circle"></i> Alerta desactivada');
                    boton.prop('disabled', true);
                    actualizarContadoresAlertas(-1, 1);
                } else {
                    alert(resp.message);

                    boton.prop('disabled', false);
                    boton.html('<i class="fa fa-bell-slash"></i> Apagar notificación');
                }
            },
            error: function (xhr) {
                console.log(xhr.responseText);
                alert('Error del servidor. Revisa la consola.');

                boton.prop('disabled', false);
                boton.html('<i class="fa fa-bell-slash"></i> Apagar notificación');
            }
        });
    });


    $(document).on('click', '.sic-btn-reactivar-alerta', function () {
    var boton = $(this);

    var idDetenido = boton.data('id-detenido');
    var idOrigen = boton.data('id-origen');
    var idFuente = boton.data('id-fuente');

    if (!confirm('¿Seguro que deseas reactivar esta notificación?')) {
        return;
    }

    boton.prop('disabled', true);
    boton.html('<i class="fa fa-spinner fa-spin"></i> Alerta desactivada');

    $.ajax({
        url: '@Url.Action("ReactivarNotificacion", "SIC")',
        type: 'POST',
        data: {
            idDetenido: idDetenido,
            idOrigen: idOrigen,
            idFuente: idFuente
        },
        success: function (resp) {
            if (resp.success) {
                boton.removeClass('sic-btn-alerta-desactivada sic-btn-reactivar-alerta');
                boton.addClass('sic-btn-warning-soft sic-btn-apagar-alerta');

                boton.html('<i class="fa fa-bell-slash"></i> Apagar notificación');
                boton.prop('disabled', false);

                actualizarContadoresAlertas(1, -1);
            } else {
                alert(resp.message);

                boton.prop('disabled', false);
                boton.html('<i class="fa fa-check-circle"></i> Alerta desactivada');
            }
        },
        error: function (xhr) {
            console.log(xhr.responseText);
            alert('Error del servidor. Revisa la consola.');

            boton.prop('disabled', false);
            boton.html('<i class="fa fa-check-circle"></i> Alerta desactivada');
        }
    });
    });

        function actualizarContadoresAlertas(cambioActivas, cambioRevisadas) {
            var activas = parseInt($('#contadorAlertasActivas').text()) || 0;
            var revisadas = parseInt($('#contadorAlertasRevisadas').text()) || 0;

            activas = activas + cambioActivas;
            revisadas = revisadas + cambioRevisadas;

            if (activas < 0) {
                activas = 0;
            }

            if (revisadas < 0) {
                revisadas = 0;
            }

            $('#contadorAlertasActivas').text(activas);
            $('#contadorAlertasRevisadas').text(revisadas);
            $('#pillAlertasActivas').text(activas);
        }
    function mostrarFotoNoExiste(img) {
        var contenedor = img.parentElement;

        img.style.display = 'none';

        contenedor.innerHTML = `
            <div class="sic-photo-no-existe">
                <i class="fa fa-user"></i>
                <span>NO EXISTE FOTO EN ARCHIVO</span>
            </div>
        `;
    }

    </script>