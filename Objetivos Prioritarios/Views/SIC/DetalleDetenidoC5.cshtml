            + '<button type="button"'
            + ' class="sic-btn-reactivar-alerta"'
            + ' data-estatus-anterior="2"'
            + ' data-id-detenido="' + idDetenido + '"'
            + ' data-id-origen="' + idOrigen + '"'
            + ' data-id-fuente="' + idFuente + '"'
            + ' data-id-tipo-alerta="' + idTipoAlerta + '">'
            + '<i class="fa fa-undo"></i> Cancelar Confirmación'
            + '</button>';
    }

    function htmlResguardoFGEA(idDetenido, idOrigen, idFuente, idTipoAlerta) {
        return ''
            + '<button type="button"'
            + ' class="sic-btn-resguardo-confirmado"'
            + ' disabled>'
