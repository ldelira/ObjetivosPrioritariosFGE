            + ' data-id-tipo-alerta="' + idTipoAlerta + '">'
            + '<i class="fa fa-undo"></i> Cancelar Resguardo'
            + '</button>';
    }

    function htmlDescartadoNormal(idDetenido, idOrigen, idFuente, idTipoAlerta) {
        return ''
            + '<button type="button" class="sic-btn-descartada" disabled>'
            + '<i class="fa fa-times-circle"></i> Descartada'
            + '</button>'

            + '<button type="button"'
            + ' class="sic-btn-reactivar-alerta"'
            + ' data-estatus-anterior="0"'
            + ' data-id-detenido="' + idDetenido + '"'
            + ' data-id-origen="' + idOrigen + '"'
            + ' data-id-fuente="' + idFuente + '"'
            + ' data-id-tipo-alerta="' + idTipoAlerta + '">'
            + '<i class="fa fa-undo"></i> Cancelar Confirmación'
            + '</button>';
    }

    function htmlPendienteDetenido(idDetenido, idOrigen, idTipoAlerta) {
        return ''
            + '<button type="button"'
            + ' class="sic-btn-confirmar-identidad js-confirmar-identidad-detenido"'
            + ' data-id-detenido="' + idDetenido + '"'
            + ' data-id-origen="' + idOrigen + '"'
            + ' data-id-tipo-alerta="' + idTipoAlerta + '">'
            + '<i class="fa fa-check"></i> Confirmar identidad'
            + '</button>'

            + '<button type="button"'
            + ' class="sic-btn-warning-soft sic-btn-descartar-alerta-detenidos"'
            + ' data-id-detenido="' + idDetenido + '"'
            + ' data-id-origen="' + idOrigen + '"'
            + ' data-id-tipo-alerta="' + idTipoAlerta + '">'
            + '<i class="fa fa-times"></i> Descartar'
            + '</button>';
    }

    function htmlConfirmadoDetenido(idDetenido, idOrigen, idTipoAlerta) {
        return ''
            + '<button type="button" class="sic-btn-identidad-confirmada" disabled>'
