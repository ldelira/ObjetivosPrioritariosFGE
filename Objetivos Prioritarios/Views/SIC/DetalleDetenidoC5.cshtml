    function actualizarPildoraEstadoIdentidad(idDetenido) {

    var $pillIdentidad =
        $('#pillEstadoIdentidad');

    var $textoIdentidad =
        $('#textoEstadoIdentidad');

    var $iconoIdentidad =
        $('#iconoEstadoIdentidad');

        var $globoInteres =
            $('#globoPersonaInteres');

    if (
        $pillIdentidad.length === 0 ||
        !idDetenido
    ) {
        return;
    }

    /* Estado temporal mientras se consulta */

    $pillIdentidad
        .removeClass(
            'sic-pill-identidad-pendiente ' +
            'sic-pill-identidad-confirmada'
        )
        .addClass(
            'sic-pill-identidad-cargando'
        );

    $textoIdentidad.text(
        'Comprobando estado...'
    );

    $iconoIdentidad.attr(
        'class',
        'fa fa-spinner fa-spin'
    );

    $.ajax({
        url: '@Url.Action("ObtenerEstadoIdentidad", "SIC")',
        type: 'GET',
        cache: false,

        data: {
            idDetenido: idDetenido
        },

        success: function (response) {

            if (
                !response ||
                response.success !== true
            ) {
                aplicarErrorEstadoIdentidad();
                return;
            }

            var codigo =
                parseInt(
                    response.codigo,
                    10
                );

            if (isNaN(codigo)) {
                codigo = 0;
            }

            var identidadConfirmada =
                codigo === 1 ||
                codigo === 2;

            var esDeInteres =
                codigo === 2;

            /* =========================================
               PÍLDORA 1: IDENTIDAD
               ========================================= */

            $pillIdentidad
                .removeClass(
                    'sic-pill-identidad-cargando ' +
                    'sic-pill-identidad-pendiente ' +
                    'sic-pill-identidad-confirmada'
                )
                .addClass(
                    identidadConfirmada
                        ? 'sic-pill-identidad-confirmada'
                        : 'sic-pill-identidad-pendiente'
                )
                .attr(
                    'data-estado',
                    codigo
                )
                .attr(
                    'title',
                    response.detalle || ''
                );

            $textoIdentidad.text(
                identidadConfirmada
                    ? 'Identidad confirmada'
                    : 'Sin confirmar'
            );

            $iconoIdentidad.attr(
                'class',
                identidadConfirmada
                    ? 'fa fa-check-circle'
                    : 'fa fa-question-circle'
            );

            /* =========================================
               PÍLDORA 2: PERSONA DE INTERÉS
               Solo aparece con código 2
               ========================================= */

            /* =========================================
   GLOBO FLOTANTE DE INTERÉS
   Código 2 = de interés
   ========================================= */

            if (esDeInteres) {

                $globoInteres.attr(
                    'title',
                    response.detalle ||
                    'La identidad fue confirmada en una fuente de interés.'
                );

                if (!$globoInteres.is(':visible')) {

                    $globoInteres
                        .stop(true, true)
                        .css('display', 'flex')
                        .hide()
                        .fadeIn(250);

                }

            } else {

                if ($globoInteres.is(':visible')) {

                    $globoInteres
                        .stop(true, true)
                        .fadeOut(200);

                }

            }
        },

        error: function (xhr) {

            console.log(
                'Error al actualizar el estado de identidad:',
                xhr.responseText
            );

            aplicarErrorEstadoIdentidad();
        }
    });

    function aplicarErrorEstadoIdentidad() {

        $pillIdentidad
            .removeClass(
                'sic-pill-identidad-cargando ' +
                'sic-pill-identidad-confirmada'
            )
            .addClass(
                'sic-pill-identidad-pendiente'
            );

        $textoIdentidad.text(
            'Estado no comprobado'
        );

        $iconoIdentidad.attr(
            'class',
            'fa fa-exclamation-triangle'
        );
    }
}


    function actualizarContadoresAlReabrir(estatusAnterior) {
        if (estatusAnterior === 2) {
            actualizarContadoresAlertas(1, 0, -1);
            return;
        }

        if (estatusAnterior === 0) {
            actualizarContadoresAlertas(1, -1, 0);
        }
    }

    function actualizarContadoresAlertas(
        cambioActivas,
        cambioRevisadas,
        cambioConfirmadas
    ) {
        var activas =
            parseInt($('#contadorAlertasActivas').text(), 10) || 0;

        var revisadas =
            parseInt($('#contadorAlertasDescartadas').text(), 10) || 0;

        var confirmadas =
            parseInt($('#contadorCoincidenciasConfirmadas').text(), 10) || 0;

        cambioActivas =
            typeof cambioActivas === 'number' ? cambioActivas : 0;

        cambioRevisadas =
            typeof cambioRevisadas === 'number' ? cambioRevisadas : 0;

        cambioConfirmadas =
            typeof cambioConfirmadas === 'number' ? cambioConfirmadas : 0;

        activas = Math.max(0, activas + cambioActivas);
        revisadas = Math.max(0, revisadas + cambioRevisadas);
        confirmadas = Math.max(0, confirmadas + cambioConfirmadas);

        $('#contadorAlertasActivas').text(activas);
        $('#contadorAlertasDescartadas').text(revisadas);
        $('#contadorCoincidenciasConfirmadas').text(confirmadas);
    }

    function bloquearBoton(boton, texto) {
        boton
            .prop('disabled', true)
            .html('<i class="fa fa-spinner fa-spin"></i> ' + texto);
    }

    function restaurarBotonConfirmar(boton) {
        boton
