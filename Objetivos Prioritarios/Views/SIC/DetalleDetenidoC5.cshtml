var sicGaleriasEstado = {};

function obtenerFotosGaleriaSic(grupo) {
    var elementos = document.querySelectorAll(
        '.sic-gallery-item-expandible[data-galeria="' + grupo + '"]'
    );

    var fotos = [];

    elementos.forEach(function (elemento) {
        var imagen = elemento.querySelector('.sic-gallery-foto');
        var descripcion = elemento.querySelector('.sic-gallery-caption span');

        if (!imagen) {
            return;
        }

        var src = imagen.currentSrc || imagen.src || '';

        if (!src) {
            return;
        }

        fotos.push({
            src: src,
            descripcion: descripcion
                ? descripcion.textContent.trim()
                : 'Imagen'
        });
    });

    return fotos;
}

function abrirGaleriaSic(grupo, visorId, indice, titulo) {
    var fotos = obtenerFotosGaleriaSic(grupo);

    if (fotos.length === 0) {
        return;
    }

    var indiceActual = parseInt(indice, 10);

    if (isNaN(indiceActual) || indiceActual < 0) {
        indiceActual = 0;
    }

    if (indiceActual >= fotos.length) {
        indiceActual = fotos.length - 1;
    }

    sicGaleriasEstado[visorId] = {
        fotos: fotos,
        indice: indiceActual,
        titulo: titulo || 'Galería'
    };

    mostrarImagenGaleriaSic(visorId);

    var visor = document.getElementById(visorId);

    if (visor) {
        visor.classList.add('activo');
        visor.setAttribute('aria-hidden', 'false');
    }

    document.body.style.overflow = 'hidden';
}

function mostrarImagenGaleriaSic(visorId) {
    var estado = sicGaleriasEstado[visorId];
    var visor = document.getElementById(visorId);

    if (!estado || !visor || estado.fotos.length === 0) {
        return;
    }

    var foto = estado.fotos[estado.indice];
    var titulo = visor.querySelector('[data-sic-galeria-titulo]');
    var imagen = visor.querySelector('[data-sic-galeria-imagen]');
    var error = visor.querySelector('[data-sic-galeria-error]');
    var descripcion = visor.querySelector('[data-sic-galeria-descripcion]');
    var contador = visor.querySelector('[data-sic-galeria-contador]');
    var anterior = visor.querySelector('[data-sic-galeria-anterior]');
    var siguiente = visor.querySelector('[data-sic-galeria-siguiente]');

    if (titulo) {
        titulo.textContent = estado.titulo;
    }

    if (error) {
        error.style.display = 'none';
    }

    if (imagen) {
        imagen.style.display = 'block';

        imagen.onerror = function () {
            imagen.style.display = 'none';

            if (error) {
                error.style.display = 'flex';
            }
        };

        imagen.src = foto.src;
        imagen.alt = foto.descripcion || 'Imagen ampliada';
    }

    if (descripcion) {
        descripcion.textContent = foto.descripcion || 'Imagen';
    }

    if (contador) {
        contador.textContent =
            (estado.indice + 1) + ' / ' + estado.fotos.length;
    }

    var hayVarias = estado.fotos.length > 1;

    if (anterior) {
        anterior.style.display = hayVarias ? 'flex' : 'none';
    }

    if (siguiente) {
        siguiente.style.display = hayVarias ? 'flex' : 'none';
    }
}

function navegarGaleriaSic(visorId, direccion) {
    var estado = sicGaleriasEstado[visorId];

    if (!estado || estado.fotos.length <= 1) {
        return;
    }

    estado.indice += direccion;

    if (estado.indice >= estado.fotos.length) {
        estado.indice = 0;
    }

    if (estado.indice < 0) {
        estado.indice = estado.fotos.length - 1;
    }

    mostrarImagenGaleriaSic(visorId);
}

function cerrarGaleriaSic(visorId) {
    var visor = document.getElementById(visorId);

    if (!visor) {
        return;
    }

    visor.classList.remove('activo');
    visor.setAttribute('aria-hidden', 'true');

    var imagen = visor.querySelector('[data-sic-galeria-imagen]');

    if (imagen) {
        imagen.removeAttribute('src');
    }

    document.body.style.overflow = '';
}

function cerrarGaleriaSicAlFondo(event, visorId) {
    if (event && event.target && event.target.id === visorId) {
        cerrarGaleriaSic(visorId);
    }
}

function mostrarErrorFotoGaleria(imagen) {
    if (!imagen) {
        return;
    }

    imagen.onerror = null;
    imagen.style.display = 'none';

    var contenedor = imagen.parentElement;

    if (!contenedor) {
        return;
    }

    var error = contenedor.querySelector('.sic-gallery-image-error');
    var zoom = contenedor.querySelector('.sic-gallery-zoom');

    if (error) {
        error.style.display = 'flex';
    }

    if (zoom) {
        zoom.style.display = 'none';
    }
}

document.addEventListener('keydown', function (event) {
    var visorFoto = document.getElementById('sicVisorFoto');

    if (
        event.key === 'Escape' &&
        visorFoto &&
        visorFoto.classList.contains('activo')
    ) {
        cerrarFotoExpandida();
        return;
    }

    var visorGaleria = document.querySelector('.sic-galeria-visor.activo');

    if (!visorGaleria) {
        return;
    }

    if (event.key === 'Escape') {
        cerrarGaleriaSic(visorGaleria.id);
        return;
    }

    if (event.key === 'ArrowLeft') {
        navegarGaleriaSic(visorGaleria.id, -1);
        return;
    }

    if (event.key === 'ArrowRight') {
        navegarGaleriaSic(visorGaleria.id, 1);
    }
});

