                            @foreach (System.Data.DataRow row in objetivosPrioritarios.Rows)
                            {
                                int idObjetivo = 0;

                                if (row.Table.Columns.Contains("int_id_objetivo") &&
                                    row["int_id_objetivo"] != DBNull.Value)
                                {
                                    int.TryParse(Convert.ToString(row["int_id_objetivo"]), out idObjetivo);
                                }

                                int idOrigenObjetivo = 0;



                                if (row.Table.Columns.Contains("IdNombreOrigen") &&
                                                row["IdNombreOrigen"] != DBNull.Value)
                                {
                                    int.TryParse(Convert.ToString(row["IdNombreOrigen"]), out idOrigenObjetivo);
                                }

                                if (idOrigenObjetivo == 0 &&
                                    row.Table.Columns.Contains("IdsNombreObjetivoOrigenAlerta") &&
                                    row["IdsNombreObjetivoOrigenAlerta"] != DBNull.Value)
                                {
                                    string idsOrigenObjetivoTexto = Convert.ToString(row["IdsNombreObjetivoOrigenAlerta"]);

                                    if (!string.IsNullOrWhiteSpace(idsOrigenObjetivoTexto))
                                    {
                                        string primerIdOrigen = idsOrigenObjetivoTexto.Split(',')[0].Trim();
                                        int.TryParse(primerIdOrigen, out idOrigenObjetivo);
                                    }
                                }

                                var idsOrigenObjetivoCoincidencias =
new System.Collections.Generic.List<int>();

                                if (row.Table.Columns.Contains("IdsNombreObjetivoOrigenAlerta") &&
                                    row["IdsNombreObjetivoOrigenAlerta"] != DBNull.Value)
                                {
                                    string idsTexto =
                                        Convert.ToString(
                                            row["IdsNombreObjetivoOrigenAlerta"]
                                        );

                                    if (!string.IsNullOrWhiteSpace(idsTexto))
                                    {
                                        string[] partes =
                                            idsTexto.Split(
                                                new[] { ',' },
                                                StringSplitOptions.RemoveEmptyEntries
                                            );

                                        foreach (string parte in partes)
                                        {
                                            int idConvertido = 0;

                                            if (int.TryParse(
                                                    parte.Trim(),
                                                    out idConvertido
                                                ) &&
                                                idConvertido > 0 &&
                                                !idsOrigenObjetivoCoincidencias.Contains(idConvertido))
                                            {
                                                idsOrigenObjetivoCoincidencias.Add(
                                                    idConvertido
                                                );
                                            }
                                        }
                                    }
                                }

                                if (idOrigenObjetivo > 0 &&
                                    !idsOrigenObjetivoCoincidencias.Contains(idOrigenObjetivo))
                                {
                                    idsOrigenObjetivoCoincidencias.Add(
                                        idOrigenObjetivo
                                    );
                                }

                                System.Collections.ArrayList coincidenciasAlertaObjetivo =
                                    ViewBag.ObtenerCoincidenciasAlerta(
                                        idsOrigenObjetivoCoincidencias.ToArray(),
                                        new int[] { 5 }
                                    ) as System.Collections.ArrayList;

                                if (coincidenciasAlertaObjetivo == null)
