                                                                data-id-detenido="@Model.IDDETENIDO"
                                                                data-id-origen="@idOrigenObjetivo"
                                                                data-id-fuente="@idFuenteAlertaObjetivo">
                                                            <i class="fa fa-undo"></i>
                                                            Cancelar Confirmación
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                class="sic-btn-descartada"
                                                                disabled>
                                                            <i class="fa fa-times-circle"></i>
                                                            Descartada
                                                        </button>

                                                        <button type="button"
                                                                class="sic-btn-reactivar-alerta"
                                                                data-estatus-anterior="0"
                                                                data-id-detenido="@Model.IDDETENIDO"
                                                                data-id-origen="@idOrigenObjetivo"
                                                                data-id-fuente="@idFuenteAlertaObjetivo">
                                                            <i class="fa fa-undo"></i>
                                                            Cancelar Confirmación
                                                        </button>
                                                    }

                                                </div>

                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="sic-btn-alerta-desactivada"
                                                        disabled>
                                                    <i class="fa fa-exclamation-circle"></i>
                                                    Sin ID de alerta
                                                </button>
                                            }
                                        </div>

                                        <div class="sic-rel-grid">

                                            <div class="sic-info-label">Grupo</div>
                                            <div class="sic-info-value">@ViewBag.Texto(grupoObjetivo)</div>

