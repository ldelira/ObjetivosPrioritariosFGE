                        </div>
                    </div>

                    @*<div class="sic-main-info-item">
                            <div class="sic-main-info-icon">
                                <i class="fa fa-user-secret"></i>
                            </div>
                            <div>
                                <label>Alias</label>
                                <strong>@alias</strong>
                            </div>
                        </div>

                        <div class="sic-main-info-item">
                            <div class="sic-main-info-icon">
                                <i class="fa fa-venus-mars"></i>
                            </div>
                            <div>
                                <label>Sexo</label>
