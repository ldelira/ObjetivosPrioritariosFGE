    function mostrarDetenidoObjetivoModal(indice) {

        var $slides =
            $('#contenidoDetenidosObjetivo')
                .find('.sic-modal-detenido-slide');

        var total =
            $slides.length;

        if (total === 0) {
            return;
        }

        if (indice < 0) {
            indice =
                total - 1;
        }

        if (indice >= total) {
            indice =
                0;
        }

        $slides.removeClass(
            'active'
        );

        $slides.eq(indice).addClass(
            'active'
        );

        $('#contenidoDetenidosObjetivo')
            .find('.sic-modal-detenidos-current')
            .text(
