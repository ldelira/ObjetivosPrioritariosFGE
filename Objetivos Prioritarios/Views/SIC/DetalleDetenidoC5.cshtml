    function quitarDetenidoMunicipioFusionado(boton) {
        var carrusel = boton.closest('.sic-detenidos-municipio-carousel');
        var slideActual = boton.closest('.sic-detenidos-municipio-slide');
        var indiceAnterior = parseInt(slideActual.attr('data-index'), 10) || 0;

        slideActual.remove();

        var slides = carrusel.find('.sic-detenidos-municipio-slide');
        var total = slides.length;

        slides.each(function (indice) {
            $(this)
                .attr('data-index', indice)
                .removeClass('active');
        });

        var tab = $('.sic-source-tab[data-tab="tab-detenidos-municipio"]');

        tab.find('.sic-tab-compact-count')
            .text('(' + total + ')');

        if (total === 0) {

            carrusel.replaceWith(
                '<div class="sic-empty-source">' +
                '<i class="fa fa-id-card"></i>' +
                '<strong>Detenidos Municipios</strong>' +
                '<span>Sin registros relacionados por el momento.</span>' +
                '</div>'
            );

            return;
        }

        var nuevoIndice = Math.min(indiceAnterior, total - 1);

        slides.eq(nuevoIndice)
            .addClass('active');

        var contador = carrusel.find('.sic-rel-counter');

        if (total === 1) {

            carrusel.find('.sic-detenidos-carousel-footer')
                .remove();

        } else {

            contador.html(
                '<span class="sic-detenidos-municipio-current">' +
                (nuevoIndice + 1) +
                '</span> / ' +
                total
            );
        }
    }

