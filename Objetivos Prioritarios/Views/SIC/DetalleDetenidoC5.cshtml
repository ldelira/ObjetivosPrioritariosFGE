    $(document).on('click', '.sic-btn-descartar-alerta', function () {
        var boton = $(this);
        var idDetenido = boton.data('id-detenido');
        var idOrigen = boton.data('id-origen');
        var idFuente = boton.data('id-fuente');

        if (!idDetenido || !idOrigen || !idFuente) {
            alert('Faltan datos para descartar la coincidencia.');
            return;
        }

        var continuar = await confirmarAccionSIC(
            'Descartar coincidencia',
            'La coincidencia será marcada como descartada. ¿Deseas continuar?',
            'Sí, descartar',
            'warning'
        );

        if (!continuar) {
            return;
        }

        boton.prop('disabled', true)
             .html('<i class="fa fa-spinner fa-spin"></i> Descartando...');

        $.ajax({
            url: '@Url.Action("DescartarNotificacion", "SIC")',
            type: 'POST',
            data: {
                idDetenido: idDetenido,
                idOrigen: idOrigen,
                idFuente: idFuente
            },
            success: function (response) {
                if (!response.success) {
                    boton.prop('disabled', false)
                         .html('<i class="fa fa-times"></i> Descartar');

                    alert(response.message || 'No se pudo descartar la coincidencia.');
                    return;
