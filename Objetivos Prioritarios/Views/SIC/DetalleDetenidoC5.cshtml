            padding: 15px;
            background-color: #ffffff;
            border: 1px solid #dbe3ee;
            border-radius: 12px;
            box-sizing: border-box;
        }

        .sic-modal-det-layout {
            display: grid;
            grid-template-columns: 165px minmax(0, 1fr);
            gap: 18px;
            align-items: start;
        }

        /* ============================================================
       COLUMNA IZQUIERDA
       ============================================================ */

        .sic-modal-det-sidebar {
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-width: 0;
        }

        .sic-modal-det-photo {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 150px;
            height: 185px;
            overflow: hidden;
            background-color: #eef3f9;
            border: 1px solid #dbe3ee;
            border-radius: 11px;
        }

            .sic-modal-det-photo img {
                display: block;
                width: 100%;
                height: 100%;
                opacity: 0;
                object-fit: cover;
                transition: opacity .2s ease;
            }

            .sic-modal-det-photo > i {
                color: #8ca0bc;
                font-size: 42px;
            }

            .sic-modal-det-photo.sic-photo-loaded img {
                opacity: 1;
            }

            .sic-modal-det-photo.sic-photo-loaded .sic-photo-loader {
                display: none;
            }

        .sic-photo-loader {
            position: absolute;
            inset: 0;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #eef3f9;
        }

            .sic-photo-loader::after {
                width: 27px;
                height: 27px;
                content: "";
                border: 3px solid #cbd8e9;
                border-top-color: #2f67d8;
                border-radius: 50%;
                animation: sicModalFotoSpin .8s linear infinite;
            }

        @@keyframes sicModalFotoSpin {
            to {
                transform: rotate(360deg);
            }
        }

