            var idFuente =
                boton.data('id-fuente');


            if (!idDetenido || !idOrigen || !idFuente) {

                mostrarMensajeSIC(
                    'Datos incompletos',
                    'Faltan datos para enviar el registro a Resguardo FGEA.',
                    'warning'
                );

                return;
            }


            var continuar =
                await confirmarAccionSIC(
                    'Resguardo FGEA',
                    '¿Seguro que deseas poner este registro en Resguardo FGEA?',
                    'Sí, enviar a resguardo',
                    'question'
                );


            if (!continuar) {
                return;
            }


            bloquearBoton(
                boton,
                'Procesando...'
            );


            $.ajax({

                url:
                    '@Url.Action("ResguardoFGEA", "SIC")',

                type: 'POST',

                data: {
                    idDetenido: idDetenido,
                    idOrigen: idOrigen,
                    idFuente: idFuente
                },

                success: function (response) {

                    if (!response.success) {

                        boton
                            .prop('disabled', false)
                            .html(
                                '<i class="fa fa-shield"></i> En Resguardo FGEA'
                            );

                        mostrarMensajeSIC(
                            'No se pudo actualizar',
                            response.message ||
                            'No se pudo enviar el registro a Resguardo FGEA.',
                            'error'
                        );

                        return;
                    }


                    boton.closest('.sic-rel-actions')
                        .html(
                            htmlResguardoFGEA(
                                idDetenido,
                                idOrigen,
                                idFuente
                            )
                        );


                    actualizarPildoraEstadoIdentidad(
                        idDetenido
                    );


                    mostrarMensajeSIC(
                        'Resguardo FGEA',
                        response.message ||
                        'El registro fue puesto en Resguardo FGEA.',
                        'success'
                    );
                },

                error: function (xhr) {

                    console.log(
                        xhr.responseText
                    );

                    boton
                        .prop('disabled', false)
                        .html(
                            '<i class="fa fa-shield"></i> En Resguardo FGEA'
                        );

                    mostrarMensajeSIC(
                        'Error',
                        'Ocurrió un error al enviar el registro a Resguardo FGEA.',
                        'error'
                    );
                }

            });
        }
    );

</script>
