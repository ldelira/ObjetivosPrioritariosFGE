                                {
                                    fotoObjetivo = Convert.ToString(row["nvarchar_foto"]);
                                }

                                if (!string.IsNullOrWhiteSpace(fotoObjetivo) &&
                                    fotoObjetivo != "SIN FOTO")
                                {
                                    fotoObjetivo = fotoObjetivo.Trim();

                                    if (fotoObjetivo.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
                                    {
                                        fotoObjetivoSrc = fotoObjetivo;
                                    }
                                    else if (fotoObjetivo.StartsWith("~/"))
                                    {
                                        fotoObjetivoSrc = Url.Content(fotoObjetivo);
                                    }
                                    else if (fotoObjetivo.StartsWith("/Content/", StringComparison.OrdinalIgnoreCase))
                                    {
                                        fotoObjetivoSrc = Url.Content("~" + fotoObjetivo);
                                    }
                                    else
                                    {
                                        fotoObjetivo = fotoObjetivo
                                            .Replace("\r", "")
                                            .Replace("\n", "")
                                            .Replace(" ", "");

                                        fotoObjetivoSrc = "data:image/jpeg;base64," + fotoObjetivo;
                                    }
                                }

                                var listaNombresObjetivo = new System.Collections.Generic.List<string>();

                                if (!string.IsNullOrWhiteSpace(nombreCompletoObjetivoTexto) &&
                                    nombreCompletoObjetivoTexto != "SIN NOMBRE")
                                {
                                    listaNombresObjetivo = nombreCompletoObjetivoTexto
                                        .Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
                                        .Select(x => x.Trim())
                                        .Where(x => !string.IsNullOrWhiteSpace(x))
                                        .Distinct()
                                        .ToList();
                                }

                                var otrosNombresObjetivo = listaNombresObjetivo
                                    .Where(x => !x.Equals(nombreObjetivoMostrar, StringComparison.OrdinalIgnoreCase))
                                    .ToList();

                                var idsNomPersoPorNombre =
new System.Collections.Generic.Dictionary<string, int>(
StringComparer.OrdinalIgnoreCase
);

                                string otrosNombresDetenidosJson = "";

                                if (row.Table.Columns.Contains("OtrosNombresDetenidosJson") &&
                                    row["OtrosNombresDetenidosJson"] != DBNull.Value)
                                {
                                    otrosNombresDetenidosJson =
                                        Convert.ToString(
                                            row["OtrosNombresDetenidosJson"]
                                        );
                                }

                                if (!string.IsNullOrWhiteSpace(otrosNombresDetenidosJson))
                                {
                                    try
                                    {
                                        var nombresDetenidos =
                                            Newtonsoft.Json.Linq.JArray.Parse(
                                                otrosNombresDetenidosJson
