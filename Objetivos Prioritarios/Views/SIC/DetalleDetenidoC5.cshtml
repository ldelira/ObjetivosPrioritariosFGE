                            </div>
                            <div>
                                <label>Edad</label>
                                <strong>@edad</strong>
                            </div>
                        </div>*@

                    @*<div class="sic-main-info-item">
                            <div class="sic-main-info-icon">
                                <i class="fa fa-picture-o"></i>
                            </div>
                            <div>
                                <label>Fotos en Municipio</label>
                                <strong>@totalFotos</strong>
                            </div>
                        </div>

                        <div class="sic-main-info-item">
