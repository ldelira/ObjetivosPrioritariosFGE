        }
    }

    registrarEventosDetalleSic();
});

    function registrarEventosDetalleSic() {
        var documento = $(document);

        documento.off('.sicDetalle');

        documento.on(
            'click.sicDetalle',
            '.sic-source-tab',
            function () {
                var tabId = $(this).data('tab');

                $('.sic-source-tab')
                    .removeClass('active');

                $(this)
                    .addClass('active');

                $('.sic-source-tab-content')
                    .removeClass('active');

                $('#' + tabId)
                    .addClass('active');
            }
        );

        documento.on(
            'click.sicDetalle',
            '.js-confirmar-identidad-normal',
            confirmarIdentidadNormal
        );

        documento.on(
            'click.sicDetalle',
            '.js-confirmar-identidad-detenido',
            confirmarIdentidadDetenido
        );

        documento.on(
            'click.sicDetalle',
            '.sic-btn-descartar-alerta',
            descartarCoincidenciaNormal
        );

        documento.on(
            'click.sicDetalle',
            '.sic-btn-descartar-alerta-detenidos',
            descartarCoincidenciaDetenido
        );

        documento.on(
            'click.sicDetalle',
            '.sic-btn-reactivar-alerta',
            reabrirCoincidenciaNormal
        );

        documento.on(
            'click.sicDetalle',
            '.sic-btn-reactivar-alerta-detenidos',
            reabrirCoincidenciaDetenido
        );

        documento.on(
            'click.sicDetalle',
            '.js-confirmar-resguardo-fgea',
            confirmarResguardoFGEA
        );

        documento.on(
            'click.sicDetalle',
            '.js-cancelar-resguardo-fgea',
            cancelarResguardoFGEA
        );
    }

    async function confirmarResguardoFGEA(e) {

    e.preventDefault();
    e.stopImmediatePropagation();


    cambiarResguardoFGEA(
        $(this),
        true
    );
}


async function cancelarResguardoFGEA(e) {

    e.preventDefault();
    e.stopImmediatePropagation();


    cambiarResguardoFGEA(
        $(this),
        false
    );
}




async function cambiarResguardoFGEA(boton, activar) {
    var idDetenido = parseInt(boton.attr('data-id-detenido'), 10);
    var idOrigen = parseInt(boton.attr('data-id-origen'), 10);
    var idFuente = parseInt(boton.attr('data-id-fuente'), 10);
    var idTipoAlerta = parseInt(boton.attr('data-id-tipo-alerta'), 10);

    if (isNaN(idDetenido) ||
        idDetenido <= 0 ||
        isNaN(idOrigen) ||
        idOrigen <= 0 ||
        isNaN(idFuente) ||
        idFuente <= 0 ||
        isNaN(idTipoAlerta) ||
        idTipoAlerta <= 0) {

        mostrarMensajeSIC(
            'Datos incompletos',
            'Faltan datos para actualizar el Resguardo FGEA.',
            'warning'
        );

        return;
    }

    var continuar = await confirmarAccionSIC(
        activar
            ? 'Confirmar Resguardo FGEA'
            : 'Cancelar Resguardo FGEA',
        activar
            ? '¿Confirmas que el detenido ya se encuentra físicamente en resguardo de FGEA?'
            : '¿Seguro que deseas cancelar el Resguardo FGEA de este detenido?',
        activar
            ? 'Sí, confirmar resguardo'
            : 'Sí, cancelar resguardo',
        activar
            ? 'question'
            : 'warning'
    );

    if (!continuar) {
        return;
    }

    var urlResguardo = activar
        ? '@Url.Action("ResguardoFGEA", "SIC")'
        : '@Url.Action("CancelarResguardoFGEA", "SIC")';

    bloquearBoton(
        boton,
        activar
            ? 'Confirmando resguardo...'
            : 'Cancelando resguardo...'
    );

    $.ajax({
        url: urlResguardo,
        type: 'POST',
        data: {
            idDetenido: idDetenido,
            idOrigen: idOrigen,
            idFuente: idFuente,
            idTipoAlerta: idTipoAlerta
        },
        success: function (response) {
            if (!response || response.success !== true) {
                restaurarBotonResguardo(
                    boton,
                    activar
                );

                mostrarMensajeSIC(
                    'No se pudo actualizar',
                    response && response.message
                        ? response.message
                        : 'No se pudo actualizar el Resguardo FGEA.',
                    'error'
                );

                return;
            }

            var acciones = boton.closest('.sic-rel-actions');

            if (activar) {
                acciones.html(
                    htmlResguardoFGEA(
                        idDetenido,
                        idOrigen,
                        idFuente,
                        idTipoAlerta
                    )
                );
            }
            else {
                acciones.html(
                    htmlConfirmadoNormal(
                        idDetenido,
                        idOrigen,
                        idFuente,
                        idTipoAlerta
                    )
                );
            }

            actualizarEstadoTabsDesdeDOM();

            actualizarPildoraEstadoIdentidad(
                idDetenido
            );

            mostrarMensajeSIC(
                activar
                    ? 'Resguardo confirmado'
                    : 'Resguardo cancelado',
                response.message,
                'success'
            );
        },
        error: function (xhr) {
            console.log(
                xhr.responseText
            );

            restaurarBotonResguardo(
                boton,
                activar
            );

            mostrarMensajeSIC(
                'Error',
                'Ocurrió un error al actualizar el Resguardo FGEA.',
                'error'
            );
        }
    });
}

function restaurarBotonResguardo(
    boton,
    activar
) {

    boton.prop(
        'disabled',
        false
    );


    if (activar) {

        boton.html(
            '<i class="fa fa-shield"></i> Confirmar Resguardo FGEA'
        );

    }
    else {

        boton.html(
            '<i class="fa fa-undo"></i> Cancelar Resguardo'
        );
    }
}


function moverCarruselSic(boton, selectorSlide, selectorContador, direccion) {
    var carousel = boton.closest('.sic-rel-carousel');
    var slides = carousel.find(selectorSlide);
    var total = slides.length;

    if (total <= 1) {
        return;
    }

    var indice = slides.index(slides.filter('.active'));
    indice += direccion;

    if (indice >= total) {
        indice = 0;
    }

    if (indice < 0) {
        indice = total - 1;
    }

    slides.removeClass('active');
    slides.eq(indice).addClass('active');

    carousel.find(selectorContador).text(indice + 1);
}

