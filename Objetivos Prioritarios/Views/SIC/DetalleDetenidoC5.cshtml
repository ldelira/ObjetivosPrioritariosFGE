    function moverCarruselDetenidos(boton, direccion) {
        var carousel = boton.closest('.sic-detenidos-carousel');
        var slides = carousel.find('.sic-detenido-slide');
        var total = slides.length;

        if (total <= 1) {
            return;
        }

        var indice = slides.index(slides.filter('.active'));
        indice += direccion;

        if (indice >= total) {
            indice = 0;
        }

        if (indice < 0) {
            indice = total - 1;
        }

        slides.removeClass('active');
        slides.eq(indice).addClass('active');

        carousel.find('.sic-detenidos-current').text(indice + 1);
    }

