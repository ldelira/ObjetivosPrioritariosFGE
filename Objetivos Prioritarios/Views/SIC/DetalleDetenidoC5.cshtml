            <div class="sic-card-body">

                <div class="sic-source-tabs">


                    <button type="button" class="sic-source-tab active" data-tab="tab-capea">
                        <i class="fa fa-search"></i>
                        FEMDLP (@capeas.Count)
                    </button>

                    <button type="button" class="sic-source-tab" data-tab="tab-persona-interes">
                        <i class="fa fa-user-circle"></i>
                        Persona Interés
                    </button>

                    <button type="button" class="sic-source-tab" data-tab="tab-mandamientos">
                        <i class="fa fa-gavel"></i>
                        Mandamientos Judiciales (@(mandamientos != null ? mandamientos.Rows.Count : 0))
                    </button>

                    <button type="button" class="sic-source-tab" data-tab="tab-objetivos">
                        <i class="fa fa-crosshairs"></i>
                        Objetivos Prioritarios
                    </button>

                    <button type="button" class="sic-source-tab" data-tab="tab-fgea-detenidos">
                        <i class="fa fa-id-badge"></i>
                        Detenidos
                    </button>
                </div>


                <div class="sic-source-tab-content active" id="tab-capea">

                    @if (capeas != null && capeas.Count > 0)
                    {

                        <div class="sic-capea-carousel">

                            <div class="sic-capea-slides">

                                @for (int i = 0; i < capeas.Count; i++)
                                {
