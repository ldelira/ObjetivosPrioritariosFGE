    $(document).ready(function () {
        var titulo = $('.pagetitle h1').first();

        if (titulo.length === 0) {
            return;
        }

        var contenedorTitulo = titulo.closest('.pagetitle');

        if (contenedorTitulo.length === 0 ||
            contenedorTitulo.find('.sic-page-title-actions').length > 0) {
            return;
        }

        contenedorTitulo.css({
            'display': 'flex',
            'align-items': 'center',
            'justify-content': 'space-between',
            'gap': '12px'
        });

        titulo.css({
            'margin': '0'
        });

        contenedorTitulo.append(
            '<div class="sic-page-title-actions">' +
                '<a href="@Url.Action("Index", "SIC")" class="sic-btn-light">' +
                    '<i class="fa fa-arrow-left"></i> Volver' +
                '</a>' +
            '</div>'
        );
    });

    $(document).on('click', '.sic-source-tab', function () {
        var tabId = $(this).data('tab');

        $('.sic-source-tab').removeClass('active');
        $(this).addClass('active');

        $('.sic-source-tab-content').removeClass('active');
        $('#' + tabId).addClass('active');
    });

    $(document).on('click', '.sic-capea-next, .sic-capea-prev', function (e) {
        e.preventDefault();

        var boton = $(this);
        var carousel = boton.closest('.sic-capea-carousel');
        var slides = carousel.find('.sic-capea-slide');
        var total = slides.length;

        if (total <= 1) {
            return;
        }

        var actual = slides.index(slides.filter('.active'));

        if (boton.hasClass('sic-capea-next')) {
            actual++;
        } else {
            actual--;
        }

        if (actual >= total) {
            actual = 0;
        }

        if (actual < 0) {
            actual = total - 1;
        }

        slides.removeClass('active');
        slides.eq(actual).addClass('active');

        carousel.find('.sic-capea-current').text(actual + 1);
    });

    $(document).on('click', '.sic-detenidos-next', function () {
        moverCarruselDetenidos($(this), 1);
    });

    $(document).on('click', '.sic-detenidos-prev', function () {
        moverCarruselDetenidos($(this), -1);
    });

    function moverCarruselDetenidos(boton, direccion) {
        var carousel = boton.closest('.sic-detenidos-carousel');
        var slides = carousel.find('.sic-detenido-slide');
        var total = slides.length;

        if (total <= 1) {
            return;
        }

        var actual = slides.index(slides.filter('.active'));
        actual += direccion;

        if (actual >= total) {
            actual = 0;
        }

        if (actual < 0) {
            actual = total - 1;
        }

        slides.removeClass('active');
        slides.eq(actual).addClass('active');

        carousel.find('.sic-detenidos-current').text(actual + 1);
    }

