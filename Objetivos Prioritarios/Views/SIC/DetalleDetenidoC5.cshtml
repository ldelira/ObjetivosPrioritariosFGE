    function actualizarPildoraEstadoIdentidad(idDetenido) {

    var $pillIdentidad =
        $('#pillEstadoIdentidad');

    var $textoIdentidad =
        $('#textoEstadoIdentidad');

    var $iconoIdentidad =
        $('#iconoEstadoIdentidad');

        var $globoInteres =
            $('#globoPersonaInteres');

    if (
        $pillIdentidad.length === 0 ||
        !idDetenido
    ) {
        return;
    }

    /* Estado temporal mientras se consulta */

    $pillIdentidad
        .removeClass(
            'sic-pill-identidad-pendiente ' +
            'sic-pill-identidad-confirmada'
        )
        .addClass(
            'sic-pill-identidad-cargando'
        );

    $textoIdentidad.text(
        'Comprobando estado...'
    );

    $iconoIdentidad.attr(
        'class',
        'fa fa-spinner fa-spin'
    );

    $.ajax({
        url: '@Url.Action("ObtenerEstadoIdentidad", "SIC")',
        type: 'GET',
        cache: false,

        data: {
            idDetenido: idDetenido
        },

        success: function (response) {

            if (
                !response ||
                response.success !== true
            ) {
                aplicarErrorEstadoIdentidad();
                return;
            }

            var codigo =
                parseInt(
                    response.codigo,
                    10
                );

            if (isNaN(codigo)) {
                codigo = 0;
            }

            var identidadConfirmada =
                codigo === 1 ||
                codigo === 2;

            var esDeInteres =
                codigo === 2;

            /* =========================================
               PÍLDORA 1: IDENTIDAD
               ========================================= */

            $pillIdentidad
                .removeClass(
                    'sic-pill-identidad-cargando ' +
                    'sic-pill-identidad-pendiente ' +
                    'sic-pill-identidad-confirmada'
                )
                .addClass(
                    identidadConfirmada
                        ? 'sic-pill-identidad-confirmada'
                        : 'sic-pill-identidad-pendiente'
                )
                .attr(
                    'data-estado',
                    codigo
                )
                .attr(
                    'title',
                    response.detalle || ''
                );

            $textoIdentidad.text(
                identidadConfirmada
                    ? 'Identidad confirmada'
                    : 'Sin confirmar'
            );

            $iconoIdentidad.attr(
                'class',
                identidadConfirmada
                    ? 'fa fa-check-circle'
                    : 'fa fa-question-circle'
            );

            /* =========================================
               PÍLDORA 2: PERSONA DE INTERÉS
               Solo aparece con código 2
               ========================================= */

            /* =========================================
   GLOBO FLOTANTE DE INTERÉS
   Código 2 = de interés
   ========================================= */

            if (esDeInteres) {

                $globoInteres.attr(
                    'title',
                    response.detalle ||
                    'La identidad fue confirmada en una fuente de interés.'
                );

                if (!$globoInteres.is(':visible')) {

                    $globoInteres
                        .stop(true, true)
                        .css('display', 'flex')
                        .hide()
                        .fadeIn(250);

                }

            } else {

                if ($globoInteres.is(':visible')) {

                    $globoInteres
                        .stop(true, true)
                        .fadeOut(200);

                }

            }
        },

        error: function (xhr) {

            console.log(
                'Error al actualizar el estado de identidad:',
                xhr.responseText
            );

            aplicarErrorEstadoIdentidad();
        }
    });

    function aplicarErrorEstadoIdentidad() {

        $pillIdentidad
            .removeClass(
                'sic-pill-identidad-cargando ' +
                'sic-pill-identidad-confirmada'
            )
            .addClass(
                'sic-pill-identidad-pendiente'
            );

        $textoIdentidad.text(
            'Estado no comprobado'
        );

        $iconoIdentidad.attr(
            'class',
            'fa fa-exclamation-triangle'
        );
    }
}


    function actualizarContadoresAlReabrir(estatusAnterior) {
        if (estatusAnterior === 2) {
            actualizarContadoresAlertas(1, 0, -1);
            return;
        }

        if (estatusAnterior === 0) {
            actualizarContadoresAlertas(1, -1, 0);
        }
    }

    function actualizarContadoresAlertas(
        cambioActivas,
        cambioRevisadas,
        cambioConfirmadas
    ) {
        var activas =
            parseInt($('#contadorAlertasActivas').text(), 10) || 0;

        var revisadas =
            parseInt($('#contadorAlertasRevisadas').text(), 10) || 0;

        var confirmadas =
            parseInt($('#contadorCoincidenciasConfirmadas').text(), 10) || 0;

        cambioActivas =
            typeof cambioActivas === 'number' ? cambioActivas : 0;

        cambioRevisadas =
            typeof cambioRevisadas === 'number' ? cambioRevisadas : 0;

        cambioConfirmadas =
            typeof cambioConfirmadas === 'number' ? cambioConfirmadas : 0;

        activas = Math.max(0, activas + cambioActivas);
        revisadas = Math.max(0, revisadas + cambioRevisadas);
        confirmadas = Math.max(0, confirmadas + cambioConfirmadas);

        $('#contadorAlertasActivas').text(activas);
        $('#contadorAlertasRevisadas').text(revisadas);
        $('#contadorCoincidenciasConfirmadas').text(confirmadas);
        $('#pillAlertasActivas').text(activas);
    }

    function bloquearBoton(boton, texto) {
        boton
            .prop('disabled', true)
            .html('<i class="fa fa-spinner fa-spin"></i> ' + texto);
    }

    function restaurarBotonConfirmar(boton) {
        boton
            .prop('disabled', false)
            .html('<i class="fa fa-check"></i> Confirmar identidad');
    }

    function restaurarBotonDescartar(boton) {
        boton
            .prop('disabled', false)
            .html('<i class="fa fa-times"></i> Descartar');
    }

    function restaurarBotonReabrir(boton) {
        boton
            .prop('disabled', false)
            .html('<i class="fa fa-undo"></i> Cancelar Confirmación');
    }

    var urlDetenidosObjetivoModal =
    '@Url.Action("ObtenerDetenidosObjetivoModal", "SIC")';

$(document).on(
    'click',
    '.js-ver-detenidos-objetivo',
    function (event) {

        event.preventDefault();

        var idNomPerso = parseInt(
            $(this).attr('data-id-nom-perso'),
            10
        );

        var nombre = (
            $(this).attr('data-nombre') || ''
        ).toString().trim();

        if (isNaN(idNomPerso) || idNomPerso <= 0) {

            Swal.fire(
                'Sin información',
                'No se encontró el ID del nombre seleccionado.',
                'warning'
            );

            return;
        }

        var tituloModal =
            'Información del detenido';

        if (nombre !== '') {
            tituloModal += ' - ' + nombre;
        }

        $('#tituloModalDetenidosObjetivo')
            .text(tituloModal);

        $('#contenidoDetenidosObjetivo').html(
            '<div class="sic-modal-detenido-cargando">' +
                '<i class="fa fa-spinner fa-spin"></i>' +
                '<div>Cargando información...</div>' +
            '</div>'
        );

        $('#modalDetenidosObjetivo').modal('show');

        $.ajax({
            url: urlDetenidosObjetivoModal,
            type: 'GET',
            cache: false,
            data: {
                idNomPerso: idNomPerso
            },
            success: function (html) {

                $('#contenidoDetenidosObjetivo')
                    .html(html);
            },
            error: function (xhr) {

                var mensaje =
                    'No se pudo cargar la información del detenido.';

                if (
                    xhr &&
                    xhr.responseText
                ) {
                    mensaje = xhr.responseText;
                }

                var alerta = $('<div>')
                    .addClass('alert alert-warning')
                    .text(mensaje);

                $('#contenidoDetenidosObjetivo')
                    .empty()
                    .append(alerta);
            }
        });
    }
);

    function escaparTextoModal(valor) {

        return $('<div>')
            .text(
                valor === null ||
                    valor === undefined
                    ? ''
                    : valor.toString()
            )
            .html();

    }

    function mostrarDetenidoObjetivoModal(indice) {

        var $slides =
            $('#contenidoDetenidosObjetivo')
                .find('.sic-modal-detenido-slide');

        var total =
            $slides.length;

        if (total === 0) {
            return;
        }

        if (indice < 0) {
            indice =
                total - 1;
        }

        if (indice >= total) {
            indice =
                0;
        }

        $slides.removeClass(
            'active'
        );

        $slides.eq(indice).addClass(
            'active'
        );

        $('#contenidoDetenidosObjetivo')
            .find('.sic-modal-detenidos-current')
            .text(
                indice + 1
            );

        $('#contenidoDetenidosObjetivo')
            .data(
                'indice-detenido',
                indice
            );

    }


    $(document).on(
        'click',
        '.sic-modal-detenidos-prev',
        function () {

            var indiceActual =
                parseInt(
                    $('#contenidoDetenidosObjetivo')
                        .data('indice-detenido'),
                    10
                );

            if (isNaN(indiceActual)) {
                indiceActual = 0;
            }

            mostrarDetenidoObjetivoModal(
                indiceActual - 1
            );

        }
    );


    $(document).on(
        'click',
        '.sic-modal-detenidos-next',
        function () {

            var indiceActual =
                parseInt(
                    $('#contenidoDetenidosObjetivo')
                        .data('indice-detenido'),
                    10
                );

            if (isNaN(indiceActual)) {
                indiceActual = 0;
            }

            mostrarDetenidoObjetivoModal(
                indiceActual + 1
            );

        }
    );


    $(document).on(
        'click',
        '.js-cerrar-modal-detenido',
        function (event) {

            event.preventDefault();
            event.stopPropagation();

            var $modal =
                $('#modalDetenidosObjetivo');

            if (
                $.fn.modal &&
                typeof $modal.modal === 'function'
            ) {
                $modal.modal('hide');
                return;
            }

            var elementoModal =
                document.getElementById(
                    'modalDetenidosObjetivo'
                );

            if (
                window.bootstrap &&
                window.bootstrap.Modal &&
                elementoModal
            ) {
                var instancia =
                    window.bootstrap.Modal.getInstance(
                        elementoModal
                    );

                if (!instancia) {
                    instancia =
                        new window.bootstrap.Modal(
                            elementoModal
                        );
                }

                instancia.hide();
                return;
            }

            $modal
                .removeClass('show')
                .hide()
                .attr('aria-hidden', 'true');

            $('body')
                .removeClass('modal-open')
                .css('padding-right', '');

            $('.modal-backdrop').remove();
        }
    );

    function abrirFotoExpandida(src, descripcion) {

        if (!src) {
            return;
        }

        $('#sicVisorFotoContenido')
            .removeClass('comparando');

        $('#sicVistaComparacion')
            .hide();

        $('#sicVistaFotoUnica')
            .show();

        $('#sicFotoExpandida')
            .css('display', 'block')
            .attr('src', src)
            .attr(
                'alt',
                descripcion || 'Fotografía ampliada'
            );

        $('#sicFotoExpandidaTexto')
            .text(
                descripcion || 'Fotografía del detenido'
            );

        $('#sicVisorFoto')
            .addClass('activo')
            .attr('aria-hidden', 'false');

        $('body').css('overflow', 'hidden');
    }


    function abrirComparacionFotos(
        srcFotoDetenido,
        descripcionDetenido
    ) {

        if (!srcFotoDetenido) {
            return;
        }

        var fotoPrincipal =
            document.getElementById(
                'sicFotoPrincipalC5'
            );

        var srcFotoPrincipal =
            fotoPrincipal
                ? fotoPrincipal.currentSrc ||
                fotoPrincipal.src
                : '';

        if (!srcFotoPrincipal) {

            abrirFotoExpandida(
                srcFotoDetenido,
                descripcionDetenido
            );

            return;
        }

        $('#sicVisorFotoContenido')
            .addClass('comparando');

        $('#sicVistaFotoUnica')
            .hide();

        $('#sicVistaComparacion')
            .css('display', 'grid');

        $('#sicFotoComparacionPrincipal')
            .css('display', 'block')
            .attr('src', srcFotoPrincipal)
            .attr(
                'alt',
                fotoPrincipal.alt ||
                'Fotografía del detenido en municipio'
            );

        $('#sicFotoComparacionDetenido')
            .css('display', 'block')
            .attr('src', srcFotoDetenido)
            .attr(
                'alt',
                descripcionDetenido ||
                'Fotografía del registro de detenidos FGEA'
            );

        $('#sicVisorFoto')
            .addClass('activo')
            .attr('aria-hidden', 'false');

        $('body').css('overflow', 'hidden');
    }


    function cerrarFotoExpandida() {

        var visor =
            document.getElementById('sicVisorFoto');

        var contenido =
            document.getElementById('sicVisorFotoContenido');

        var vistaComparacion =
            document.getElementById('sicVistaComparacion');

        var vistaFotoUnica =
            document.getElementById('sicVistaFotoUnica');

        var fotoExpandida =
            document.getElementById('sicFotoExpandida');

        var fotoPrincipal =
            document.getElementById('sicFotoComparacionPrincipal');

        var fotoDetenido =
            document.getElementById('sicFotoComparacionDetenido');


        if (visor) {
            visor.classList.remove('activo');
            visor.setAttribute('aria-hidden', 'true');
        }

        if (contenido) {
            contenido.classList.remove('comparando');
        }

        if (vistaComparacion) {
            vistaComparacion.style.display = 'none';
        }

        if (vistaFotoUnica) {
            vistaFotoUnica.style.display = 'block';
        }

        if (fotoExpandida) {
            fotoExpandida.removeAttribute('src');
        }

        if (fotoPrincipal) {
            fotoPrincipal.removeAttribute('src');
        }

        if (fotoDetenido) {
            fotoDetenido.removeAttribute('src');
        }

        document.body.style.overflow = '';
    }



    function cerrarFotoExpandidaAlFondo(event) {

        if (
            event &&
            event.target &&
            event.target.id === 'sicVisorFoto'
        ) {
            cerrarFotoExpandida();
        }
    }


    $(document).on('keydown', function (event) {
        if (
            event.key === 'Escape' &&
            $('#sicVisorFoto').hasClass('activo')
        ) {
            cerrarFotoExpandida();
        }
    });

    document.addEventListener('keydown', function (event) {

        var visor =
            document.getElementById('sicVisorFoto');

        if (
            event.key === 'Escape' &&
            visor &&
            visor.classList.contains('activo')
        ) {
            cerrarFotoExpandida();
        }
    });

    var sicGaleriaFotosC5 = [];
    var sicGaleriaIndiceC5 = 0;
    var sicGaleriaGrupoC5 = '';


    function obtenerFotosGaleriaC5(grupo) {

        var elementos =
            document.querySelectorAll(
                '.sic-gallery-item-expandible[data-galeria="' +
                grupo +
                '"]'
            );

        var fotos = [];

        elementos.forEach(function (elemento) {

            var imagen =
                elemento.querySelector(
                    '.sic-gallery-foto'
                );

            var descripcion =
                elemento.querySelector(
                    '.sic-gallery-caption span'
                );

            if (!imagen) {
                return;
            }

            var src =
                imagen.currentSrc ||
                imagen.src ||
                '';

            if (!src) {
                return;
            }

            fotos.push({
                src: src,
                descripcion: descripcion
                    ? descripcion.textContent.trim()
                    : 'Fotografía'
            });
        });

        return fotos;
    }


    function abrirGaleriaC5(grupo, indice) {

        sicGaleriaGrupoC5 =
            grupo || 'fotos';

        sicGaleriaFotosC5 =
            obtenerFotosGaleriaC5(
                sicGaleriaGrupoC5
            );

        if (sicGaleriaFotosC5.length === 0) {
            return;
        }

        sicGaleriaIndiceC5 =
            parseInt(indice, 10);

        if (
            isNaN(sicGaleriaIndiceC5) ||
            sicGaleriaIndiceC5 < 0
        ) {
            sicGaleriaIndiceC5 = 0;
        }

        if (
            sicGaleriaIndiceC5 >=
            sicGaleriaFotosC5.length
        ) {
            sicGaleriaIndiceC5 =
                sicGaleriaFotosC5.length - 1;
        }

        var titulo =
            document.getElementById(
                'sicGaleriaTitulo'
            );

        if (titulo) {
            titulo.textContent =
                sicGaleriaGrupoC5 === 'rasgos'
                    ? 'Rasgos en Municipio'
                    : 'Galería de fotos en Municipio';
        }

        mostrarFotoGaleriaC5();

        var visor =
            document.getElementById(
                'sicGaleriaVisor'
            );

        if (visor) {
            visor.classList.add('activo');
            visor.setAttribute(
                'aria-hidden',
                'false'
            );
        }

        document.body.style.overflow =
            'hidden';
    }

    function mostrarFotoGaleriaC5() {

        if (
            sicGaleriaFotosC5.length === 0
        ) {
            return;
        }

        var foto =
            sicGaleriaFotosC5[
            sicGaleriaIndiceC5
            ];

        var imagen =
            document.getElementById(
                'sicGaleriaImagen'
            );

        var error =
            document.getElementById(
                'sicGaleriaError'
            );

        var descripcion =
            document.getElementById(
                'sicGaleriaDescripcion'
            );

        var contador =
            document.getElementById(
                'sicGaleriaContador'
            );

        var anterior =
            document.getElementById(
                'sicGaleriaAnterior'
            );

        var siguiente =
            document.getElementById(
                'sicGaleriaSiguiente'
            );

        if (error) {
            error.style.display = 'none';
        }

        if (imagen) {

            imagen.style.display = 'block';

            imagen.onerror = function () {

                imagen.style.display = 'none';

                if (error) {
                    error.style.display = 'flex';
                }
            };

            imagen.src = foto.src;
            imagen.alt =
                foto.descripcion ||
                'Fotografía ampliada';
        }

        if (descripcion) {
            descripcion.textContent =
                foto.descripcion ||
                'Fotografía';
        }

        if (contador) {
            contador.textContent =
                (sicGaleriaIndiceC5 + 1) +
                ' / ' +
                sicGaleriaFotosC5.length;
        }

        var hayVarias =
            sicGaleriaFotosC5.length > 1;

        if (anterior) {
            anterior.style.display =
                hayVarias ? 'flex' : 'none';
        }

        if (siguiente) {
            siguiente.style.display =
                hayVarias ? 'flex' : 'none';
        }
    }


    function fotoGaleriaC5Anterior() {

        if (
            sicGaleriaFotosC5.length <= 1
        ) {
            return;
        }

        sicGaleriaIndiceC5--;

        if (sicGaleriaIndiceC5 < 0) {
            sicGaleriaIndiceC5 =
                sicGaleriaFotosC5.length - 1;
        }

        mostrarFotoGaleriaC5();
    }


    function fotoGaleriaC5Siguiente() {

        if (
            sicGaleriaFotosC5.length <= 1
        ) {
            return;
        }

        sicGaleriaIndiceC5++;

        if (
            sicGaleriaIndiceC5 >=
            sicGaleriaFotosC5.length
        ) {
            sicGaleriaIndiceC5 = 0;
        }

        mostrarFotoGaleriaC5();
    }


    function cerrarGaleriaC5() {

        var visor =
            document.getElementById(
                'sicGaleriaVisor'
            );

        var imagen =
            document.getElementById(
                'sicGaleriaImagen'
            );

        if (visor) {
            visor.classList.remove('activo');
            visor.setAttribute(
                'aria-hidden',
                'true'
            );
        }

        if (imagen) {
            imagen.removeAttribute('src');
        }

        document.body.style.overflow = '';
    }


    function cerrarGaleriaC5AlFondo(event) {

        if (
            event &&
            event.target &&
            event.target.id ===
            'sicGaleriaVisor'
        ) {
            cerrarGaleriaC5();
        }
    }


    function mostrarErrorFotoGaleria(imagen) {

        if (!imagen) {
            return;
        }

        imagen.onerror = null;
        imagen.style.display = 'none';

        var contenedor =
            imagen.parentElement;

        if (!contenedor) {
            return;
        }

        var error =
            contenedor.querySelector(
                '.sic-gallery-image-error'
            );

        var zoom =
            contenedor.querySelector(
                '.sic-gallery-zoom'
            );

        if (error) {
            error.style.display = 'flex';
        }

        if (zoom) {
            zoom.style.display = 'none';
        }
    }


    document.addEventListener(
        'keydown',
        function (event) {

            var visor =
                document.getElementById(
                    'sicGaleriaVisor'
                );

            if (
                !visor ||
                !visor.classList.contains(
                    'activo'
                )
            ) {
                return;
            }

            if (event.key === 'Escape') {
                cerrarGaleriaC5();
            }

            if (event.key === 'ArrowLeft') {
                fotoGaleriaC5Anterior();
            }

            if (event.key === 'ArrowRight') {
                fotoGaleriaC5Siguiente();
            }
        }
    );



</script>
