
@model Objetivos_Prioritarios.Models.sp_BuscarDetenido_Result
@using System.Linq
@using System.Collections.Generic

@{
    ViewBag.Title = "Ficha del detenido en Municipio / Sistema de Identificación Criminal";

    string nombreCompleto = string.IsNullOrWhiteSpace(Model.Nombre) ? "SIN INFORMACIÓN" : Model.Nombre;
    string alias = string.IsNullOrWhiteSpace(Model.ALIAS) ? "SIN INFORMACIÓN" : Model.ALIAS;
    string folio = string.IsNullOrWhiteSpace(Model.Folio) ? "SIN INFORMACIÓN" : Model.Folio;
    string sexo = string.IsNullOrWhiteSpace(Model.SEXO) ? "SIN INFORMACIÓN" : Model.SEXO;
    string municipioDetencion = string.IsNullOrWhiteSpace(Model.MunicipioDetencion) ? "SIN INFORMACIÓN" : Model.MunicipioDetencion;
    string siglasMunicipio = string.IsNullOrWhiteSpace(Model.SiglasMunicipio) ? "SIN INFORMACIÓN" : Model.SiglasMunicipio;

    string idDetenido = Convert.ToString(Model.IDDETENIDO);
    string idDetencion = Convert.ToString(Model.IDDETENCION);
    string edad = Convert.ToString(Model.EDAD);
    string totalFotos = Convert.ToString(Model.TotalFotos);
    string totalHuellas = Convert.ToString(Model.TotalHuellas);
    string totalAlertas = Convert.ToString(Model.TotalRegistroAlertas);
    string totalRegistrosDetenido = Convert.ToString(Model.TotalRegistrosDetenido);

    idDetenido = string.IsNullOrWhiteSpace(idDetenido) ? "SIN INFORMACIÓN" : idDetenido;
    idDetencion = string.IsNullOrWhiteSpace(idDetencion) ? "SIN INFORMACIÓN" : idDetencion;
    edad = string.IsNullOrWhiteSpace(edad) ? "SIN INFORMACIÓN" : edad;
    totalFotos = string.IsNullOrWhiteSpace(totalFotos) ? "0" : totalFotos;
    totalHuellas = string.IsNullOrWhiteSpace(totalHuellas) ? "0" : totalHuellas;
    totalAlertas = string.IsNullOrWhiteSpace(totalAlertas) ? "0" : totalAlertas;
    totalRegistrosDetenido = string.IsNullOrWhiteSpace(totalRegistrosDetenido) ? "0" : totalRegistrosDetenido;

    string fotoPrincipalUrl = Url.Action("FotoDetenidoC5", "SIC", new { idDetenido = Model.IDDETENIDO });

    string fuente = "SIC / C5";
    string tipoAlerta = "Coincidencia activa";
    string estatus = "Coincidencia pendiente";
    string lugarDetencion = municipioDetencion;
    string fechaDetencion = "SIN INFORMACIÓN";
    string horaDetencion = "SIN INFORMACIÓN";
    string anio = "SIN INFORMACIÓN";
    string hecho = "SIN INFORMACIÓN";
    string causa = "SIN INFORMACIÓN";
    string aseguramiento = "SIN INFORMACIÓN";
    string latitud = "";
    string longitud = "";

    var capeas = ViewBag.Capeas as List<Objetivos_Prioritarios.Models.Capea_boletin_busqueda> ?? new List<Objetivos_Prioritarios.Models.Capea_boletin_busqueda>();
    int totalPersonasInteres = ViewBag.PersonasInteres == null ? 0 : ((System.Data.DataTable)ViewBag.PersonasInteres).Rows.Count;
    var mandamientos = ViewBag.Mandamientos as System.Data.DataTable ?? new System.Data.DataTable();
    var objetivosPrioritarios = ViewBag.ObjetivosPrioritarios as System.Data.DataTable ?? new System.Data.DataTable();
    var detenidos = ViewBag.Detenidos as System.Data.DataTable ?? new System.Data.DataTable();

    int fuenteCapea = ViewBag.FuenteCapea == null ? 0 : Convert.ToInt32(ViewBag.FuenteCapea);

    var detencionesC5 = ViewBag.DetencionC5 as List<Objetivos_Prioritarios.Models.tb_DETENCION_C5> ?? new List<Objetivos_Prioritarios.Models.tb_DETENCION_C5>();
    var detencionC5 = detencionesC5.Count > 0 ? detencionesC5[0] : null;
    int totalDetenciones = detencionesC5.Count;
    var idsRelacionadosHero = ViewBag.idsrelacionados as List<int> ?? new List<int>();

    var datosDetenidoC5 = ViewBag.DatosDetenidoC5 as Objetivos_Prioritarios.Models.tb_DETENIDO_C5;
    var fotosC5 = ViewBag.FotosC5 as List<Objetivos_Prioritarios.Models.tb_FOTO_C5> ?? new List<Objetivos_Prioritarios.Models.tb_FOTO_C5>();
    var huellasC5 = ViewBag.HuellasC5 as List<Objetivos_Prioritarios.Models.tb_HUELLA_C5> ?? new List<Objetivos_Prioritarios.Models.tb_HUELLA_C5>();
    var rasgosC5 = ViewBag.RasgosC5 as List<Objetivos_Prioritarios.Models.tb_FOTO_C5> ?? new List<Objetivos_Prioritarios.Models.tb_FOTO_C5>();
    var alertasTipo = ViewBag.AlertasTipo as List<Tuple<int, int, int, int, int, string>> ?? new List<Tuple<int, int, int, int, int, string>>();
    var alertasPersonaInteres = ViewBag.AlertasPersonaInteres as List<Tuple<int, int, int, int, int, string>> ?? new List<Tuple<int, int, int, int, int, string>>();

    int totalAlertasActivas = ViewBag.TotalAlertasActivas == null ? 0 : Convert.ToInt32(ViewBag.TotalAlertasActivas);
    int totalAlertasRevisadas = ViewBag.TotalAlertasRevisadas == null ? 0 : Convert.ToInt32(ViewBag.TotalAlertasRevisadas);
    int totalCoincidenciasConfirmadas = ViewBag.TotalCoincidenciasConfirmadas == null ? 0 : Convert.ToInt32(ViewBag.TotalCoincidenciasConfirmadas);

    var tiposAlertas = ViewBag.TiposAlertas as List<Tuple<int, int>> ?? new List<Tuple<int, int>>();
    var detenidosMunicipios = ViewBag.DetenidosMunicipios as System.Data.DataTable;
    int totalDetenidosMunicipios = detenidosMunicipios != null ? detenidosMunicipios.Rows.Count : 0;

    ViewBag.IdDetenidoC5 = Model.IDDETENIDO;
    ViewBag.TotalRegistrosDetenidoVista = totalRegistrosDetenido;

    Func<int[], int, string> ObtenerClaseTab = (fuentes, totalRegistros) =>
    {
        if (totalRegistros == 0) return "sic-tab-sin-registros";

        var estatusTab = alertasTipo.Where(x => fuentes.Contains(x.Item2)).Select(x => x.Item3).ToList();

        if (estatusTab.Any(x => x == 2 || x == 3)) return "sic-tab-confirmado";
        if (estatusTab.Count > 0 && estatusTab.All(x => x == 0)) return "sic-tab-descartado";

        return "";
    };

    string claseCapea = ObtenerClaseTab(new int[] { 2, 7, 8 }, capeas.Count);
    string clasePersonaInteres = ObtenerClaseTab(new int[] { 3 }, totalPersonasInteres);
    string claseMandamientos = ObtenerClaseTab(new int[] { 4 }, mandamientos.Rows.Count);
    string claseObjetivos = ObtenerClaseTab(new int[] { 5 }, objetivosPrioritarios.Rows.Count);
    string claseDetenidos = ObtenerClaseTab(new int[] { 6 }, detenidos.Rows.Count);
    string claseDetenidosMunicipios = ObtenerClaseTab(new int[] { 1 }, totalDetenidosMunicipios);
}
@{
    string rutaCss = Server.MapPath("~/Content/SIC/busqueda-coincidencias.css");
    long versionCss = System.IO.File.GetLastWriteTimeUtc(rutaCss).Ticks;
}

<link href="@Url.Content("~/Content/SIC/busqueda-coincidencias.css")?v=@versionCss"
      rel="stylesheet"
      type="text/css" />

<div class="sic-ficha-page">

    <div class="sic-hero">

        <div class="sic-hero-content">

            <!-- COLUMNA 1: FOTO -->
            <div class="sic-photo-main-wrap">

                <div class="sic-photo-main sic-photo-placeholder-wrap">

                    @if (!string.IsNullOrWhiteSpace(fotoPrincipalUrl))
                    {
                        <img id="sicFotoPrincipalC5"
                             src="@fotoPrincipalUrl"
                             alt="Foto principal del detenido en municipio"
                             class="sic-foto-expandible"
                             role="button"
                             tabindex="0"
                             title="Presione para ampliar"
                             onclick="abrirFotoExpandida(this.currentSrc || this.src, this.alt);"
                             onerror="mostrarFotoNoExiste(this);" />
                    }
                    else
                    {
                        <div class="sic-photo-no-existe">
                            <i class="fa fa-user"></i>
                            <span>NO EXISTE FOTO EN ARCHIVO</span>
                        </div>
                    }

                </div>

                @{
                    int estadoIdentidadCodigo =
                        ViewBag.EstadoIdentidadCodigo == null
                            ? 0
                            : Convert.ToInt32(
                                ViewBag.EstadoIdentidadCodigo
                            );

                    bool identidadConfirmada =
                        estadoIdentidadCodigo == 1 ||
                        estadoIdentidadCodigo == 2;

                    bool esDeInteres =
                        estadoIdentidadCodigo == 2;

                    string estadoIdentidadDetalle =
                        Convert.ToString(
                            ViewBag.EstadoIdentidadDetalle
                        );

                    string claseIdentidad =
                        identidadConfirmada
                            ? "sic-pill-identidad-confirmada"
                            : "sic-pill-identidad-pendiente";

                    string iconoIdentidad =
                        identidadConfirmada
                            ? "fa fa-check-circle"
                            : "fa fa-question-circle";

                    string textoIdentidad =
                        identidadConfirmada
                            ? "Identidad confirmada"
                            : "Sin confirmar";
                }

                <span id="contenedorPildorasIdentidad" class="sic-estado-identidad-pildoras">

                    <span id="pillEstadoIdentidad"
                          class="sic-pill sic-pill-estado-identidad @claseIdentidad"
                          data-estado="@estadoIdentidadCodigo"
                          title="@estadoIdentidadDetalle">

                        <i id="iconoEstadoIdentidad" class="@iconoIdentidad"></i>

                        <span id="textoEstadoIdentidad">
                            @textoIdentidad
                        </span>
                    </span>

                </span>

            </div>

            <div class="sic-hero-info">
                <h2>@nombreCompleto</h2>



                <div class="sic-hero-meta">
                    @*<span class="sic-pill sic-pill-alerta">
                            <i class="fa fa-exclamation-triangle"></i>
                            @totalAlertas Alerta(s) Totales
                        </span>*@

                    <span class="sic-pill">
                        <i class="fa fa-id-card"></i>
                        ID Detenido: @idDetenido
                    </span>

                    <span class="sic-pill">
                        <i class="fa fa-file-text"></i>
                        Folio: @folio
                    </span>

                    @if (datosDetenidoC5 != null && !string.IsNullOrWhiteSpace(datosDetenidoC5.CURP))
                    {
                        <span class="sic-pill">
                            <i class="fa fa-id-card"></i>
                            CURP: @datosDetenidoC5.CURP
                        </span>
                    }

                    @if (datosDetenidoC5 != null && !string.IsNullOrWhiteSpace(datosDetenidoC5.RFC))
                    {
                        <span class="sic-pill">
                            <i class="fa fa-file-text"></i>
                            RFC: @datosDetenidoC5.RFC
                        </span>
                    }


                </div>

                <div class="sic-main-info-grid">
                    <div class="sic-main-info-item">
                        <div class="sic-main-info-icon">
                            <i class="fa fa-map-marker"></i>
                        </div>
                        <div>
                            <label>Municipio detención</label>
                            <strong>@municipioDetencion</strong>
                        </div>
                    </div>

                    <div class="sic-main-info-item">
                        <div class="sic-main-info-icon">
                            <i class="fa fa-gavel"></i>
                        </div>
                        <div>
                            <label>Falta administrativa</label>
                            @{
                                string fueroDescripcion = detencionC5 == null ? "" : Convert.ToString(detencionC5.FueroDescripcion).Trim();
                                string fueroTexto = string.IsNullOrWhiteSpace(fueroDescripcion) ? "SIN INFORMACIÓN" : (fueroDescripcion.Length > 100 ? fueroDescripcion.Substring(0, 100) + "..." : fueroDescripcion);
                                string fueroTitle = string.IsNullOrWhiteSpace(fueroDescripcion) ? "SIN INFORMACIÓN" : fueroDescripcion;
                            }

                            <strong title="@fueroTitle">
                                @fueroTexto
                            </strong>
                        </div>
                    </div>

                    <div class="sic-main-info-item">
                        <div class="sic-main-info-icon">
                            <i class="fa fa-calendar"></i>
                        </div>
                        <div>
                            <label>Fecha detención</label>
                            <strong>
                                @(detencionC5 == null || string.IsNullOrWhiteSpace(Convert.ToString(detencionC5.FECHA_DETENCION))  ? "SIN INFORMACIÓN"  : Convert.ToDateTime(detencionC5.FECHA_DETENCION)  .ToString("dd/MM/yyyy hh:mm:ss tt"))
                            </strong>
                        </div>
                    </div>

                    @*<div class="sic-main-info-item">
                            <div class="sic-main-info-icon">
                                <i class="fa fa-user-secret"></i>
                            </div>
                            <div>
                                <label>Alias</label>
                                <strong>@alias</strong>
                            </div>
                        </div>

                        <div class="sic-main-info-item">
                            <div class="sic-main-info-icon">
                                <i class="fa fa-venus-mars"></i>
                            </div>
                            <div>
                                <label>Sexo</label>
                                <strong>@sexo</strong>
                            </div>
                        </div>

                        <div class="sic-main-info-item">
                            <div class="sic-main-info-icon">
                                <i class="fa fa-birthday-cake"></i>
                            </div>
                            <div>
                                <label>Edad</label>
                                <strong>@edad</strong>
                            </div>
                        </div>*@

                    @*<div class="sic-main-info-item">
                            <div class="sic-main-info-icon">
                                <i class="fa fa-picture-o"></i>
                            </div>
                            <div>
                                <label>Fotos en Municipio</label>
                                <strong>@totalFotos</strong>
                            </div>
                        </div>

                        <div class="sic-main-info-item">
                            <div class="sic-main-info-icon">
                                <i class="fa fa-hand-paper-o"></i>
                            </div>
                            <div>
                                <label>Huellas</label>
                                <strong>@totalHuellas</strong>
                            </div>
                        </div>*@
                </div>
            </div>

            <div class="sic-hero-counters">

                <div class="sic-hero-counter sic-counter-total">
                    <div class="sic-hero-counter-icon">
                        <i class="fa fa-exclamation-triangle"></i>
                    </div>
                    <div class="sic-hero-counter-texto">
                        <label>Coincidencia(s) totale(s)</label>
                        <strong>@totalAlertas</strong>
                    </div>
                </div>

                <div class="sic-hero-counter sic-counter-activas">
                    <div class="sic-hero-counter-icon">
                        <i class="fa fa-bell"></i>
                    </div>
                    <div class="sic-hero-counter-texto">
                        <label>Coincidencia(s) activa(s)</label>
                        <strong id="contadorAlertasActivas">
                            @totalAlertasActivas
                        </strong>
                    </div>
                </div>

                <div class="sic-hero-counter sic-counter-descartadas">
                    <div class="sic-hero-counter-icon">
                        <i class="fa fa-ban"></i>
                    </div>
                    <div class="sic-hero-counter-texto">
                        <label>Coincidencia(s) descartada(s)</label>
                        <strong id="contadorAlertasDescartadas">
                            @totalAlertasRevisadas
                        </strong>
                    </div>
                </div>

                <div class="sic-hero-counter sic-counter-confirmadas">
                    <div class="sic-hero-counter-icon">
                        <i class="fa fa-check-circle"></i>
                    </div>
                    <div class="sic-hero-counter-texto">
                        <label>Coincidencias confirmadas</label>
                        <strong id="contadorCoincidenciasConfirmadas">
                            @totalCoincidenciasConfirmadas
                        </strong>
                    </div>
                </div>

                <div class="sic-hero-counter sic-counter-nombre">
                    <div class="sic-hero-counter-icon">
                        <i class="fa fa-user"></i>
                    </div>
                    <div class="sic-hero-counter-texto">
                        <label>Coincidencia nombre</label>
                        <strong>@ViewBag.TotalCoincidenciaNombre</strong>
                    </div>
                </div>

                <div class="sic-hero-counter sic-counter-foto">
                    <div class="sic-hero-counter-icon">
                        <i class="fa fa-picture-o"></i>
                    </div>
                    <div class="sic-hero-counter-texto">
                        <label>Coincidencia foto</label>
                        <strong>@ViewBag.TotalCoincidenciaFoto</strong>
                    </div>
                </div>

                <div class="sic-hero-counter sic-counter-huella">
                    <div class="sic-hero-counter-icon sic-icono-huella">
                        <svg viewBox="0 0 24 24"
                             aria-hidden="true"
                             focusable="false">

                            <path d="M12 2a8 8 0 0 0-8 8c0 1.46.3 2.7.68 3.82.2.58.83.89 1.41.69.58-.2.89-.83.69-1.41A9.65 9.65 0 0 1 6 10a6 6 0 0 1 12 0c0 3.56-1.05 6.54-2.7 9.22a1 1 0 0 0 1.7 1.06C18.84 17.3 20 13.93 20 10a8 8 0 0 0-8-8Z"></path>

                            <path d="M12 6a4 4 0 0 0-4 4c0 2.92-.69 5.32-1.86 7.48a1 1 0 1 0 1.76.96C9.22 16 10 13.24 10 10a2 2 0 0 1 4 0c0 4.5-1.22 8.15-3.36 11.32a1 1 0 1 0 1.66 1.12C14.66 18.95 16 14.9 16 10a4 4 0 0 0-4-4Z"></path>

                            <path d="M12 9a1 1 0 0 0-1 1c0 3.47-.84 6.28-2.34 8.7a1 1 0 1 0 1.7 1.06C12.06 17.03 13 13.83 13 10a1 1 0 0 0-1-1Z"></path>

                        </svg>
                    </div>

                    <div class="sic-hero-counter-texto">
                        <label>Coincidencia huella</label>
                        <strong>@ViewBag.TotalCoincidenciaHuella</strong>
                    </div>
                </div>

                <div class="sic-hero-counter sic-counter-fotos-municipio">
                    <div class="sic-hero-counter-icon">
                        <i class="fa fa-picture-o"></i>
                    </div>
                    <div class="sic-hero-counter-texto">
                        <label>Fotos en municipio</label>
                        <strong>@totalFotos</strong>
                    </div>
                </div>

                <div class="sic-hero-counter sic-counter-huellas-municipio">
                    <div class="sic-hero-counter-icon">
                        <i class="fa fa-hand-paper-o"></i>
                    </div>
                    <div class="sic-hero-counter-texto">
                        <label>Huellas en municipio</label>
                        <strong>@totalHuellas</strong>
                    </div>
                </div>


            </div>

            <div class="sic-hero-ids-relacionados">
                <span class="sic-hero-ids-label">
                    <i class="fa fa-link"></i>
                    IDs relacionados
                </span>

                <div class="sic-hero-ids-lista">
                    @if (idsRelacionadosHero.Count > 0)
                    {
                        foreach (var idRelacionado in idsRelacionadosHero)
                        {
                            <span class="sic-hero-id">@idRelacionado</span>
                        }
                    }
                    else
                    {
                        <span class="sic-hero-id-vacio">SIN REGISTROS RELACIONADOS</span>
                    }
                </div>
            </div>

        </div>
    </div>

    <div class="sic-section-grid sic-top-grid">

        <!-- =========================================================
         COLUMNA IZQUIERDA
         TABS DE COINCIDENCIAS
         ========================================================= -->
        <div class="sic-card sic-tabs-card">

            <div class="sic-card-body">

                <div class="sic-source-tabs sic-source-tabs-compact">

                    <button type="button" class="sic-source-tab sic-source-tab-compact active @claseCapea" data-tab="tab-capea">

                        <i class="fa fa-search"></i>

                        <span class="sic-tab-compact-name">
                            FEMDLP
                        </span>

                        <span class="sic-tab-compact-count">
                            (@capeas.Count)
                        </span>

                    </button>

                    <button type="button" class="sic-source-tab sic-source-tab-compact @clasePersonaInteres"
                            data-tab="tab-persona-interes">

                        <i class="bi bi-person-bounding-box"></i>

                        <span class="sic-tab-compact-name">Persona Interés</span>

                        <span class="sic-tab-compact-count">
                            (@totalPersonasInteres)
                        </span>

                    </button>

                    <button type="button"
                            class="sic-source-tab sic-source-tab-compact @claseMandamientos"
                            data-tab="tab-mandamientos">

                        <i class="fa fa-gavel"></i>

                        <span class="sic-tab-compact-name">
                            Mandamientos Judiciales
                        </span>

                        <span class="sic-tab-compact-count">
                            (@(mandamientos != null ? mandamientos.Rows.Count : 0))
                        </span>

                    </button>

                    <button type="button"
                            class="sic-source-tab sic-source-tab-compact @claseObjetivos"
                            data-tab="tab-objetivos">

                        <i class="fa fa-crosshairs"></i>

                        <span class="sic-tab-compact-name">
                            Objetivos Prioritarios
                        </span>

                        <span class="sic-tab-compact-count">
                            (@(objetivosPrioritarios != null ? objetivosPrioritarios.Rows.Count : 0))
                        </span>

                    </button>

                    <button type="button"
                            class="sic-source-tab sic-source-tab-compact @claseDetenidos"
                            data-tab="tab-fgea-detenidos">

                        <i class="fa fa-user-secret"></i>

                        <span class="sic-tab-compact-name">
                            Detenidos
                        </span>

                        <span class="sic-tab-compact-count">
                            (@(detenidos != null ? detenidos.Rows.Count : 0))
                        </span>

                    </button>

                    <button type="button"
                            class="sic-source-tab sic-source-tab-compact @claseDetenidosMunicipios"
                            data-tab="tab-detenidos-municipio">

                        <img src="@Url.Content("~/Content/image/SIC/icono_aguascalientes.png")"
                             class="sic-tab-icono-personalizado"
                             alt="" />

                        <span class="sic-tab-compact-name">
                            Detenidos Municipios
                        </span>

                        <span class="sic-tab-compact-count">
                            (@totalDetenidosMunicipios)
                        </span>

                    </button>

                </div>


                <!-- =================================================
                TAB CAPEA
                ================================================= -->
                <div class="sic-source-tab-content active"
                     id="tab-capea">

                    @Html.Partial(
                                       "~/Views/SIC/DetalleDetenidoC5/TabCapeasPartial.cshtml",
                                       capeas
                                   )

                </div>


                <!-- =================================================
                TAB PERSONA DE INTERÉS
                ================================================= -->
                <div class="sic-source-tab-content"
                     id="tab-persona-interes">

                    @Html.Partial(
                                       "~/Views/SIC/DetalleDetenidoC5/TabPersonaInteresPartial.cshtml",
                                       alertasPersonaInteres
                                   )

                </div>


                <!-- =================================================
                TAB MANDAMIENTOS
                ================================================= -->
                <div class="sic-source-tab-content"
                     id="tab-mandamientos">

                    @Html.Partial(
                                       "~/Views/SIC/DetalleDetenidoC5/TabMandamientosPartial.cshtml",
                                       mandamientos
                                   )

                </div>


                <!-- =================================================
                TAB OBJETIVOS PRIORITARIOS
                ================================================= -->
                <div class="sic-source-tab-content"
                     id="tab-objetivos">

                    @Html.Partial(
                                       "~/Views/SIC/DetalleDetenidoC5/TabObjetivosPartial.cshtml",
                                       objetivosPrioritarios
                                   )

                </div>


                <!-- =================================================
                TAB DETENIDOS FGEA
                ================================================= -->
                <div class="sic-source-tab-content"
                     id="tab-fgea-detenidos">

                    @Html.Partial(
                                       "~/Views/SIC/DetalleDetenidoC5/TabDetenidosPartial.cshtml",
                                       detenidos
                                   )

                </div>

                <!-- =================================================
                TAB DETENIDOS Municipio
                ================================================= -->

                <div class="sic-source-tab-content" id="tab-detenidos-municipio">
                    @Html.Partial(
                                  "~/Views/SIC/DetalleDetenidoC5/TabDetenidosMunicipioPartial.cshtml",
                                  detenidosMunicipios
                              )
                </div>

            </div>

        </div>


        <!-- =========================================================
         COLUMNA DERECHA
         INFORMACIÓN DEL DETENIDO EN MUNICIPIO / C5

         AQUÍ NO VA DetenidoObjetivoPartial
         ========================================================= -->
