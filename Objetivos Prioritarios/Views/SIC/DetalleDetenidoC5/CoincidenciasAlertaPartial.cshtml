@model System.Collections.ArrayList

@using System

@if (Model != null && Model.Count > 0)
{
    <div class="sic-coincidencias-alerta">

        @foreach (object elemento in Model)
        {
            object[] datos = elemento as object[];

            if (datos == null || datos.Length < 5)
            {
                continue;
            }

            int estatus = 0;
            int porcentaje = 0;

            int.TryParse(
                Convert.ToString(datos[1]),
                out estatus
            );

            int.TryParse(
                Convert.ToString(datos[2]),
                out porcentaje
            );

            string nombreTipo =
                Convert.ToString(datos[4]);

            if (string.IsNullOrWhiteSpace(nombreTipo))
            {
                nombreTipo = "SIN TIPO DE ALERTA";
            }

            string claseEstatus =
                estatus == 2 || estatus == 3
                    ? "sic-coincidencia-confirmada"
                    : estatus == 0
                        ? "sic-coincidencia-descartada"
                        : "sic-coincidencia-pendiente";

            string tipoNormalizado =
                nombreTipo.Trim().ToUpperInvariant();

            <span class="sic-porcentaje-coincidencia @claseEstatus"
                  title="@nombreTipo">

                <strong>@porcentaje%</strong>

                @if (tipoNormalizado.Contains("HUELLA"))
                {
                    <i class="bi bi-fingerprint" style="font-size:20px;"
                       title="Coincidencia por huella"
                       aria-label="Huella"></i>
                }
                else if (tipoNormalizado.Contains("NOMBRE"))
                {
                    <span class="sic-icono-credencial"
                          title="Coincidencia por nombre"
                          aria-label="Nombre">

                        <i class="fa fa-user"></i>

                        <span class="sic-credencial-lineas">
                            <span></span>
                            <span></span>
                        </span>

                    </span>
                }
                else if (tipoNormalizado.Contains("FOTO"))
                {
                    <i class="fa fa-user" style="font-size:20px;"
                       title="Coincidencia por fotografía"
                       aria-label="Fotografía"></i>
                }
                else
                {
                    <i class="fa fa-exclamation-circle"
                       title="@nombreTipo"></i>
                }

            </span>
        }

    </div>
}