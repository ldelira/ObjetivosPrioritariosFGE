@model System.Collections.Generic.List<Objetivos_Prioritarios.Models.tb_FOTO_C5>

@using System

@{
    var fotosC5 = Model ?? new System.Collections.Generic.List<Objetivos_Prioritarios.Models.tb_FOTO_C5>();
}

<div class="sic-media-box sic-gallery-box">

    <div class="sic-gallery-header">
        <div>
            <strong>Galería de fotos en Municipio</strong>
            <span>@fotosC5.Count foto(s) registrada(s)</span>
        </div>
    </div>

    @if (fotosC5.Count > 0)
    {
        <div class="sic-gallery-grid">

            @for (int i = 0; i < fotosC5.Count; i++)
            {
                var foto = fotosC5[i];

                <div class="sic-gallery-item sic-gallery-item-expandible"
                     data-galeria="fotosMunicipio"
                     role="button"
                     tabindex="0"
                     title="Presione para ampliar"
                     onclick="abrirFotosMunicipio(@i);"
                     onkeydown="if(event.key === 'Enter' || event.key === ' '){ event.preventDefault(); abrirFotosMunicipio(@i); }">

                    <div class="sic-gallery-image-wrap">

                        <img class="sic-gallery-foto"
                             src="@Url.Action("FotoGaleriaC5", "SIC", new { idFoto = foto.IDFOTO })"
                             alt="@ViewBag.Texto(foto.TIPO)"
                             onerror="mostrarErrorFotoGaleria(this);" />

                        <div class="sic-gallery-image-error">
                            <i class="fa fa-picture-o"></i>
                        </div>

                    </div>

                    @{
                        string tipoFoto = ViewBag.Texto(foto.TIPO);

                        if (tipoFoto.StartsWith("FOTO:", StringComparison.OrdinalIgnoreCase))
                        {
                            tipoFoto = tipoFoto.Substring(5).Trim();
                        }
                    }

                    <div class="sic-gallery-caption">
                        <span>@tipoFoto</span>
                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="sic-empty-source">
            <i class="fa fa-picture-o"></i>
            <strong>Galería de fotos en Municipio</strong>
            <span>Sin fotos registradas por el momento.</span>
        </div>
    }

</div>

<div id="sicVisorFotosMunicipio"
     class="sic-galeria-visor"
     aria-hidden="true"
     onclick="cerrarGaleriaSicAlFondo(event, 'sicVisorFotosMunicipio');">

    <div class="sic-galeria-visor-contenido"
         onclick="event.stopPropagation();">

        <button type="button"
                class="sic-galeria-cerrar"
                onclick="cerrarGaleriaSic('sicVisorFotosMunicipio');"
                title="Cerrar visor"
                aria-label="Cerrar visor">
            <i class="fa fa-times"></i>
        </button>

        <div class="sic-galeria-header">
            <div>
                <i class="fa fa-picture-o"></i>
                <span data-sic-galeria-titulo>Galería de fotos en Municipio</span>
            </div>
            <span data-sic-galeria-contador>1 / 1</span>
        </div>

        <div class="sic-galeria-imagen-area">
            <button type="button"
                    class="sic-galeria-navegacion sic-galeria-anterior"
                    data-sic-galeria-anterior
                    onclick="navegarGaleriaSic('sicVisorFotosMunicipio', -1);"
                    title="Anterior">
                <i class="fa fa-chevron-left"></i>
            </button>

            <img data-sic-galeria-imagen
                 src=""
                 alt="Imagen ampliada" />

            <div class="sic-galeria-error"
                 data-sic-galeria-error>
                <i class="fa fa-picture-o"></i>
                <span>No se pudo cargar la fotografía</span>
            </div>

            <button type="button"
                    class="sic-galeria-navegacion sic-galeria-siguiente"
                    data-sic-galeria-siguiente
                    onclick="navegarGaleriaSic('sicVisorFotosMunicipio', 1);"
                    title="Siguiente">
                <i class="fa fa-chevron-right"></i>
            </button>
        </div>

        <div class="sic-galeria-descripcion"
             data-sic-galeria-descripcion></div>

        <div class="sic-galeria-ayuda">
            <i class="fa fa-keyboard-o"></i>
            Use las flechas del teclado para cambiar de fotografía
        </div>
    </div>
</div>

<script>
    function abrirFotosMunicipio(indice) {
        abrirGaleriaSic(
            'fotosMunicipio',
            'sicVisorFotosMunicipio',
            indice,
            'Galería de fotos en Municipio'
        );
    }
</script>
