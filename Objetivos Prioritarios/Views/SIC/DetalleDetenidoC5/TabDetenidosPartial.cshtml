@model System.Data.DataTable

@using System
@using System.Collections.Generic

@{
    var detenidos =
        Model ?? new System.Data.DataTable();

    int idDetenidoC5 =
        ViewBag.IdDetenidoC5 == null
            ? 0
            : Convert.ToInt32(ViewBag.IdDetenidoC5);
    string rutaCss = Server.MapPath("~/Content/SIC/busqueda-coincidencias.css");
    long versionCss = System.IO.File.GetLastWriteTimeUtc(rutaCss).Ticks;
}

<link href="@Url.Content("~/Content/SIC/busqueda-coincidencias.css")?v=@versionCss"
      rel="stylesheet"
      type="text/css" />



@if (detenidos.Rows.Count > 0)
{
    <!-- ============================================================
         CARRUSEL GENERAL DE DETENIDOS FGEA
         IMPORTANTE:
         Este DIV contiene todos los slides y la navegación.
         ============================================================ -->
    <div class="sic-rel-carousel sic-detenidos-carousel">


        <!-- ========================================================
             CONTENEDOR DE SLIDES
             ======================================================== -->
        <div class="sic-detenidos-slides">

            @for (int i = 0; i < detenidos.Rows.Count; i++)
            {
                System.Data.DataRow row =
                    detenidos.Rows[i];

                /* ==================================================
    IDS NOM_PERSO DE LA PERSONA CONSOLIDADA
    ================================================== */

                var idsOrigenDetenidoCoincidencias =
                    new List<int>();

                if (
                    row.Table.Columns.Contains("IdsNomPerso") &&
                    row["IdsNomPerso"] != DBNull.Value
                )
                {
                    string idsTexto =
                        Convert.ToString(
                            row["IdsNomPerso"]
                        );

                    if (!string.IsNullOrWhiteSpace(idsTexto))
                    {
                        string[] partes =
                            idsTexto.Split(
                                new[] { ',' },
                                StringSplitOptions.RemoveEmptyEntries
                            );

                        foreach (string parte in partes)
                        {
                            int idConvertido = 0;

                            if (
                                int.TryParse(
                                    parte.Trim(),
                                    out idConvertido
                                ) &&
                                idConvertido > 0 &&
                                !idsOrigenDetenidoCoincidencias.Contains(
                                    idConvertido
                                )
                            )
                            {
                                idsOrigenDetenidoCoincidencias.Add(
                                    idConvertido
                                );
                            }
                        }
                    }
                }


                /* ==================================================
                   CLAVE_PERSO DE LA PERSONA CONSOLIDADA
                   ================================================== */

                int clavePersoDetenido = 0;

                if (
                    row.Table.Columns.Contains("CLAVE_PERSO") &&
                    row["CLAVE_PERSO"] != DBNull.Value
                )
                {
                    int.TryParse(
                        Convert.ToString(
                            row["CLAVE_PERSO"]
                        ),
                        out clavePersoDetenido
                    );
                }


                /* ==================================================
                   TODAS LAS COINCIDENCIAS DEL DETENIDO

                   Tipo 1 = Nom_perso.id
                   Tipo 2 = CLAVE_PERSO
                   Tipo 3 = CLAVE_PERSO
                   ================================================== */

                System.Collections.ArrayList coincidenciasAlertaDetenido =
                    new System.Collections.ArrayList();

                var obtenerCoincidenciasAlertaDetenido =
                    ViewBag.ObtenerCoincidenciasAlertaDetenido
                    as Func<int[], int, System.Collections.ArrayList>;

                if (obtenerCoincidenciasAlertaDetenido != null)
                {
                    coincidenciasAlertaDetenido =
                        obtenerCoincidenciasAlertaDetenido(
                            idsOrigenDetenidoCoincidencias.ToArray(),
                            clavePersoDetenido
                        );
                }

                if (coincidenciasAlertaDetenido == null)
                {
                    coincidenciasAlertaDetenido =
                        new System.Collections.ArrayList();
                }


                /* ==================================================
    COINCIDENCIAS POR NOMBRE / NOM_PERSO
    ================================================== */

                var coincidenciasNombrePorId =
                    new Dictionary<int, object[]>();

                foreach (
                    int idNombre
                    in idsOrigenDetenidoCoincidencias
                )
                {
                    System.Collections.ArrayList coincidenciaIndividual =
                        ViewBag.ObtenerCoincidenciasAlerta(
                            new int[] { idNombre },
                            new int[] { 6 }
                        ) as System.Collections.ArrayList;

                    if (
                        coincidenciaIndividual == null ||
                        coincidenciaIndividual.Count == 0
                    )
                    {
                        continue;
                    }

                    object[] datosCoincidenciaNombre = null;

                    foreach (object elementoCoincidencia in coincidenciaIndividual)
                    {
                        object[] datosCoincidencia =
                            elementoCoincidencia as object[];

                        if (
                            datosCoincidencia == null ||
                            datosCoincidencia.Length < 5
                        )
                        {
                            continue;
                        }

                        int idTipoAlerta = 0;

                        int.TryParse(
                            Convert.ToString(
                                datosCoincidencia[3]
                            ),
                            out idTipoAlerta
                        );

                        if (idTipoAlerta == 1)
                        {
                            datosCoincidenciaNombre =
                                datosCoincidencia;

                            break;
                        }
                    }

                    if (datosCoincidenciaNombre != null)
                    {
                        coincidenciasNombrePorId[idNombre] =
                            datosCoincidenciaNombre;
                    }
                }

                /* ==================================================
    IDENTIFICADOR QUE SE ENVIARÁ AL CONFIRMAR

    Tipo 1 = Nom_perso.id
    Tipo 2 = CLAVE_PERSO
    Tipo 3 = CLAVE_PERSO
    ================================================== */

                int idTipoAlertaAccionDetenido = 0;

                if (row.Table.Columns.Contains("IdTipoAlerta") &&
                    row["IdTipoAlerta"] != DBNull.Value)
                {
                    int.TryParse(
                        Convert.ToString(row["IdTipoAlerta"]),
                        out idTipoAlertaAccionDetenido
                    );
                }

                int idOrigenAccionDetenido = 0;

                if ((idTipoAlertaAccionDetenido == 2 ||
                     idTipoAlertaAccionDetenido == 3) &&
                    clavePersoDetenido > 0)
                {
                    /*
                     * Foto / Huella:
                     * mandamos CLAVE_PERSO.
                     */
                    idOrigenAccionDetenido =
                        clavePersoDetenido;
                }
                else if (idTipoAlertaAccionDetenido == 1 &&
                         idsOrigenDetenidoCoincidencias.Count > 0)
                {
                    /*
                     * Nombre:
                     * mandamos cualquier Nom_perso.id de esta persona.
                     *
                     * El servicio obtiene después la CLAVE_PERSO
                     * y todos los demás Nom_perso.id.
                     */
                    idOrigenAccionDetenido =
                        idsOrigenDetenidoCoincidencias[0];
                }
                else if (idsOrigenDetenidoCoincidencias.Count > 0)
                {
                    /*
                     * Respaldo:
                     * si no se pudo determinar el tipo,
                     * usamos Nom_perso.id.
                     */
                    idOrigenAccionDetenido =
                        idsOrigenDetenidoCoincidencias[0];

                    idTipoAlertaAccionDetenido = 1;
                }
                else if (clavePersoDetenido > 0)
                {
                    /*
                     * Último respaldo:
                     * si solamente tenemos CLAVE_PERSO,
                     * la mandamos como Tipo 2.
                     */
                    idOrigenAccionDetenido =
                        clavePersoDetenido;

                    idTipoAlertaAccionDetenido = 2;
                }

                <!-- =================================================
                     SLIDE INDIVIDUAL DEL DETENIDO

                     AQUÍ VA LA FICHA FGEA.
                     Debe permanecer DENTRO del tab Detenidos.
                     ================================================= -->
                <div class="sic-rel-slide sic-detenido-slide @(i == 0 ? "active" : "")"
                     data-index="@i"
                     data-id-origen-accion="@idOrigenAccionDetenido"
                     data-id-tipo-alerta-accion="@idTipoAlertaAccionDetenido">

                    @{
                        var viewDataDetenido =
                            new System.Web.Mvc.ViewDataDictionary(
                                ViewData
                            );

                        viewDataDetenido["EsModal"] =
                            false;

                        viewDataDetenido["MostrarAcciones"] =
                            true;

                        viewDataDetenido["IdDetenidoC5"] =
                            idDetenidoC5;

                        viewDataDetenido["CoincidenciasAlerta"] =
                            coincidenciasAlertaDetenido;

                        viewDataDetenido["CoincidenciasNombrePorId"] =
                            coincidenciasNombrePorId;
                    }


                    <!-- =============================================
                    FICHA REUTILIZABLE DEL DETENIDO
                    ============================================= -->
                    @Html.Partial(
                                            "~/Views/SIC/DetalleDetenidoC5/DetenidoObjetivoPartial.cshtml",
                                            row,
                                            viewDataDetenido
                                        )

                </div>
            }

        </div>


        @if (detenidos.Rows.Count > 1)
        {
            <!-- =====================================================
                 NAVEGACIÓN FLOTANTE DEL CARRUSEL
                 ===================================================== -->
            <button type="button"
                    class="sic-detenidos-nav-flotante sic-detenidos-prev"
                    title="Detenido anterior"
                    aria-label="Detenido anterior">
                <i class="fa fa-chevron-left"></i>
            </button>

            <button type="button"
                    class="sic-detenidos-nav-flotante sic-detenidos-next"
                    title="Siguiente detenido"
                    aria-label="Siguiente detenido">
                <i class="fa fa-chevron-right"></i>
            </button>

            <!-- CONTADOR FLOTANTE SUPERIOR -->
            <div class="sic-detenidos-counter-superior" aria-live="polite">
                <span class="sic-detenidos-current">1</span>
                <span class="sic-detenidos-counter-separator">/</span>
                <span>@detenidos.Rows.Count</span>
            </div>
        }


    </div>
    <!-- FIN .sic-rel-carousel.sic-detenidos-carousel -->
}
else
{
    <!-- ============================================================
         SIN DETENIDOS FGEA
         ============================================================ -->
    <div class="sic-empty-source">

        <i class="fa fa-id-badge"></i>

        <strong>
            FGEA - Detenidos
        </strong>

        <span>
            Sin información cargada por el momento.
        </span>

    </div>
}


<!-- ================================================================
     JAVASCRIPT EXCLUSIVO DEL TAB DETENIDOS
     ================================================================ -->
<script>

    $(document)
        .off(
            'click.tabDetenidos',
            '#tab-fgea-detenidos .sic-detenidos-prev, #tab-fgea-detenidos .sic-detenidos-next'
        )
        .on(
            'click.tabDetenidos',
            '#tab-fgea-detenidos .sic-detenidos-prev, #tab-fgea-detenidos .sic-detenidos-next',
            function (e) {

                e.preventDefault();

                var boton =
                    $(this);

                var direccion =
                    boton.hasClass('sic-detenidos-next')
                        ? 1
                        : -1;

                moverCarruselSic(
                    boton,
                    '.sic-detenido-slide',
                    '.sic-detenidos-current',
                    direccion
                );
            }
        );

</script>