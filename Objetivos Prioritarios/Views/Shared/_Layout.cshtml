        }

        .op-busqueda-page.toggle-sidebar .op-module-toggle .op-module-chevron {
            display: inline-flex !important;
        }

        .op-busqueda-page.toggle-sidebar .op-sidebar-nav-modern .nav-content.show {
            display: block !important;
        }
        /* El contenido NO salta cuando se expande el menú. */
        .op-busqueda-page.toggle-sidebar #main.main,
        .op-busqueda-page.toggle-sidebar #footer.footer {
            margin-left: var(--op-busqueda-sidebar-compact) !important;
        }

        .op-busqueda-page .pagetitle {
            margin-bottom: 10px !important;
        }

            .op-busqueda-page .pagetitle h1 {
                font-size: 22px !important;
            }
    }

    /* --------------------------------------------------------------------------
       TABLET VERTICAL / MÓVIL
       Conservamos el off-canvas de la plantilla.
       -------------------------------------------------------------------------- */
    @@media (max-width: 768px) {
        .op-busqueda-page .header {
            height: 54px !important;
            min-height: 54px !important;
            padding: 0 8px !important;
        }

        .op-busqueda-page .sidebar {
            top: 54px !important;
        }

        .op-busqueda-page #main.main {
            margin-top: 54px !important;
            margin-left: 0 !important;
            padding: 12px 10px !important;
        }

        .op-busqueda-page .toggle-sidebar-btn {
            width: 36px !important;
            height: 36px !important;
            min-width: 36px !important;
        }

        .op-busqueda-page .op-brand-modern {
            padding: 3px 7px 3px 4px !important;
        }

        .op-busqueda-page .op-brand-logo-wrap {
            width: 34px !important;
            height: 34px !important;
            min-width: 34px !important;
        }

            .op-busqueda-page .op-brand-logo-wrap img {
                width: 28px !important;
                height: 28px !important;
            }

        .op-busqueda-page .op-brand-title strong {
            font-size: 13px !important;
        }
    }

    /* --------------------------------------------------------------------------
       ESCRITORIO GRANDE
       Mantiene el diseño original completo.
       -------------------------------------------------------------------------- */
    @@media (min-width: 1400px) {
        /* =========================================================
       SIDEBAR ABIERTO
       ========================================================= */

        .op-busqueda-page:not(.toggle-sidebar) .sidebar {
            width: var(--op-sidebar-width) !important;
            left: 0 !important;
        }

        .op-busqueda-page:not(.toggle-sidebar) #main.main,
        .op-busqueda-page:not(.toggle-sidebar) #footer.footer {
            margin-left: var(--op-sidebar-width) !important;
        }
        /* =========================================================
       SIDEBAR CERRADO
       ========================================================= */

        .op-busqueda-page.toggle-sidebar .sidebar {
            left: calc(var(--op-sidebar-width) * -1) !important;
        }

        .op-busqueda-page.toggle-sidebar #main.main,
        .op-busqueda-page.toggle-sidebar #footer.footer {
            margin-left: 0 !important;
        }
    }
</style>

