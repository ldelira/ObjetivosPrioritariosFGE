@using Objetivos_Prioritarios.Models.Extends
@using Objetivos_Prioritarios.Models
@using System
@using System.Collections.Generic
@using System.Linq

@{
    var controllerName =
        (ViewContext.RouteData.Values["controller"] ?? "")
            .ToString();

    var actionName =
        (ViewContext.RouteData.Values["action"] ?? "")
            .ToString();

    tb_Usuarios usuarioSesion = Session["User"] as tb_Usuarios;

    var nombreUsuario =
        usuarioSesion != null &&
        !string.IsNullOrWhiteSpace(usuarioSesion.nvarchar_nombre_usuario)
            ? usuarioSesion.nvarchar_nombre_usuario.Trim()
            : "FGEA";

    var pageTitle =
((ViewBag.Title ?? ViewBag.title) ?? "")
    .ToString();


    /* =========================================================
       PERMISOS DEL USUARIO
       ========================================================= */

    PermisosUsuarioDto permisosUsuario =
        Session["PermisosUsuario"] as PermisosUsuarioDto;

    bool esAdministrador =
        permisosUsuario != null &&
        permisosUsuario.EsAdministrador;

    List<string> modulosPermitidos =
        permisosUsuario != null &&
        permisosUsuario.Modulos != null
            ? permisosUsuario.Modulos
            : new List<string>();

    bool puedeObjetivos =
        esAdministrador ||
        modulosPermitidos.Any(x =>
            string.Equals(
                x,
                "OBJETIVOS",
                StringComparison.OrdinalIgnoreCase
            )
        );

    bool puedeSIC =
        esAdministrador ||
        modulosPermitidos.Any(x =>
            string.Equals(
                x,
                "SIC",
                StringComparison.OrdinalIgnoreCase
            )
        );

    bool puedeBusquedaIntencionada =
        esAdministrador ||
        modulosPermitidos.Any(x =>
            string.Equals(
                x,
                "BUSQUEDA_INTENCIONADA",
                StringComparison.OrdinalIgnoreCase
            )
        );

    bool puedePersonasInteres =
        esAdministrador ||
        modulosPermitidos.Any(x =>
            string.Equals(
                x,
                "PERSONAS_INTERES",
                StringComparison.OrdinalIgnoreCase
            )
        );

    bool puedeAdministrarAccesos =
        esAdministrador ||
        modulosPermitidos.Any(x =>
            string.Equals(
                x,
                "ADMIN_ACCESOS",
                StringComparison.OrdinalIgnoreCase
            )
        );


    /* =========================================================
       IDENTIFICACIÓN DE PANTALLAS
       ========================================================= */

    var isMapa =
        controllerName.Equals(
            "MapaRelaciones",
            StringComparison.OrdinalIgnoreCase
        );

    var isAsuntos =
        controllerName.Equals(
            "Asuntos",
            StringComparison.OrdinalIgnoreCase
        );


    /*
     * La búsqueda utiliza el controlador SIC,
     * pero será una opción principal independiente.
     */
    var isBusquedaCoincidencias =
        controllerName.Equals(
            "SIC",
            StringComparison.OrdinalIgnoreCase
        )
        &&
        actionName.Equals(
            "BusquedaCoincidencias",
            StringComparison.OrdinalIgnoreCase
        );


    /*
     * Pantalla principal de consulta SIC.
     */
    var isConsultaSic =
        controllerName.Equals(
            "SIC",
            StringComparison.OrdinalIgnoreCase
        )
        &&
        actionName.Equals(
            "Index",
            StringComparison.OrdinalIgnoreCase
        );


    /*
     * Acciones pertenecientes al módulo SIC.
     * Se excluye la búsqueda de coincidencias porque
     * aparecerá como una opción independiente.
     */
    var isSic =
        (
            controllerName.Equals(
                "SIC",
                StringComparison.OrdinalIgnoreCase
            )
            ||
            controllerName.Equals(
                "SicNotificador",
                StringComparison.OrdinalIgnoreCase
            )
        )
        &&
        !isBusquedaCoincidencias;


    var isPersonasInteres =
        controllerName.Equals(
            "PersonasInteres",
            StringComparison.OrdinalIgnoreCase
        );


    var isAlbum =
        controllerName.Equals(
            "FichaObjetivo",
            StringComparison.OrdinalIgnoreCase
        )
        &&
        actionName.Equals(
            "IndexAlbum",
            StringComparison.OrdinalIgnoreCase
        );


    var isObjetivos =
        controllerName.Equals(
            "Objetivo",
            StringComparison.OrdinalIgnoreCase
        )
        ||
        (
            controllerName.Equals(
                "FichaObjetivo",
                StringComparison.OrdinalIgnoreCase
            )
            &&
            !isAlbum
        );


    /* =========================================================
       MÓDULOS ACTIVOS
       ========================================================= */

    var isModuloObjetivos =
        isMapa ||
        isObjetivos ||
        isAsuntos ||
        isAlbum;

    var isModuloSic =
        isSic;

    var isModuloPersonasInteres =
        isPersonasInteres;


    /* =========================================================
       TEXTO DEL MÓDULO ACTIVO
       ========================================================= */

    var moduloActivo =
        "Objetivos Prioritarios";

    var moduloActivoSubtitulo =
        "Gestión de inteligencia";


    if (isModuloSic)
    {
        moduloActivo =
            "Sistema de Identificación Criminal";

        moduloActivoSubtitulo =
            "Consulta y filiación";
    }


    if (isBusquedaCoincidencias)
    {
        moduloActivo =
            "Búsqueda de coincidencias";

        moduloActivoSubtitulo =
            "Consulta biométrica por fotografía y huella";
    }


    if (isModuloPersonasInteres)
    {
        moduloActivo =
            "Personas de Interés";

        moduloActivoSubtitulo =
            "Registros parciales, fotos y huellas";
    }


    /* =========================================================
       RUTA DE INICIO SEGÚN PERMISOS
       ========================================================= */

    string urlInicio =
        Url.Action(
            "Index",
            "Login"
        );

    if (puedeObjetivos)
    {
        urlInicio =
            Url.Action(
                "Index",
                "Objetivo"
            );
    }
    else if (puedeSIC)
    {
        urlInicio =
            Url.Action(
                "Index",
                "SIC"
            );
    }
    else if (puedeBusquedaIntencionada)
    {
        urlInicio =
            Url.Action(
                "BusquedaCoincidencias",
                "SIC"
            );
    }
    else if (puedePersonasInteres)
    {
        urlInicio =
            Url.Action(
                "Index",
                "PersonasInteres"
            );
    }
}

<!DOCTYPE html>
<html lang="es-mx">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? "Objetivos Prioritarios" : pageTitle + " | Objetivos Prioritarios")</title>

    <meta content="" name="description">
    <meta content="" name="keywords">

    <link href="@Url.Content("~/assets/images/logoIcono.png")" rel="icon">
    <link href="@Url.Content("~/assets/images/logoIcono.png")" rel="apple-touch-icon">

    <!-- Google Fonts -->
