<style>
    /* ==========================================================================
       BÚSQUEDA INTENCIONADA - MODO TABLET / ESPACIO COMPACTO
       --------------------------------------------------------------------------
       Estos estilos SOLO afectan la pantalla SIC/BusquedaCoincidencias.
       Escritorio grande conserva el menú completo.
       Tablet horizontal utiliza una barra lateral compacta de iconos.
       Tablet vertical / móvil conserva el comportamiento off-canvas original.
       ========================================================================== */

    .op-busqueda-page {
        --op-busqueda-sidebar-compact: 72px;
        --op-busqueda-header-tablet: 54px;
    }

        /* Mejor transición al abrir/cerrar el menú en la búsqueda. */
        .op-busqueda-page .sidebar,
