    <script>
        (function () {
            function esPaginaBusqueda() {
                return document.body && document.body.classList.contains('op-busqueda-page');
            }

            function estaEnModoTablet() {
                var ancho = window.innerWidth || document.documentElement.clientWidth;
                return ancho >= 769 && ancho <= 1399;
            }

            function normalizarSidebarBusqueda() {
                if (!esPaginaBusqueda()) {
                    return;
                }

                var ancho = window.innerWidth || document.documentElement.clientWidth;

                /*
                 * Al entrar a escritorio grande, quitamos el estado especial
                 * que pudo haberse usado para expandir el menú en tablet.
                 */
                if (ancho >= 1400) {
                    document.body.classList.remove('toggle-sidebar');
                }

                /*
                 * En móvil queremos iniciar con el off-canvas cerrado.
                 * No se toca mientras el usuario lo abre mediante hamburguesa.
                 */
            }

            document.addEventListener('DOMContentLoaded', function () {
                if (!esPaginaBusqueda()) {
                    return;
                }

                normalizarSidebarBusqueda();

                /*
                 * Si el lateral está compacto y se pulsa un módulo con submenú,
                 * primero expandimos el lateral para que el usuario vea las opciones.
                 */
                document.querySelectorAll('.op-module-toggle[data-bs-toggle="collapse"]').forEach(function (elemento) {
                    elemento.addEventListener('click', function () {
                        if (estaEnModoTablet() && !document.body.classList.contains('toggle-sidebar')) {
                            document.body.classList.add('toggle-sidebar');
                        }
                    });
                });
            });

            window.addEventListener('resize', function () {
                normalizarSidebarBusqueda();
            });
        })();

        $(document).ajaxError(function (event, xhr) {

        if (xhr.status === 440) {

            window.location.href =
                '@Url.Action("Index", "Login")';

        }

    });

    </script>

