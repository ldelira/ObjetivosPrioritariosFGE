    <!-- Plugins CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/1.6.4/css/buttons.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/v/dt/dt-1.10.22/datatables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.22/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/fixedheader/3.1.7/css/fixedHeader.dataTables.min.css" />
    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">

    <link rel="stylesheet" href="@Url.Content("~/Content/Selectize/css/selectize.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/Selectize/css/selectize.bootstrap3.css")">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-colorpicker/2.5.3/css/bootstrap-colorpicker.css" rel="stylesheet">
    <link href="@Url.Content("~/assets/plugins/sweetalert/css/sweetalert.min.css")" rel="stylesheet" />

    @Styles.Render("~/bundles/css2")
    @RenderSection("styles", required: false)

    <style>
        :root {
            --op-header-height: 64px;
            --op-sidebar-width: 272px;
            --op-bg: #f4f7fb;
            --op-card: #ffffff;
            --op-primary: #2f5bff;
            --op-primary-dark: #0b2364;
            --op-primary-soft: #eef4ff;
            --op-border: #dfe7f2;
            --op-text: #071b3a;
            --op-muted: #6f7d93;
            --op-shadow: 0 10px 28px rgba(15, 35, 75, .08);
        }

        html,
        body {
            min-height: 100%;
            font-family: Arial, Helvetica, sans-serif !important;
            background: var(--op-bg);
            color: var(--op-text);
        }

        label, input, select, textarea, button,
        p, span, div, table, th, td,
        h1, h2, h3, h4, h5, h6,
        a {
            font-family: Arial, Helvetica, sans-serif !important;
        }

        body {
            overflow-x: hidden;
        }

        /* ================================
           HEADER
        ================================ */

        .header {
            height: var(--op-header-height);
            background: linear-gradient(90deg, #bfeaf6 0%, #d7f3fb 100%);
            border-bottom: 1px solid rgba(11, 35, 100, .08);
            box-shadow: 0 4px 14px rgba(15, 35, 75, .05);
            padding: 0 18px;
            z-index: 997;
        }

        .op-header-left {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .toggle-sidebar-btn {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--op-primary-dark);
            background: rgba(255, 255, 255, .45);
            border: 1px solid rgba(255, 255, 255, .65);
            transition: .15s ease;
            font-size: 22px;
            cursor: pointer;
        }

            .toggle-sidebar-btn:hover {
                background: #fff;
                color: var(--op-primary);
                transform: translateY(-1px);
            }

        .op-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            min-width: 0;
        }

            .op-brand img {
                width: 38px;
                height: 38px;
                object-fit: contain;
                border-radius: 10px;
                background: rgba(255,255,255,.55);
                padding: 3px;
            }

        .op-brand-title {
            display: flex;
            flex-direction: column;
            line-height: 1.1;
        }

            .op-brand-title strong {
                color: var(--op-primary-dark);
                font-size: 16px;
                font-weight: 800;
                letter-spacing: .2px;
                white-space: nowrap;
            }

            .op-brand-title small {
                color: #50617b;
                font-size: 11px;
                margin-top: 3px;
                white-space: nowrap;
            }

        .header-nav .nav-profile img {
            width: 32px;
            height: 32px;
            padding: 2px;
            background: #fff;
            border: 1px solid rgba(11,35,100,.15);
        }

        .header-nav .nav-profile span {
            color: var(--op-primary-dark);
            font-weight: 700;
            font-size: 14px;
        }

        .dropdown-menu.profile {
            border: 1px solid var(--op-border);
            box-shadow: var(--op-shadow);
            border-radius: 14px;
            overflow: hidden;
        }

        /* ================================
           SIDEBAR
        ================================ */

        .sidebar {
            width: var(--op-sidebar-width);
            top: var(--op-header-height);
            background: #fff;
            border-right: 1px solid var(--op-border);
            box-shadow: 5px 0 18px rgba(15, 35, 75, .04);
            padding: 16px 14px;
            z-index: 996;
        }

        .op-sidebar-title {
            margin: 4px 6px 18px;
            padding: 14px;
            border-radius: 16px;
            background: linear-gradient(135deg, var(--op-primary-dark), #264dd9);
            color: #fff;
            box-shadow: 0 12px 26px rgba(47, 91, 255, .22);
        }

            .op-sidebar-title small {
                display: block;
                color: rgba(255,255,255,.78);
                font-size: 11px;
                margin-bottom: 4px;
                text-transform: uppercase;
                letter-spacing: .6px;
            }

            .op-sidebar-title strong {
                display: block;
                font-size: 15px;
                line-height: 1.25;
            }

        .sidebar-nav {
            padding: 0;
        }

            .sidebar-nav .nav-heading {
                color: #8b98ad;
                font-size: 11px;
                margin: 16px 12px 8px;
                text-transform: uppercase;
                letter-spacing: .7px;
                font-weight: 800;
            }

            .sidebar-nav .nav-item {
                margin-bottom: 6px;
            }

            .sidebar-nav .nav-link {
                min-height: 46px;
                padding: 11px 13px;
                border-radius: 13px;
                color: #24364b;
                background: transparent;
                border: 1px solid transparent;
                font-weight: 700;
                font-size: 14px;
                gap: 10px;
                transition: .15s ease;
            }

                .sidebar-nav .nav-link i {
                    width: 24px;
                    height: 24px;
                    min-width: 24px;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: 9px;
                    color: var(--op-primary);
                    background: var(--op-primary-soft);
                    font-size: 14px;
                }

                .sidebar-nav .nav-link:hover {
                    background: #f6f9ff;
                    border-color: #e8eef8;
                    color: var(--op-primary);
                    transform: translateX(2px);
                }

                .sidebar-nav .nav-link.active,
                .sidebar-nav .nav-link:not(.collapsed) {
                    background: var(--op-primary);
                    color: #fff;
                    border-color: var(--op-primary);
                    box-shadow: 0 10px 22px rgba(47, 91, 255, .23);
                }

                    .sidebar-nav .nav-link.active i,
                    .sidebar-nav .nav-link:not(.collapsed) i {
                        background: rgba(255,255,255,.18);
                        color: #fff;
                    }

        /* ================================
           CONTENT
        ================================ */

        #main.main {
            margin-top: var(--op-header-height);
            padding: 24px 28px;
            min-height: calc(100vh - var(--op-header-height));
            background: linear-gradient(180deg, #f6f9ff 0%, #f1f5fb 100%);
        }

        .pagetitle {
            margin-bottom: 14px;
        }

            .pagetitle h1 {
                color: var(--op-primary-dark);
                font-size: 24px;
                font-weight: 800;
                margin: 0;
            }

        .section.dashboard {
            min-height: calc(100vh - 180px);
        }

        .card:not(.op-card-flat),
        .op-card:not(.op-card-flat),
        .op-header-card,
        .op-tabs-wrapper {
            border: 1px solid #e8eef8 !important;
            box-shadow: var(--op-shadow);
        }

        .btn-primary,
        .btn.btn-primary {
            background: var(--op-primary) !important;
            border-color: var(--op-primary) !important;
        }

            .btn-primary:hover,
            .btn.btn-primary:hover {
                background: #2448d8 !important;
                border-color: #2448d8 !important;
            }

        .btn-outline-primary {
            color: var(--op-primary) !important;
            border-color: var(--op-primary) !important;
        }

            .btn-outline-primary:hover {
                color: #fff !important;
                background: var(--op-primary) !important;
            }

        .btn-success {
            background: #198754 !important;
            border-color: #198754 !important;
        }

        .btn-danger {
            background: #dc3545 !important;
            border-color: #dc3545 !important;
        }

        .btn-info {
            background: #0ea5e9 !important;
            border-color: #0ea5e9 !important;
            color: #fff !important;
        }

        .btn-secondary {
            background: #64748b !important;
            border-color: #64748b !important;
            color: #fff !important;
        }

        #footer.footer {
            background: transparent;
            color: var(--op-primary-dark);
            font-size: 12px;
            border-top: 1px solid var(--op-border);
        }

        .back-to-top {
            background: var(--op-primary);
            border-radius: 10px;
        }

        /* ================================
           DATATABLES GLOBAL
        ================================ */

        .table,
        table.dataTable {
            width: 100% !important;
            border-collapse: separate !important;
            border-spacing: 0 !important;
            background: #fff;
            color: #0f172a;
            font-size: 14px;
        }

            table.dataTable thead th,
            .table thead th {
                background: #f8fafc;
                color: #0b2364;
                font-weight: 700;
                font-size: 13px;
                text-transform: none;
                border-bottom: 1px solid #dbe3ef !important;
                padding: 12px 10px !important;
                vertical-align: middle;
                white-space: nowrap;
            }

            table.dataTable tbody td,
            .table tbody td {
                padding: 11px 10px !important;
                vertical-align: middle !important;
                border-bottom: 1px solid #e5eaf1 !important;
                color: #182235;
            }

            table.dataTable tbody tr,
            .table tbody tr {
                transition: background-color .15s ease;
            }

                table.dataTable tbody tr:hover,
                .table tbody tr:hover {
                    background: #f5f8ff !important;
                }

            table.dataTable.stripe tbody tr.odd,
            table.dataTable.display tbody tr.odd,
            .table-striped tbody tr:nth-of-type(odd) {
                background-color: #fbfcff;
            }

            table.dataTable.no-footer {
                border-bottom: 1px solid #dbe3ef !important;
            }

        .dataTables_wrapper {
            width: 100%;
        }

            .dataTables_wrapper .dataTables_length,
            .dataTables_wrapper .dataTables_filter {
                margin-bottom: 14px;
                color: #334155;
                font-size: 13px;
            }

                .dataTables_wrapper .dataTables_length select {
                    border: 1px solid #cbd5e1;
                    border-radius: 8px;
                    padding: 5px 28px 5px 8px;
                    background-color: #fff;
                    height: 34px;
                }

                .dataTables_wrapper .dataTables_filter input {
                    border: 1px solid #cbd5e1;
                    border-radius: 8px;
                    padding: 7px 10px;
                    height: 34px;
                    margin-left: 8px;
                    outline: none;
                    transition: border-color .15s ease, box-shadow .15s ease;
                }

                    .dataTables_wrapper .dataTables_filter input:focus {
                        border-color: #2f5bff;
                        box-shadow: 0 0 0 3px rgba(47, 91, 255, .12);
                    }

            .dataTables_wrapper .dataTables_info {
                color: #64748b;
                font-size: 13px;
                padding-top: 14px;
            }

            .dataTables_wrapper .dataTables_paginate {
                padding-top: 10px;
            }

                .dataTables_wrapper .dataTables_paginate .paginate_button {
                    border: 1px solid #dbe3ef !important;
                    background: #fff !important;
                    color: #0b2364 !important;
                    border-radius: 8px !important;
                    padding: 6px 10px !important;
                    margin-left: 4px !important;
                    font-size: 13px;
                }

                    .dataTables_wrapper .dataTables_paginate .paginate_button.current,
                    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
                        background: #2f5bff !important;
                        color: #fff !important;
                        border-color: #2f5bff !important;
                    }

                    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                        background: #eef4ff !important;
                        color: #2f5bff !important;
                        border-color: #bfd0ff !important;
                    }

                    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
                        color: #94a3b8 !important;
                        background: #f8fafc !important;
                        border-color: #e2e8f0 !important;
                    }

        .dataTables_scrollBody {
            border-bottom: 1px solid #dbe3ef !important;
        }

            .dataTables_scrollBody::-webkit-scrollbar {
                height: 8px;
                width: 8px;
            }

            .dataTables_scrollBody::-webkit-scrollbar-track {
                background: #f1f5f9;
                border-radius: 8px;
            }

            .dataTables_scrollBody::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 8px;
            }

                .dataTables_scrollBody::-webkit-scrollbar-thumb:hover {
                    background: #94a3b8;
                }

            /* Corrige encabezado duplicado cuando DataTables usa scrollX */
            .dataTables_scrollBody thead {
                visibility: collapse !important;
            }

                .dataTables_scrollBody thead tr,
                .dataTables_scrollBody thead th {
                    height: 0 !important;
                    padding-top: 0 !important;
                    padding-bottom: 0 !important;
                    border-top: 0 !important;
                    border-bottom: 0 !important;
                    line-height: 0 !important;
                }

                    .dataTables_scrollBody thead th::before,
                    .dataTables_scrollBody thead th::after {
                        display: none !important;
                    }

                    .dataTables_scrollBody thead th * {
                        display: none !important;
                    }

            .dataTables_scrollBody table.dataTable {
                margin-top: 0 !important;
            }

        /* Quitar bordes/marcos visuales de DataTables */
        .op-card,
        .card,
        .card-body,
        .card-fixed {
            border: none !important;
        }

        .dataTables_wrapper,
        .dataTables_scroll,
        .dataTables_scrollHead,
        .dataTables_scrollBody,
        .dataTables_scrollFoot {
            border: none !important;
            box-shadow: none !important;
        }

        .dataTables_scrollHead {
            border-bottom: none !important;
        }

        .dataTables_scrollBody {
            border-top: none !important;
            border-bottom: none !important;
        }

        table.dataTable,
        table.dataTable.no-footer {
            border: none !important;
        }

            table.dataTable thead th {
                border-top: none !important;
                border-bottom: 1px solid #dbe3ef !important;
            }

            table.dataTable thead tr {
                border: none !important;
            }

        .op-table-container {
            width: 100%;
            border: none !important;
            box-shadow: none !important;
            background: transparent !important;
            overflow: visible;
        }

        .op-card-flat {
            border: none !important;
            box-shadow: none !important;
            background: transparent !important;
            padding: 0 !important;
        }

            .op-card-flat .card,
            .op-card-flat .card-body,
            .op-card-flat .card-fixed {
                border: none !important;
                box-shadow: none !important;
                background: transparent !important;
                padding-left: 0 !important;
                padding-right: 0 !important;
            }

            .op-card-flat .dataTables_wrapper,
            .op-card-flat .dataTables_scroll,
            .op-card-flat .dataTables_scrollHead,
